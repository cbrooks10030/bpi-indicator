# ---- Site ----
# Public base URL of your deployed site (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://your-domain.com
# Invite link to your Discord server (shown around the site).
NEXT_PUBLIC_DISCORD_INVITE=https://discord.gg/your-invite
NEXT_PUBLIC_SUPPORT_EMAIL=support@your-domain.com

# ---- Stripe ----
# Secret key from https://dashboard.stripe.com/apikeys (use a Restricted key).
STRIPE_SECRET_KEY=sk_live_or_test_xxx
# Webhook signing secret from the webhook endpoint you create in Stripe,
# pointing at https://your-domain.com/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Price IDs (create Products/Prices in Stripe, then paste the price_... ids).
STRIPE_PRICE_MONTHLY=price_xxx        # $29 / month recurring
STRIPE_PRICE_ANNUAL=price_xxx         # $199 / year recurring
STRIPE_PRICE_LIFETIME=price_xxx       # $399 one-time

# ---- Discord ----
# From https://discord.com/developers/applications -> your app
DISCORD_CLIENT_ID=xxx
DISCORD_CLIENT_SECRET=xxx
DISCORD_BOT_TOKEN=xxx
# Your server (guild) id and the role granted to members.
DISCORD_GUILD_ID=xxx
DISCORD_MEMBER_ROLE_ID=xxx

# ---- Admin ----
# Any long random string; used to authorize GET /api/admin/members
ADMIN_TOKEN=change-me-to-a-long-random-string
