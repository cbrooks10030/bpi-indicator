// ============================================================================
// Helper Functions
// ============================================================================

LineStyle(string style) =>
    switch style
        'Dashed' => line.style_dashed
        'Dotted' => line.style_dotted
        => line.style_solid

LabelSize(string lbl_size) =>
    switch lbl_size
        'Tiny' => size.tiny
        'Normal' => size.normal
        'Large' => size.large
        'Huge' => size.huge
        => size.small

DayofWeek(int index) =>
    switch
        index == 1 => 'M'
        index == 2 => 'T'
        index == 3 => 'W'
        index == 4 => 'T'
        index == 5 => 'F'
        index == 6 => 'S'
        index == 7 => 'S'
        na(index) => ''

ValidTimeframe(string HTF) =>
    // Session-based modes are always valid
    if str.startswith(HTF, "SESSION_")
        true
    else if timeframe.in_seconds(HTF) >= timeframe.in_seconds('D') and timeframe.in_seconds(HTF) > timeframe.in_seconds()
        true
    else
        n1 = timeframe.in_seconds()
        n2 = timeframe.in_seconds(HTF)
        n1 < n2 and math.round(n2 / n1) == n2 / n1

RemainingTime(string HTF) =>
    // Session-based modes: calculate remaining time based on session duration
    if str.startswith(HTF, "SESSION_") and barstate.isrealtime
        int duration_seconds = getQuarterlyDurationSeconds(HTF)
        // Estimate remaining time: duration minus time since last session change
        int elapsed = (timenow - time) / 1000
        int remaining = math.max(0, duration_seconds - (elapsed % duration_seconds))
        hours = math.floor(remaining / 3600)
        minutes = math.floor((remaining - hours * 3600) / 60)
        seconds = remaining - hours * 3600 - minutes * 60
        str.tostring(hours, '00') + ':' + str.tostring(minutes, '00') + ':' + str.tostring(seconds, '00')
    else if barstate.isrealtime and not str.startswith(HTF, "SESSION_")
        timeRemaining = (time_close(HTF) - timenow) / 1000
        days = math.floor(timeRemaining / 86400)
        hours = math.floor((timeRemaining - days * 86400) / 3600)
        minutes = math.floor((timeRemaining - days * 86400 - hours * 3600) / 60)
        seconds = math.floor(timeRemaining - days * 86400 - hours * 3600 - minutes * 60)
        r = str.tostring(seconds, '00')
        if minutes > 0 or hours > 0 or days > 0
            r := str.tostring(minutes, '00') + ':' + r
        if hours > 0 or days > 0
            r := str.tostring(hours, '00') + ':' + r
        if days > 0
            r := str.tostring(days) + 'D ' + r
        r
    else
        'n/a'

HTFName(string HTF) =>
    // Handle session-based modes with descriptive names
    if HTF == "SESSION_MICRO"
        "Micro Cycle"
    else if HTF == "SESSION_90"
        "Quarterly"
    else if HTF == "SESSION_6H"
        "Sessions"
    else
        formatted = HTF
        seconds = timeframe.in_seconds(HTF)
        if seconds < 60
            formatted := str.tostring(seconds) + 's'
        else if seconds / 60 < 60
            formatted := str.tostring(seconds / 60) + 'm'
        else if seconds / 60 / 60 < 24
            formatted := str.tostring(seconds / 60 / 60) + 'H'
        formatted

// Get current chart timeframe formatted
LTFName() =>
    seconds = timeframe.in_seconds()
    result = timeframe.period
    if seconds < 60
        result := str.tostring(seconds) + 's'
    else if seconds < 3600
        result := str.tostring(seconds / 60) + 'm'
    else if seconds < 86400
        result := str.tostring(seconds / 3600) + 'H'
    result

// Build alert message: "LTF-HTF TICKER: [Potential] Bullish/Bearish <name>"
BuildAlertMessage(string htf, bool is_bullish, bool is_potential, string name) =>
    string ltf = LTFName()
    string htf_name = HTFName(htf)
    string direction = is_bullish ? "Bullish" : "Bearish"
    string potential = is_potential ? "Potential " : ""
    str.format("{0}-{1} {2}: {3}{4} {5}", ltf, htf_name, syminfo.ticker, potential, direction, name)

CandleSetHigh(array<Candle> candles, float h) =>
    float _h = h
    for c in candles
        if c.h > _h
            _h := c.h
    _h

CandleSetLow(array<Candle> candles, float l) =>
    float _l = l
    for c in candles
        if c.l < _l
            _l := c.l
    _l
// CISD body area (bodies only) from CISD start through C2 extreme — returns [body_lo, body_hi, body_mid]
GetCisdBodyRange(int cisd_start_idx, int extreme_bar_idx) =>
    float body_hi = na
    float body_lo = na
    if not na(cisd_start_idx) and not na(extreme_bar_idx)
        int off_a = bar_index - extreme_bar_idx
        int off_b = bar_index - cisd_start_idx
        int lo_off = math.max(0, math.min(off_a, off_b))
        int hi_off = math.min(math.max(off_a, off_b), 500)
        if lo_off <= hi_off
            for i = lo_off to hi_off
                float bt = math.max(open[i], close[i])
                float bb = math.min(open[i], close[i])
                body_hi := na(body_hi) ? bt : math.max(body_hi, bt)
                body_lo := na(body_lo) ? bb : math.min(body_lo, bb)
    float body_mid = not na(body_hi) and not na(body_lo) ? (body_hi + body_lo) / 2.0 : na
    [body_lo, body_hi, body_mid]

// Set C3 entry zone once: if C2 mid inside CISD body → C2 mid↔body mid; else C2 mid↔C3 open
TrySetEntryZoneC3(Setup setup) =>
    if settings.entry_zone_show and not setup.ez_c3_set and not setup.is_invalid and setup.is_post_c2 and setup.cisd_triggered and not na(setup.c2_mid) and not na(setup.c3_open) and not na(setup.cisd_start_idx) and not na(setup.extreme_bar_idx)
        [body_lo, body_hi, body_mid] = GetCisdBodyRange(setup.cisd_start_idx, setup.extreme_bar_idx)
        if not na(body_lo) and not na(body_hi) and not na(body_mid)
            float c2m = setup.c2_mid
            bool inside = c2m >= body_lo and c2m <= body_hi
            float y2 = inside ? body_mid : setup.c3_open
            setup.ez_c3_top := math.max(c2m, y2)
            setup.ez_c3_bot := math.min(c2m, y2)
            setup.ez_c3_set := true
    setup

// At C3 close / C4 open: always store C3 mid + C4 span (for Previous EQ); entry-zone box only if enabled
TrySetEntryZoneC4(Setup setup, float c3_h, float c3_l, float c4_open_price, int left_time, int right_time) =>
    if not setup.is_invalid and not na(c3_h) and not na(c3_l) and not na(c4_open_price)
        float c3m = (c3_h + c3_l) / 2.0
        setup.c3_mid := c3m
        setup.c3_extreme := setup.is_bullish ? c3_l : c3_h
        setup.c4_open := c4_open_price
        setup.ez_c4_left_time := left_time
        setup.ez_c4_right_time := right_time
        if settings.entry_zone_show and not setup.ez_c4_set
            setup.ez_c4_top := math.max(c3m, c4_open_price)
            setup.ez_c4_bot := math.min(c3m, c4_open_price)
            setup.ez_c4_set := true
            setup.ez_c4_invalid := false
    setup

// Right edge for entry zone / EQ: grows with each LTF bar; once period ends, locks at final edge
EntryZoneRight(int locked_right) =>
    int developing = time_close
    na(locked_right) ? developing : (time >= locked_right ? locked_right : math.min(developing, locked_right))

// Chart Previous EQ on for this setup? (On Chart or Both)
ShowChartEQ() =>
    prev_eq_show and (drawings_type == 'On Chart' or drawings_type == 'Both')

// HTF projection Previous EQ on for this setup? (HTF candle or Both)
ShowHtfEQ() =>
    prev_eq_show and (drawings_type == 'HTF candle' or drawings_type == 'Both')

// Find array index of HTF candle by o_idx (-1 if not in projection)
FindCandleIndex(array<Candle> candles, int o_idx) =>
    int found = -1
    if not na(o_idx) and candles.size() > 0
        for i = 0 to candles.size() - 1
            if candles.get(i).o_idx == o_idx
                found := i
                break
    found

// FindCISDLevel traces back from the extreme bar to find consecutive opposing candles
// Returns [cisd_level, cisd_start_idx]
// extreme_bar_idx: the bar index where lowest low (bullish) or highest high (bearish) occurred
// bias: 1 for bullish candles (bearish setup), -1 for bearish candles (bullish setup)
FindCISDLevel(int extreme_bar_idx, int bias) =>
    int offset = bar_index - extreme_bar_idx  // How many bars ago the extreme occurred
    
    float cisd_price = na
    int cisd_idx = na
    bool found_first = false
    
    // Start from the extreme bar itself and trace back
    for i = offset to math.min(offset + 500, bar_index)
        float c_open = open[i]
        float c_close = close[i]
        int candle_attitude = c_close > c_open ? 1 : c_close < c_open ? -1 : 0
        
        if candle_attitude == 0
            continue
        
        if not found_first
            if candle_attitude == bias
                found_first := true
                cisd_price := c_open
                cisd_idx := bar_index - i
        else
            if candle_attitude != bias
                break
            cisd_price := c_open
            cisd_idx := bar_index - i
    
    [cisd_price, cisd_idx]

// ——— IC-CISD (rebuild) ———
// - Level = open of the starting opposite candle; does not move onto later same-side candles
// - Confirm on later body break through that open
// - Mark only if a 3-candle swing exists (middle beyond both neighbors). Start may be that middle; close-through may be the right.
// - Dot = highest swing wick (bear) / lowest swing wick (bull) among those middles
// - Calculate from the bar after main CISD body-break; draw only after sweep-back-in / show
// - After confirm, next opposite candle starts another IC (lower or higher swing does not matter)

ICHardStop(Setup setup) =>
    setup.is_invalid or setup.ez_c4_invalid or (not na(setup.ez_c4_right_time) and time >= setup.ez_c4_right_time)

ClearICPending(Setup setup) =>
    setup.ic_pending := false
    setup.ic_level := na
    setup.ic_start_idx := na
    setup.ic_extreme := na
    setup.ic_extreme_idx := na
    setup.ic_seen_same_side := false
    setup

StopICDetection(Setup setup) =>
    setup.ic_active := false
    ClearICPending(setup)
    setup

ResetICCisd(Setup setup) =>
    StopICDetection(setup)
    setup.ic_last_extreme := na
    if not na(setup.ic_list)
        setup.ic_list.clear()
    else
        setup.ic_list := array.new<ICCisd>()
    setup

// Update running extreme for dot (every candle between start and confirm)
ICTrackExtreme(Setup setup) =>
    if setup.is_bullish
        if na(setup.ic_extreme) or low < setup.ic_extreme
            setup.ic_extreme := low
            setup.ic_extreme_idx := bar_index
    else
        if na(setup.ic_extreme) or high > setup.ic_extreme
            setup.ic_extreme := high
            setup.ic_extreme_idx := bar_index
    setup

// 3-candle swing: middle beyond both neighbors. Start may be middle; end (confirm) may be right.
// Returns [swing price, swing bar] or [na, na]. Bear = highest such high; bull = lowest such low.
ICFindSwing(Setup setup, int end_idx) =>
    float best_px = na
    int best_idx = na
    int start = setup.ic_start_idx
    if not na(start) and not na(end_idx) and end_idx > start
        for m = start to end_idx - 1
            if m < 1
                continue
            int off_m = bar_index - m
            int off_l = bar_index - (m - 1)
            int off_r = bar_index - (m + 1)
            if off_m < 0 or off_l < 0 or off_r < 0
                continue
            if setup.is_bullish
                if low[off_m] < low[off_l] and low[off_m] < low[off_r]
                    if na(best_px) or low[off_m] < best_px
                        best_px := low[off_m]
                        best_idx := m
            else
                if high[off_m] > high[off_l] and high[off_m] > high[off_r]
                    if na(best_px) or high[off_m] > best_px
                        best_px := high[off_m]
                        best_idx := m
    [best_px, best_idx]

// Wick beyond a stored IC swing: bear above the high, bull below the low
ICMarkTaken(Setup setup) =>
    if ICHardStop(setup)
        setup
    else if not na(setup.ic_list) and setup.ic_list.size() > 0
        for i = 0 to setup.ic_list.size() - 1
            ICCisd ic = setup.ic_list.get(i)
            if not ic.taken and not na(ic.extreme_price)
                if setup.is_bullish
                    if low < ic.extreme_price
                        ic.taken := true
                else
                    if high > ic.extreme_price
                        ic.taken := true
    setup

ICUpdate(Setup setup) =>
    ICMarkTaken(setup)
    if not settings.ic_cisd_show
        setup
    else if not barstate.isconfirmed
        // Live bar color can flip; never arm or move the level until the candle is closed
        setup
    else if ICHardStop(setup)
        StopICDetection(setup)
        setup
    else if na(setup.cisd_end_idx)
        // Calculate from CISD body-break, even before sweep-back-in / show
        if not setup.is_invalid and (setup.ic_active or setup.ic_pending)
            ResetICCisd(setup)
        else
            StopICDetection(setup)
        setup
    else if bar_index <= setup.cisd_end_idx
        if setup.ic_active or setup.ic_pending
            ClearICPending(setup)
            setup.ic_active := false
        setup
    else
        if not setup.ic_active
            setup.ic_active := true
            if na(setup.ic_list)
                setup.ic_list := array.new<ICCisd>()
            ClearICPending(setup)

        // Strict color: doji is neither opposite nor same-side
        bool opp_bar = setup.is_bullish ? (close < open) : (close > open)

        if setup.ic_pending
            // Body break (start may be swing middle; right candle confirms next bar+)
            if bar_index > setup.ic_start_idx
                bool broke = setup.is_bullish ? (close > setup.ic_level) : (close < setup.ic_level)
                [sw_px, sw_idx] = ICFindSwing(setup, bar_index)
                if broke
                    if not na(sw_px) and not na(sw_idx)
                        ICCisd ic = ICCisd.new()
                        ic.level := setup.ic_level
                        ic.start_idx := setup.ic_start_idx
                        ic.end_idx := bar_index
                        ic.extreme_price := sw_px
                        ic.extreme_idx := sw_idx
                        if na(setup.ic_list)
                            setup.ic_list := array.new<ICCisd>()
                        array.push(setup.ic_list, ic)
                        setup.ic_last_extreme := sw_px
                        ClearICPending(setup)
                        if settings.alerts_enabled and settings.ic_cisd_show and (settings.bias == "Neutral" or (setup.is_bullish and settings.bias == "Bullish") or (not setup.is_bullish and settings.bias == "Bearish"))
                            alert(BuildAlertMessage(htf.settings.htf, setup.is_bullish, false, "IC-CISD"), alert.freq_once_per_bar)
                    else
                        // No swing yet. Keep only if this close-through made a new extreme (it may be the swing; next bar is the right).
                        bool new_ext = setup.is_bullish ? (low < setup.ic_extreme) : (high > setup.ic_extreme)
                        if new_ext
                            ICTrackExtreme(setup)
                        else
                            ClearICPending(setup)
                else
                    ICTrackExtreme(setup)
            else
                ICTrackExtreme(setup)
        else
            // Free: next opposite candle starts a new IC (HH/LH or LL/HL does not matter)
            if opp_bar
                setup.ic_pending := true
                setup.ic_level := open
                setup.ic_start_idx := bar_index
                setup.ic_extreme := setup.is_bullish ? low : high
                setup.ic_extreme_idx := bar_index
                setup.ic_seen_same_side := false
        setup

// ============================================================================
// SMT Detection Helper
// ============================================================================
// Checks if comparison symbols show SMT divergence:
// - Bearish: Current makes HH, but comparison makes LH (fails to make new high)
// - Bullish: Current makes LL, but comparison makes HL (fails to make new low)
// For inverse correlations, the logic is flipped appropriately.
// IMPORTANT: Lines are drawn at CURRENT symbol's price levels, not comparison's!
// Returns [has_smt, smt_x1, smt_x2, smt_y1, smt_y2, smt_symbol]

CheckSMTDivergence(bool is_bearish, SMT_Tracker tracker_curr,
                   SMT_Tracker tracker1, SMT_Tracker tracker2, bool sym1_enabled, bool sym2_enabled,
                   bool sym1_inverse, bool sym2_inverse, string sym1_ticker, string sym2_ticker) =>
    bool has_smt = false
    int x1 = na
    int x2 = na
    float y1 = na
    float y2 = na
    string smt_sym = ""
    
    // Track which symbols triggered SMT for combined label
    bool sym1_triggered = false
    bool sym2_triggered = false
    
    // Current symbol's price action
    bool curr_hh = tracker_curr.h > tracker_curr.prev_h  // Current makes higher high
    bool curr_ll = tracker_curr.l < tracker_curr.prev_l  // Current makes lower low
    bool curr_lh = not na(tracker_curr.prev_h) ? tracker_curr.h < tracker_curr.prev_h : false  // Current makes lower high
    bool curr_hl = not na(tracker_curr.prev_l) ? tracker_curr.l > tracker_curr.prev_l : false  // Current makes higher low
    
    // Check Symbol 1 for SMT
    if sym1_enabled and not na(tracker1.prev_h) and not na(tracker1.h) and not na(tracker_curr.prev_h)
        bool comp_hh = tracker1.h > tracker1.prev_h
        bool comp_ll = not na(tracker1.prev_l) ? tracker1.l < tracker1.prev_l : false
        bool comp_lh = tracker1.h < tracker1.prev_h
        bool comp_hl = not na(tracker1.prev_l) ? tracker1.l > tracker1.prev_l : false
        
        if is_bearish
            // Current Leads: current HH, comparison LH (or inverse: current HH, comp HL)
            bool curr_leads = sym1_inverse ? (curr_hh and comp_hl) : (curr_hh and comp_lh)
            // Comparison Leads: comp HH, current LH (or inverse: comp LL, curr LH)
            bool comp_leads = sym1_inverse ? (comp_ll and curr_lh) : (comp_hh and curr_lh)
            if curr_leads or comp_leads
                sym1_triggered := true
        else
            // Current Leads: current LL, comparison HL (or inverse: current LL, comp LH)
            bool curr_leads = sym1_inverse ? (curr_ll and comp_lh) : (curr_ll and comp_hl)
            // Comparison Leads: comp LL, current HL (or inverse: comp HH, curr HL)
            bool comp_leads = sym1_inverse ? (comp_hh and curr_hl) : (comp_ll and curr_hl)
            if curr_leads or comp_leads
                sym1_triggered := true
    
    // Check Symbol 2 for SMT (independently, not early exit)
    if sym2_enabled and not na(tracker2.prev_h) and not na(tracker2.h) and not na(tracker_curr.prev_h)
        bool comp_hh = tracker2.h > tracker2.prev_h
        bool comp_ll = not na(tracker2.prev_l) ? tracker2.l < tracker2.prev_l : false
        bool comp_lh = tracker2.h < tracker2.prev_h
        bool comp_hl = not na(tracker2.prev_l) ? tracker2.l > tracker2.prev_l : false
        
        if is_bearish
            bool curr_leads = sym2_inverse ? (curr_hh and comp_hl) : (curr_hh and comp_lh)
            bool comp_leads = sym2_inverse ? (comp_ll and curr_lh) : (comp_hh and curr_lh)
            if curr_leads or comp_leads
                sym2_triggered := true
        else
            bool curr_leads = sym2_inverse ? (curr_ll and comp_lh) : (curr_ll and comp_hl)
            bool comp_leads = sym2_inverse ? (comp_hh and curr_hl) : (comp_ll and curr_hl)
            if curr_leads or comp_leads
                sym2_triggered := true
    
    // Set output if any SMT detected
    if sym1_triggered or sym2_triggered
        has_smt := true
        // Coordinates are always the current symbol's (same for both)
        if is_bearish
            x1 := tracker_curr.prev_h_idx
            x2 := tracker_curr.h_idx
            y1 := tracker_curr.prev_h
            y2 := tracker_curr.h
        else
            x1 := tracker_curr.prev_l_idx
            x2 := tracker_curr.l_idx
            y1 := tracker_curr.prev_l
            y2 := tracker_curr.l
        // Combine ticker names when both trigger (like HTF SMT)
        smt_sym := sym1_triggered and sym2_triggered ? sym1_ticker + "/" + sym2_ticker : sym1_triggered ? sym1_ticker : sym2_ticker
    
    [has_smt, x1, x2, y1, y2, smt_sym]

// ============================================================================
// Drawing Bin Methods
// ============================================================================

method clear(DrawingBin bin) =>
    for ln in bin.lines
        ln.delete()
    for bx in bin.boxes
        bx.delete()
    for lbl in bin.labels
        lbl.delete()
    bin.lines.clear()
    bin.boxes.clear()
    bin.labels.clear()

// ============================================================================
// Data Collection Methods (NO DRAWING)
// ============================================================================

method Monitor(CandleSet candleSet, bool isNewHTFCandleArg) =>
    // isNewHTFCandle is now passed in from main execution to avoid global var modification in function
    isNewHTFCandle = isNewHTFCandleArg

    // Early cleanup: When new HTF candle starts, clear unconfirmed setups from previous candle
    // This allows new sweeps to be detected on the first bar
    if isNewHTFCandle
        // Clear stale bearish setup if not confirmed
        if candleSet.has_live_bearish
            Setup setup = candleSet.live_bearish
            // If setup is in C2 phase (not post-C2) and wasn't created on this bar
            if setup.sweep_bar_idx != bar_index and not setup.is_post_c2
                // Check if C2 close confirmed the sweep using previous bar's close
                bool c2_confirmed = close[1] < setup.sweep_price
                if not c2_confirmed
                    candleSet.has_live_bearish := false
        // Clear stale bullish setup if not confirmed
        if candleSet.has_live_bullish
            Setup setup = candleSet.live_bullish
            if setup.sweep_bar_idx != bar_index and not setup.is_post_c2
                bool c2_confirmed = close[1] > setup.sweep_price
                if not c2_confirmed
                    candleSet.has_live_bullish := false

    // Live sweep detection - ALWAYS runs (needed for history)
    // Drawing of live setups is controlled by settings.sweep_live
    // On first LTF bar of new HTF candle, the previous completed HTF is at index 0 (not shifted yet)
    // On subsequent bars, it's at index 1
    int prev_idx = isNewHTFCandle ? 0 : 1
    
    if candleSet.candles.size() > prev_idx
        Candle prev_htf = candleSet.candles.get(prev_idx)  // Previous completed HTF candle (to be swept)
        bool high_breached = high > prev_htf.h
        bool low_breached = low < prev_htf.l
        bool high_sweep_confirmed = high_breached and close < prev_htf.h
        bool low_sweep_confirmed = low_breached and close > prev_htf.l

        // ===== MITIGATION + C4 ENTRY ZONE INVALIDATION FOR CONFIRMED SETUPS =====
        for [i, setup] in candleSet.setups
            ICMarkTaken(setup)
            // Only check mitigation if setup is still within C4 window
            if setup.cisd_triggered and not na(setup.liq_end_time) and time < setup.liq_end_time
                if setup.is_bullish
                    // Bullish: check if high crosses liq levels
                    if not na(setup.liq_c1_price) and na(setup.liq_c1_mitigated_idx)
                        if high >= setup.liq_c1_price
                            setup.liq_c1_mitigated_idx := bar_index
                    if not na(setup.liq_c0_price) and na(setup.liq_c0_mitigated_idx)
                        if high >= setup.liq_c0_price
                            setup.liq_c0_mitigated_idx := bar_index
                    // C4 invalidation (C4 window only): beyond C3 low — stop EQ + drop zone
                    if not setup.ez_c4_invalid and not na(setup.c3_extreme) and not na(setup.ez_c4_left_time) and not na(setup.ez_c4_right_time) and time < setup.ez_c4_right_time and low < setup.c3_extreme
                        setup.ez_c4_invalid := true
                        setup.ez_c4_invalid_time := time_close
                else
                    // Bearish: check if low crosses liq levels
                    if not na(setup.liq_c1_price) and na(setup.liq_c1_mitigated_idx)
                        if low <= setup.liq_c1_price
                            setup.liq_c1_mitigated_idx := bar_index
                    if not na(setup.liq_c0_price) and na(setup.liq_c0_mitigated_idx)
                        if low <= setup.liq_c0_price
                            setup.liq_c0_mitigated_idx := bar_index
                    // C4 invalidation (C4 window only): beyond C3 high — stop EQ + drop zone
                    if not setup.ez_c4_invalid and not na(setup.c3_extreme) and not na(setup.ez_c4_left_time) and not na(setup.ez_c4_right_time) and time < setup.ez_c4_right_time and high > setup.c3_extreme
                        setup.ez_c4_invalid := true
                        setup.ez_c4_invalid_time := time_close
                ICUpdate(setup)

        // ===== BEARISH TRACKING (when high is wicked) =====
        if not candleSet.has_live_bearish
            // Start tracking when high is breached (wick)
            if high_breached
                Setup setup = Setup.new()
                setup.is_bullish := false
                setup.is_confirmed := false
                setup.sweep_price := prev_htf.h
                setup.sweep_ltf_idx := prev_htf.h_idx
                setup.sweep_bar_idx := bar_index
                setup.swept_candle_idx := prev_htf.o_idx
                setup.htf_candle_idx := isNewHTFCandle ? bar_index : candleSet.candles.first().o_idx
                setup.ltf_end_idx := bar_index + 50
                setup.c2_x := bar_index
                setup.c2_y := high
                setup.htf_count := 1
                // Initialize CISD tracking - use highest high so far
                if isNewHTFCandle
                    setup.tracked_extreme := high
                    setup.extreme_bar_idx := bar_index
                else
                    if high > candleSet.candles.first().h
                        setup.tracked_extreme := high
                        setup.extreme_bar_idx := bar_index
                    else
                        setup.tracked_extreme := candleSet.candles.first().h
                        setup.extreme_bar_idx := candleSet.candles.first().h_idx
                // Find CISD from the extreme bar (bias = 1 for bullish candles)
                [cisd_price, cisd_idx] = FindCISDLevel(setup.extreme_bar_idx, 1)
                if not na(cisd_price)
                    setup.cisd_level := cisd_price
                    setup.cisd_start_idx := cisd_idx
                    setup.has_cisd := true
                // Check if sweep is already confirmed on this bar
                if high_sweep_confirmed
                    setup.is_confirmed := true
                // Capture liquidity data - C1 is prev_htf, C0 is the candle before it
                setup.liq_c1_price := prev_htf.l
                setup.liq_c1_start_idx := prev_htf.l_idx
                // Check if C0 exists and has lower low
                int c0_idx = isNewHTFCandle ? 1 : 2
                if candleSet.candles.size() > c0_idx
                    Candle c0 = candleSet.candles.get(c0_idx)
                    if c0.l < prev_htf.l
                        setup.liq_c0_price := c0.l
                        setup.liq_c0_start_idx := c0.l_idx
                // SMT detection - check if comparison symbol fails to make HH
                if smt_show_input
                    [has_smt, x1, x2, y1, y2, sym_name] = CheckSMTDivergence(true, smt_tracker_curr,
                        smt_tracker1, smt_tracker2, true, smt_sym2_enable_input,
                        smt_sym1_inverse, smt_sym2_inverse, smt_sym1_ticker, smt_sym2_ticker)
                    if has_smt
                        setup.has_smt := true
                        // Use accurate Candle data for coordinates:
                        // C1 (prev HTF) high is fixed, C2 (current) uses tracked extreme
                        setup.smt_x1 := prev_htf.h_idx    // C1's exact high bar
                        setup.smt_y1 := prev_htf.h        // C1's exact high price
                        setup.smt_x2 := setup.extreme_bar_idx  // C2's running high bar
                        setup.smt_y2 := setup.tracked_extreme  // C2's running high price
                        setup.smt_symbol := sym_name
                        if settings.alerts_enabled and smt_alerts_input and (settings.bias == "Neutral" or settings.bias == "Bearish")
                            alert(BuildAlertMessage(candleSet.settings.htf, false, false, "SMT"), alert.freq_once_per_bar)
                candleSet.live_bearish := setup
                candleSet.has_live_bearish := true
        else
            // Bearish tracking exists - update extreme and check CISD
            setup = candleSet.live_bearish
            
            if not setup.is_post_c2
                // C2 phase: dynamic sweep confirmation
                setup.is_confirmed := close < setup.sweep_price
                
                // Update extreme if new high made
                if high > setup.tracked_extreme
                    setup.tracked_extreme := high
                    setup.extreme_bar_idx := bar_index
                    setup.c2_x := bar_index
                    setup.c2_y := high
                    // Sync SMT coordinates if SMT was detected
                    if setup.has_smt
                        setup.smt_x2 := bar_index
                        setup.smt_y2 := high
                    // Recalculate CISD from new extreme
                    [new_cisd_price, new_cisd_idx] = FindCISDLevel(bar_index, 1)
                    if not na(new_cisd_price)
                        setup.cisd_level := new_cisd_price
                        setup.cisd_start_idx := new_cisd_idx
                        setup.has_cisd := true
                        setup.cisd_triggered := false  // Reset trigger on new extreme
                        setup.cisd_end_idx := na
                        ResetICCisd(setup)  // IC must wait for new main CISD confirm
                
                // Body break = CISD line end. Show / IC / alerts wait until sweep is also back in.
                if setup.has_cisd and na(setup.cisd_end_idx) and close < setup.cisd_level
                    setup.cisd_end_idx := bar_index
                if setup.is_confirmed and setup.has_cisd and not setup.cisd_triggered and not na(setup.cisd_end_idx)
                    setup.cisd_triggered := true
                    // Capture projection data immediately so projections show when CISD forms
                    int cisd_lookback = bar_index - setup.cisd_start_idx
                    setup.proj_start_idx := setup.cisd_start_idx
                    setup.proj_end_idx := setup.extreme_bar_idx + 1  // End 1 bar after swing point
                    if settings.proj_type == "Wick"
                        setup.proj_anchor_1 := setup.tracked_extreme        // Swing high
                        setup.proj_anchor_0 := low[cisd_lookback]            // CISD source candle's low
                    else
                        // Body mode - use CISD source candle's body
                        int extreme_lookback = bar_index - setup.extreme_bar_idx
                        setup.proj_anchor_1 := math.max(open[extreme_lookback], close[extreme_lookback])
                        setup.proj_anchor_0 := math.min(open[cisd_lookback], close[cisd_lookback])
                    // Live/Potential alert for bearish CISD trigger
                    if settings.live_alerts_enabled and (settings.bias == "Neutral" or settings.bias == "Bearish")
                        alert(BuildAlertMessage(candleSet.settings.htf, false, true, "Candle 2"), alert.freq_once_per_bar)
                
                // Liquidity mitigation check (bearish: price crosses DOWN through liq level)
                if not na(setup.liq_c1_price) and na(setup.liq_c1_mitigated_idx)
                    if low <= setup.liq_c1_price
                        setup.liq_c1_mitigated_idx := bar_index
                if not na(setup.liq_c0_price) and na(setup.liq_c0_mitigated_idx)
                    if low <= setup.liq_c0_price
                        setup.liq_c0_mitigated_idx := bar_index
                ICUpdate(setup)
            else
                // Post-C2 phase: check for invalidation, cancellation, or CISD trigger
                bool setup_replaced = false
                
                if high > setup.c2_extreme
                    if setup.cisd_triggered
                        // CISD already triggered - this is an INVALIDATION
                        // Push invalidated setup to history (will show as xC2)
                        setup.is_invalid := true
                        StopICDetection(setup)  // keep confirmed IC marks with this setup
                        candleSet.setups.unshift(setup)
                        // Also create a new concurrent setup (same as cascade)
                        Candle old_c2 = candleSet.candles.get(1)  // C2 is at index 1
                        Setup new_setup = Setup.new()
                        new_setup.is_bullish := false
                        new_setup.is_confirmed := false
                        new_setup.is_post_c2 := false  // New setup is in C2 phase
                        new_setup.sweep_price := setup.c2_extreme  // Sweep old C2's high
                        new_setup.sweep_ltf_idx := old_c2.h_idx    // Where old C2's high occurred
                        new_setup.sweep_bar_idx := bar_index
                        new_setup.swept_candle_idx := setup.htf_candle_idx  // Old C2 becomes C1 to sweep
                        new_setup.htf_candle_idx := candleSet.candles.first().o_idx  // Current becomes C2
                        new_setup.ltf_end_idx := bar_index + 50
                        new_setup.c2_x := bar_index
                        new_setup.c2_y := high
                        new_setup.htf_count := 1
                        new_setup.tracked_extreme := high
                        new_setup.extreme_bar_idx := bar_index
                        // Find CISD from the extreme bar
                        [cisd_price_inv, cisd_idx_inv] = FindCISDLevel(bar_index, 1)
                        if not na(cisd_price_inv)
                            new_setup.cisd_level := cisd_price_inv
                            new_setup.cisd_start_idx := cisd_idx_inv
                            new_setup.has_cisd := true
                        // Capture C1 liquidity (old C2's low)
                        new_setup.liq_c1_price := old_c2.l
                        new_setup.liq_c1_start_idx := old_c2.l_idx
                        // Check if sweep is already confirmed on this bar
                        if close < new_setup.sweep_price
                            new_setup.is_confirmed := true
                        // Replace live setup with new one
                        candleSet.live_bearish := new_setup
                        setup_replaced := true
                    else
                        // CISD not triggered - cancel and IMMEDIATELY start new setup
                        // Old C2 becomes new C1, current bar (C3) becomes new C2
                        Candle old_c2 = candleSet.candles.get(1)  // C2 is at index 1
                        Setup new_setup = Setup.new()
                        new_setup.is_bullish := false
                        new_setup.is_confirmed := false
                        new_setup.is_post_c2 := false  // New setup is in C2 phase
                        new_setup.sweep_price := setup.c2_extreme  // Sweep old C2's high
                        new_setup.sweep_ltf_idx := old_c2.h_idx    // Where old C2's high occurred
                        new_setup.sweep_bar_idx := bar_index
                        new_setup.swept_candle_idx := setup.htf_candle_idx  // Old C2 becomes C1 to sweep
                        new_setup.htf_candle_idx := candleSet.candles.first().o_idx  // Current becomes C2
                        new_setup.ltf_end_idx := bar_index + 50
                        new_setup.c2_x := bar_index
                        new_setup.c2_y := high
                        new_setup.htf_count := 1
                        new_setup.tracked_extreme := high
                        new_setup.extreme_bar_idx := bar_index
                        // Find CISD from the extreme bar
                        [cisd_price, cisd_idx] = FindCISDLevel(bar_index, 1)
                        if not na(cisd_price)
                            new_setup.cisd_level := cisd_price
                            new_setup.cisd_start_idx := cisd_idx
                            new_setup.has_cisd := true
                        // Capture C1 liquidity (old C2's low)
                        new_setup.liq_c1_price := old_c2.l
                        new_setup.liq_c1_start_idx := old_c2.l_idx
                        // Check if sweep is already confirmed on this bar
                        if close < new_setup.sweep_price
                            new_setup.is_confirmed := true
                        // Replace live setup with new one
                        candleSet.live_bearish := new_setup
                        setup_replaced := true
                
                // Only continue tracking if setup wasn't replaced
                if not setup_replaced
                    // Liquidity mitigation check (post-C2 bearish)
                    if not na(setup.liq_c1_price) and na(setup.liq_c1_mitigated_idx)
                        if low <= setup.liq_c1_price
                            setup.liq_c1_mitigated_idx := bar_index
                    if not na(setup.liq_c0_price) and na(setup.liq_c0_mitigated_idx)
                        if low <= setup.liq_c0_price
                            setup.liq_c0_mitigated_idx := bar_index
                    
                    // CISD trigger check
                    if setup.has_cisd and not setup.cisd_triggered and close < setup.cisd_level
                        // CISD triggered - capture data but DON'T push to history yet (wait for C3 close)
                        setup.cisd_triggered := true
                        setup.cisd_end_idx := bar_index
                        // Capture projection data
                        int cisd_lookback = bar_index - setup.cisd_start_idx
                        setup.proj_start_idx := setup.cisd_start_idx
                        setup.proj_end_idx := setup.extreme_bar_idx + 1  // End 1 bar after swing point
                        if settings.proj_type == "Wick"
                            setup.proj_anchor_1 := setup.tracked_extreme        // Swing high
                            setup.proj_anchor_0 := low[cisd_lookback]            // CISD source candle's low
                        else
                            // Body mode - use CISD source candle's body
                            int extreme_lookback = bar_index - setup.extreme_bar_idx
                            setup.proj_anchor_1 := math.max(open[extreme_lookback], close[extreme_lookback])
                            setup.proj_anchor_0 := math.min(open[cisd_lookback], close[cisd_lookback])
                        // Calculate C4 end time (current + 1 HTF duration)
                        setup.liq_end_time := isQuarterlyMode() ? (time + getQuarterlyDurationSeconds(candleSet.settings.htf) * 1000) : (time_close(candleSet.settings.htf) + timeframe.in_seconds(candleSet.settings.htf) * 1000)
                        TrySetEntryZoneC3(setup)
                        // Confirmed alert for bearish CISD trigger (post-C2 = already confirmed)
                        if settings.alerts_enabled and (settings.bias == "Neutral" or settings.bias == "Bearish")
                            alert(BuildAlertMessage(candleSet.settings.htf, false, false, "Candle 2"), alert.freq_once_per_bar)
                if not setup_replaced
                    ICUpdate(setup)

        // ===== BULLISH TRACKING (when low is wicked) =====
        if not candleSet.has_live_bullish
            // Start tracking when low is breached (wick)
            if low_breached
                Setup setup = Setup.new()
                setup.is_bullish := true
                setup.is_confirmed := false
                setup.sweep_price := prev_htf.l
                setup.sweep_ltf_idx := prev_htf.l_idx
                setup.sweep_bar_idx := bar_index
                setup.swept_candle_idx := prev_htf.o_idx
                setup.htf_candle_idx := isNewHTFCandle ? bar_index : candleSet.candles.first().o_idx
                setup.ltf_end_idx := bar_index + 50
                setup.c2_x := bar_index
                setup.c2_y := low
                setup.htf_count := 1
                // Initialize CISD tracking - use lowest low so far
                if isNewHTFCandle
                    setup.tracked_extreme := low
                    setup.extreme_bar_idx := bar_index
                else
                    if low < candleSet.candles.first().l
                        setup.tracked_extreme := low
                        setup.extreme_bar_idx := bar_index
                    else
                        setup.tracked_extreme := candleSet.candles.first().l
                        setup.extreme_bar_idx := candleSet.candles.first().l_idx
                // Find CISD from the extreme bar (bias = -1 for bearish candles)
                [cisd_price, cisd_idx] = FindCISDLevel(setup.extreme_bar_idx, -1)
                if not na(cisd_price)
                    setup.cisd_level := cisd_price
                    setup.cisd_start_idx := cisd_idx
                    setup.has_cisd := true
                // Check if sweep is already confirmed on this bar
                if low_sweep_confirmed
                    setup.is_confirmed := true
                // Capture liquidity data - C1 is prev_htf, C0 is the candle before it
                setup.liq_c1_price := prev_htf.h
                setup.liq_c1_start_idx := prev_htf.h_idx
                // Check if C0 exists and has higher high
                int c0_idx = isNewHTFCandle ? 1 : 2
                if candleSet.candles.size() > c0_idx
                    Candle c0 = candleSet.candles.get(c0_idx)
                    if c0.h > prev_htf.h
                        setup.liq_c0_price := c0.h
                        setup.liq_c0_start_idx := c0.h_idx
                // SMT detection - check if comparison symbol fails to make LL
                if smt_show_input
                    [has_smt, x1, x2, y1, y2, sym_name] = CheckSMTDivergence(false, smt_tracker_curr,
                        smt_tracker1, smt_tracker2, true, smt_sym2_enable_input,
                        smt_sym1_inverse, smt_sym2_inverse, smt_sym1_ticker, smt_sym2_ticker)
                    if has_smt
                        setup.has_smt := true
                        // Use accurate Candle data for coordinates:
                        // C1 (prev HTF) low is fixed, C2 (current) uses tracked extreme
                        setup.smt_x1 := prev_htf.l_idx    // C1's exact low bar
                        setup.smt_y1 := prev_htf.l        // C1's exact low price
                        setup.smt_x2 := setup.extreme_bar_idx  // C2's running low bar
                        setup.smt_y2 := setup.tracked_extreme  // C2's running low price
                        setup.smt_symbol := sym_name
                        if settings.alerts_enabled and smt_alerts_input and (settings.bias == "Neutral" or settings.bias == "Bullish")
                            alert(BuildAlertMessage(candleSet.settings.htf, true, false, "SMT"), alert.freq_once_per_bar)
                candleSet.live_bullish := setup
                candleSet.has_live_bullish := true
        else
            // Bullish tracking exists - update extreme and check CISD
            setup = candleSet.live_bullish
            
            if not setup.is_post_c2
                // C2 phase: dynamic sweep confirmation
                setup.is_confirmed := close > setup.sweep_price
                
                // Update extreme if new low made
                if low < setup.tracked_extreme
                    setup.tracked_extreme := low
                    setup.extreme_bar_idx := bar_index
                    setup.c2_x := bar_index
                    setup.c2_y := low
                    // Sync SMT coordinates if SMT was detected
                    if setup.has_smt
                        setup.smt_x2 := bar_index
                        setup.smt_y2 := low
                    // Recalculate CISD from new extreme
                    [new_cisd_price, new_cisd_idx] = FindCISDLevel(bar_index, -1)
                    if not na(new_cisd_price)
                        setup.cisd_level := new_cisd_price
                        setup.cisd_start_idx := new_cisd_idx
                        setup.has_cisd := true
                        setup.cisd_triggered := false  // Reset trigger on new extreme
                        setup.cisd_end_idx := na
                        ResetICCisd(setup)  // IC must wait for new main CISD confirm
                
                // Body break = CISD line end. Show / IC / alerts wait until sweep is also back in.
                if setup.has_cisd and na(setup.cisd_end_idx) and close > setup.cisd_level
                    setup.cisd_end_idx := bar_index
                if setup.is_confirmed and setup.has_cisd and not setup.cisd_triggered and not na(setup.cisd_end_idx)
                    setup.cisd_triggered := true
                    // Capture projection data immediately so projections show when CISD forms
                    int cisd_lookback = bar_index - setup.cisd_start_idx
                    setup.proj_start_idx := setup.cisd_start_idx
                    setup.proj_end_idx := setup.extreme_bar_idx + 1  // End 1 bar after swing point
                    if settings.proj_type == "Wick"
                        setup.proj_anchor_1 := setup.tracked_extreme        // Swing low
                        setup.proj_anchor_0 := high[cisd_lookback]           // CISD source candle's high
                    else
                        // Body mode - use CISD source candle's body
                        int extreme_lookback = bar_index - setup.extreme_bar_idx
                        setup.proj_anchor_1 := math.min(open[extreme_lookback], close[extreme_lookback])
                        setup.proj_anchor_0 := math.max(open[cisd_lookback], close[cisd_lookback])
                    // Live/Potential alert for bullish CISD trigger
                    if settings.live_alerts_enabled and (settings.bias == "Neutral" or settings.bias == "Bullish")
                        alert(BuildAlertMessage(candleSet.settings.htf, true, true, "Candle 2"), alert.freq_once_per_bar)
                
                // Liquidity mitigation check (bullish: price crosses UP through liq level)
                if not na(setup.liq_c1_price) and na(setup.liq_c1_mitigated_idx)
                    if high >= setup.liq_c1_price
                        setup.liq_c1_mitigated_idx := bar_index
                if not na(setup.liq_c0_price) and na(setup.liq_c0_mitigated_idx)
                    if high >= setup.liq_c0_price
                        setup.liq_c0_mitigated_idx := bar_index
                ICUpdate(setup)
            else
                // Post-C2 phase: check for invalidation, cancellation, or CISD trigger
                bool setup_replaced = false
                
                if low < setup.c2_extreme
                    if setup.cisd_triggered
                        // CISD already triggered - this is an INVALIDATION
                        // Push invalidated setup to history (will show as xC2)
                        setup.is_invalid := true
                        StopICDetection(setup)  // keep confirmed IC marks with this setup
                        candleSet.setups.unshift(setup)
                        // Also create a new concurrent setup (same as cascade)
                        Candle old_c2 = candleSet.candles.get(1)  // C2 is at index 1
                        Setup new_setup = Setup.new()
                        new_setup.is_bullish := true
                        new_setup.is_confirmed := false
                        new_setup.is_post_c2 := false  // New setup is in C2 phase
                        new_setup.sweep_price := setup.c2_extreme  // Sweep old C2's low
                        new_setup.sweep_ltf_idx := old_c2.l_idx    // Where old C2's low occurred
                        new_setup.sweep_bar_idx := bar_index
                        new_setup.swept_candle_idx := setup.htf_candle_idx  // Old C2 becomes C1 to sweep
                        new_setup.htf_candle_idx := candleSet.candles.first().o_idx  // Current becomes C2
                        new_setup.ltf_end_idx := bar_index + 50
                        new_setup.c2_x := bar_index
                        new_setup.c2_y := low
                        new_setup.htf_count := 1
                        new_setup.tracked_extreme := low
                        new_setup.extreme_bar_idx := bar_index
                        // Find CISD from the extreme bar (bias = -1 for bearish candles)
                        [cisd_price_inv, cisd_idx_inv] = FindCISDLevel(bar_index, -1)
                        if not na(cisd_price_inv)
                            new_setup.cisd_level := cisd_price_inv
                            new_setup.cisd_start_idx := cisd_idx_inv
                            new_setup.has_cisd := true
                        // Capture C1 liquidity (old C2's high)
                        new_setup.liq_c1_price := old_c2.h
                        new_setup.liq_c1_start_idx := old_c2.h_idx
                        // Check if sweep is already confirmed on this bar
                        if close > new_setup.sweep_price
                            new_setup.is_confirmed := true
                        // Replace live setup with new one
                        candleSet.live_bullish := new_setup
                        setup_replaced := true
                    else
                        // CISD not triggered - cancel and IMMEDIATELY start new setup
                        // Old C2 becomes new C1, current bar (C3) becomes new C2
                        Candle old_c2 = candleSet.candles.get(1)  // C2 is at index 1
                        Setup new_setup = Setup.new()
                        new_setup.is_bullish := true
                        new_setup.is_confirmed := false
                        new_setup.is_post_c2 := false  // New setup is in C2 phase
                        new_setup.sweep_price := setup.c2_extreme  // Sweep old C2's low
                        new_setup.sweep_ltf_idx := old_c2.l_idx    // Where old C2's low occurred
                        new_setup.sweep_bar_idx := bar_index
                        new_setup.swept_candle_idx := setup.htf_candle_idx  // Old C2 becomes C1 to sweep
                        new_setup.htf_candle_idx := candleSet.candles.first().o_idx  // Current becomes C2
                        new_setup.ltf_end_idx := bar_index + 50
                        new_setup.c2_x := bar_index
                        new_setup.c2_y := low
                        new_setup.htf_count := 1
                        new_setup.tracked_extreme := low
                        new_setup.extreme_bar_idx := bar_index
                        // Find CISD from the extreme bar (bias = -1 for bearish candles)
                        [cisd_price, cisd_idx] = FindCISDLevel(bar_index, -1)
                        if not na(cisd_price)
                            new_setup.cisd_level := cisd_price
                            new_setup.cisd_start_idx := cisd_idx
                            new_setup.has_cisd := true
                        // Capture C1 liquidity (old C2's high)
                        new_setup.liq_c1_price := old_c2.h
                        new_setup.liq_c1_start_idx := old_c2.h_idx
                        // Check if sweep is already confirmed on this bar
                        if close > new_setup.sweep_price
                            new_setup.is_confirmed := true
                        // Replace live setup with new one
                        candleSet.live_bullish := new_setup
                        setup_replaced := true
                
                // Only continue tracking if setup wasn't replaced
                if not setup_replaced
                    // Liquidity mitigation check (post-C2 bullish)
                    if not na(setup.liq_c1_price) and na(setup.liq_c1_mitigated_idx)
                        if high >= setup.liq_c1_price
                            setup.liq_c1_mitigated_idx := bar_index
                    if not na(setup.liq_c0_price) and na(setup.liq_c0_mitigated_idx)
                        if high >= setup.liq_c0_price
                            setup.liq_c0_mitigated_idx := bar_index
                    
                    // CISD trigger check
                    if setup.has_cisd and not setup.cisd_triggered and close > setup.cisd_level
                        // CISD triggered - capture data but DON'T push to history yet (wait for C3 close)
                        setup.cisd_triggered := true
                        setup.cisd_end_idx := bar_index
                        // Capture projection data
                        int cisd_lookback = bar_index - setup.cisd_start_idx
                        setup.proj_start_idx := setup.cisd_start_idx
                        setup.proj_end_idx := setup.extreme_bar_idx + 1  // End 1 bar after swing point
                        if settings.proj_type == "Wick"
                            setup.proj_anchor_1 := setup.tracked_extreme        // Swing low
                            setup.proj_anchor_0 := high[cisd_lookback]           // CISD source candle's high
                        else
                            // Body mode - use CISD source candle's body
                            int extreme_lookback = bar_index - setup.extreme_bar_idx
                            setup.proj_anchor_1 := math.min(open[extreme_lookback], close[extreme_lookback])
                            setup.proj_anchor_0 := math.max(open[cisd_lookback], close[cisd_lookback])
                        // Calculate C4 end time (current + 1 HTF duration)
                        setup.liq_end_time := isQuarterlyMode() ? (time + getQuarterlyDurationSeconds(candleSet.settings.htf) * 1000) : (time_close(candleSet.settings.htf) + timeframe.in_seconds(candleSet.settings.htf) * 1000)
                        TrySetEntryZoneC3(setup)
                        // Confirmed alert for bullish CISD trigger (post-C2 = already confirmed)
                        if settings.alerts_enabled and (settings.bias == "Neutral" or settings.bias == "Bullish")
                            alert(BuildAlertMessage(candleSet.settings.htf, true, false, "Candle 2"), alert.freq_once_per_bar)
                if not setup_replaced
                    ICUpdate(setup)

    if isNewHTFCandle
        // Handle live setups on HTF candle close
        // C2 close: Don't push to history, start post-C2 tracking
        // C3 close: Remove if CISD not triggered (time limit)
        
        // Handle bearish live setup
        if candleSet.has_live_bearish
            Setup setup = candleSet.live_bearish
            // Only handle if setup was created before this bar
            if setup.sweep_bar_idx != bar_index
                setup.htf_count := setup.htf_count + 1
                
                if not setup.is_post_c2
                    // C2 just closed - check confirmation using C2's actual close (previous bar)
                    bool c2_confirmed = close[1] < setup.sweep_price
                    if c2_confirmed
                        // Start post-C2 tracking
                        setup.is_post_c2 := true
                        setup.is_confirmed := true  // Lock in confirmation status
                        setup.ltf_end_idx := bar_index  // Lock sweep line end at C3 start
                        setup.c2_extreme := candleSet.candles.first().h  // C2's high for price limit
                        setup.c2_mid := (candleSet.candles.first().h + candleSet.candles.first().l) / 2.0
                        setup.c3_open := open
                        setup.ez_c3_left_time := time
                        TrySetEntryZoneC3(setup)
                        // Note: Even if CISD triggered during C2, continue to post-C2 tracking
                        // to check for invalidation during C3. Will push to history at C3 close.
                        // Confirmed alert if CISD already triggered during C2
                        if setup.cisd_triggered and settings.alerts_enabled and (settings.bias == "Neutral" or settings.bias == "Bearish")
                            alert(BuildAlertMessage(candleSet.settings.htf, false, false, "Candle 2"), alert.freq_once_per_bar)
                    else
                        // Sweep not confirmed at C2 close - remove
                        candleSet.has_live_bearish := false
                else
                    // Post-C2 phase: C3 just closed (htf_count >= 2)
                    if setup.htf_count >= 2
                        // Time limit reached - remove if CISD not triggered
                        if setup.cisd_triggered
                            // COMPLETED! Push to history
                            // Note: ltf_end_idx was already locked at C3 start - don't overwrite
                            // Capture projection data (if not already set)
                            if na(setup.proj_anchor_0) and setup.has_cisd
                                int cisd_lookback = bar_index - setup.cisd_start_idx
                                setup.proj_start_idx := setup.cisd_start_idx
                                setup.proj_end_idx := setup.extreme_bar_idx + 1  // End 1 bar after swing point
                                if settings.proj_type == "Wick"
                                    setup.proj_anchor_1 := setup.tracked_extreme
                                    setup.proj_anchor_0 := low[cisd_lookback]
                                else
                                    int extreme_lookback = bar_index - setup.extreme_bar_idx
                                    setup.proj_anchor_1 := math.max(open[extreme_lookback], close[extreme_lookback])
                                    setup.proj_anchor_0 := math.min(open[cisd_lookback], close[cisd_lookback])
                            // Calculate C4 end time (current + 1 HTF duration since C3 just closed)
                            setup.liq_end_time := isQuarterlyMode() ? (time + getQuarterlyDurationSeconds(candleSet.settings.htf) * 1000) : (time_close(candleSet.settings.htf) + timeframe.in_seconds(candleSet.settings.htf) * 1000)
                            setup.ez_c3_right_time := time  // Lock C3 zone to C3 close / C4 open
                            // C4 entry zone at C4 open (this bar); C3 candle is still first() before unshift
                            int ez_c4_right = isQuarterlyMode() ? (time + getQuarterlyDurationSeconds(candleSet.settings.htf) * 1000) : time_close(candleSet.settings.htf)
                            TrySetEntryZoneC4(setup, candleSet.candles.first().h, candleSet.candles.first().l, open, time, ez_c4_right)
                            candleSet.setups.unshift(setup)
                        candleSet.has_live_bearish := false
        
        // Handle bullish live setup
        if candleSet.has_live_bullish
            Setup setup = candleSet.live_bullish
            // Only handle if setup was created before this bar
            if setup.sweep_bar_idx != bar_index
                setup.htf_count := setup.htf_count + 1
                
                if not setup.is_post_c2
                    // C2 just closed - check confirmation using C2's actual close (previous bar)
                    bool c2_confirmed = close[1] > setup.sweep_price
                    if c2_confirmed
                        // Start post-C2 tracking
                        setup.is_post_c2 := true
                        setup.is_confirmed := true  // Lock in confirmation status
                        setup.ltf_end_idx := bar_index  // Lock sweep line end at C3 start
                        setup.c2_extreme := candleSet.candles.first().l  // C2's low for price limit
                        setup.c2_mid := (candleSet.candles.first().h + candleSet.candles.first().l) / 2.0
                        setup.c3_open := open
                        setup.ez_c3_left_time := time
                        TrySetEntryZoneC3(setup)
                        // Note: Even if CISD triggered during C2, continue to post-C2 tracking
                        // to check for invalidation during C3. Will push to history at C3 close.
                        // Confirmed alert if CISD already triggered during C2
                        if setup.cisd_triggered and settings.alerts_enabled and (settings.bias == "Neutral" or settings.bias == "Bullish")
                            alert(BuildAlertMessage(candleSet.settings.htf, true, false, "Candle 2"), alert.freq_once_per_bar)
                    else
                        // Sweep not confirmed at C2 close - remove
                        candleSet.has_live_bullish := false
                else
                    // Post-C2 phase: C3 just closed (htf_count >= 2)
                    if setup.htf_count >= 2
                        // Time limit reached - remove if CISD not triggered
                        if setup.cisd_triggered
                            // COMPLETED! Push to history
                            // Note: ltf_end_idx was already locked at C3 start - don't overwrite
                            // Capture projection data (if not already set)
                            if na(setup.proj_anchor_0) and setup.has_cisd
                                int cisd_lookback = bar_index - setup.cisd_start_idx
                                setup.proj_start_idx := setup.cisd_start_idx
                                setup.proj_end_idx := setup.extreme_bar_idx + 1  // End 1 bar after swing point
                                if settings.proj_type == "Wick"
                                    setup.proj_anchor_1 := setup.tracked_extreme
                                    setup.proj_anchor_0 := high[cisd_lookback]
                                else
                                    int extreme_lookback = bar_index - setup.extreme_bar_idx
                                    setup.proj_anchor_1 := math.min(open[extreme_lookback], close[extreme_lookback])
                                    setup.proj_anchor_0 := math.max(open[cisd_lookback], close[cisd_lookback])
                            // Calculate C4 end time (current + 1 HTF duration since C3 just closed)
                            setup.liq_end_time := isQuarterlyMode() ? (time + getQuarterlyDurationSeconds(candleSet.settings.htf) * 1000) : (time_close(candleSet.settings.htf) + timeframe.in_seconds(candleSet.settings.htf) * 1000)
                            setup.ez_c3_right_time := time  // Lock C3 zone to C3 close / C4 open
                            // C4 entry zone at C4 open (this bar); C3 candle is still first() before unshift
                            int ez_c4_right_bull = isQuarterlyMode() ? (time + getQuarterlyDurationSeconds(candleSet.settings.htf) * 1000) : time_close(candleSet.settings.htf)
                            TrySetEntryZoneC4(setup, candleSet.candles.first().h, candleSet.candles.first().l, open, time, ez_c4_right_bull)
                            candleSet.setups.unshift(setup)
                        candleSet.has_live_bullish := false
        
        Candle candle = Candle.new()
        candle.o := open
        candle.c := close
        candle.h := high
        candle.l := low
        candle.o_time := time
        candle.o_idx := bar_index
        candle.c_idx := bar_index
        candle.h_idx := bar_index
        candle.l_idx := bar_index
        candle.dow := switch
            candleSet.settings.htf == '1D' =>
                DayofWeek(dayofweek(time_tradingday, "America/New_York"))
            candleSet.settings.htf == '1W' =>
                str.format_time(candle.o_time, 'MMM d', 'America/New_York')
            candleSet.settings.htf == '1M' =>
                str.format_time(candle.o_time, 'MMM', 'America/New_York')
            candleSet.settings.htf == '3M' =>
                int m = month(candle.o_time, 'America/New_York')
                m <= 3 ? 'Q1' : m <= 6 ? 'Q2' : m <= 9 ? 'Q3' : 'Q4'
            candleSet.settings.htf == '12M' =>
                ''
            =>
                str.format_time(candle.o_time, 'HH:mm', 'America/New_York')

        candleSet.candles.unshift(candle)
        
        // Set close time on previous candle (now at index 1)
        if candleSet.candles.size() > 1
            Candle prev = candleSet.candles.get(1)
            prev.c_time := candle.o_time

        // Detect confirmed sweeps from HTF candle data (for historical data)
        if candleSet.candles.size() > 2
            Candle prev_candle = candleSet.candles.get(1)
            Candle prev_prev_candle = candleSet.candles.get(2)
            bool high_breached = prev_candle.h > prev_prev_candle.h
            bool low_breached = prev_candle.l < prev_prev_candle.l
            bool high_sweep_condition = high_breached and prev_candle.c < prev_prev_candle.h
            bool low_sweep_condition = low_breached and prev_candle.c > prev_prev_candle.l

            if settings.sweep_show
                if high_sweep_condition
                    Sweep sweep = Sweep.new()
                    sweep.price := prev_prev_candle.h
                    sweep.ltf_index := prev_prev_candle.h_idx
                    sweep.htf_candle_idx := prev_candle.o_idx
                    sweep.swept_candle_idx := prev_prev_candle.o_idx
                    sweep.ltf_end_idx := candle.o_idx
                    sweep.is_high := true
                    candleSet.sweeps.push(sweep)
                    
                if low_sweep_condition
                    Sweep sweep = Sweep.new()
                    sweep.price := prev_prev_candle.l
                    sweep.ltf_index := prev_prev_candle.l_idx
                    sweep.htf_candle_idx := prev_candle.o_idx
                    sweep.swept_candle_idx := prev_prev_candle.o_idx
                    sweep.ltf_end_idx := candle.o_idx
                    sweep.is_high := false
                    candleSet.sweeps.push(sweep)
                
                // Limit setups storage - store 2x to ensure enough of each bias type when filtering
                int max_setups = (candleSet.settings.max_display + settings.sweep_history) * 2
                while candleSet.setups.size() > max_setups
                    candleSet.setups.pop()

        // Remove oldest candle if exceeds max_display
        if candleSet.candles.size() > candleSet.settings.max_display
            Candle delCandle = array.pop(candleSet.candles)
            // Clean up sweeps associated with the deleted candle
            if candleSet.sweeps.size() > 0
                for i = candleSet.sweeps.size() - 1 to 0 by 1
                    Sweep sweep = candleSet.sweeps.get(i)
                    if sweep.swept_candle_idx == delCandle.o_idx
                        candleSet.sweeps.remove(i)

    candleSet

method Update(CandleSet candleSet) =>
    if candleSet.candles.size() > 0
        Candle candle = candleSet.candles.first()
        if high > candle.h
            candle.h := high
            candle.h_idx := bar_index
        if low < candle.l
            candle.l := low
            candle.l_idx := bar_index
        candle.c := close
        candle.c_idx := bar_index

        // Update trace data
        if candleSet.trace.start_idx == 0
            candleSet.trace.start_idx := candle.o_idx
            candleSet.trace.start_price := candle.o
    candleSet

// Check CISD trigger for confirmed setups
method CheckCISDTrigger(CandleSet candleSet) =>
    if candleSet.setups.size() > 0
        for setup in candleSet.setups
            if setup.is_confirmed and setup.has_cisd and not setup.cisd_triggered
                // Bearish setup: CISD triggered when close goes BELOW cisd_level
                if not setup.is_bullish and close < setup.cisd_level
                    setup.cisd_triggered := true
                    setup.cisd_end_idx := bar_index
                // Bullish setup: CISD triggered when close goes ABOVE cisd_level
                else if setup.is_bullish and close > setup.cisd_level
                    setup.cisd_triggered := true
                    setup.cisd_end_idx := bar_index
    candleSet

// ============================================================================
// Drawing Methods (only called on barstate.islast)
// ============================================================================

method CalculatePositions(CandleSet candleSet, int offset) =>
    size = candleSet.candles.size()
    if size > 0
        for i = size - 1 to 0 by 1
            Candle candle = candleSet.candles.get(i)
            t_buffer = offset + (settings.width + 1) * (size - i - 1)
            candle.candle_left := bar_index + t_buffer
            candle.candle_right := bar_index + settings.width + t_buffer
            candle.wick_x := bar_index + settings.width / 2 + t_buffer
    candleSet

method DrawCandles(CandleSet candleSet) =>
    for [i, candle] in candleSet.candles
        bull = candle.c > candle.o
        // Draw body
        bin.boxes.push(box.new(candle.candle_left, math.max(candle.o, candle.c), candle.candle_right, math.min(candle.o, candle.c), bull ? settings.bull_border : settings.bear_border, 1, bgcolor = bull ? settings.bull_body : settings.bear_body))
        // Draw wicks
        bin.lines.push(line.new(candle.wick_x, candle.h, candle.wick_x, math.max(candle.o, candle.c), color = bull ? settings.bull_wick : settings.bear_wick))
        bin.lines.push(line.new(candle.wick_x, math.min(candle.o, candle.c), candle.wick_x, candle.l, color = bull ? settings.bull_wick : settings.bear_wick))
        // Draw interval value label based on position setting
        if settings.daily_name and candle.dow != ''
            if settings.dow_position == 'Both' or settings.dow_position == 'Top'
                bin.labels.push(label.new(candle.wick_x, candle.h, candle.dow, color = color_transparent, textcolor = settings.dow_color, style = label.style_label_down, size = settings.dow_size))
            if settings.dow_position == 'Both' or settings.dow_position == 'Bottom'
                bin.labels.push(label.new(candle.wick_x, candle.l, candle.dow, color = color_transparent, textcolor = settings.dow_color, style = label.style_label_up, size = settings.dow_size))
    candleSet

method DrawVTHLLines(CandleSet candleSet) =>
    // Draw VT lines and HL lines - these are on the LTF chart, not the HTF projection
    vt_line_style = LineStyle(candleSet.settings.vt_style)
    hl_line_style = LineStyle(candleSet.settings.hl_style)
    
    for [i, candle] in candleSet.candles
        // Draw vertical line
        if candleSet.settings.vt_show
            bin.lines.push(line.new(candle.o_time, candle.h, candle.o_time, candle.l, xloc = xloc.bar_time, extend = extend.both, color = candleSet.settings.vt_color, style = vt_line_style, width = candleSet.settings.vt_size))
        // Draw H/L lines - skip current developing candle (i == 0)
        if candleSet.settings.hl_show and i != 0
            int hl_end_time = candle.c_time
            if hl_end_time > 0
                bin.lines.push(line.new(candle.o_time, candle.h, hl_end_time, candle.h, xloc = xloc.bar_time, color = candleSet.settings.hl_color, style = hl_line_style, width = candleSet.settings.hl_width))
                bin.lines.push(line.new(candle.o_time, candle.l, hl_end_time, candle.l, xloc = xloc.bar_time, color = candleSet.settings.hl_color, style = hl_line_style, width = candleSet.settings.hl_width))
    candleSet

method DrawSweeps(CandleSet candleSet) =>
    if settings.sweep_show
        sweep_line_style = LineStyle(settings.sweep_style)
        for [i, sweep] in candleSet.sweeps
            // LTF sweep line
            bin.lines.push(line.new(sweep.ltf_index, sweep.price, sweep.ltf_end_idx, sweep.price, color = settings.sweep_color, style = sweep_line_style, width = settings.sweep_size))
            // HTF sweep line - need to find candle positions
            int htf_x1 = na
            int htf_x2 = na
            for [j, candle] in candleSet.candles
                if candle.o_idx == sweep.swept_candle_idx
                    htf_x1 := candle.wick_x
                if candle.o_idx == sweep.htf_candle_idx
                    htf_x2 := candle.candle_right
            if not na(htf_x1) and not na(htf_x2)
                bin.lines.push(line.new(htf_x1, sweep.price, htf_x2, sweep.price, color = settings.sweep_color, style = sweep_line_style, width = settings.sweep_size))
    candleSet

method DrawLabels(CandleSet candleSet, int offset) =>
    size = candleSet.candles.size()
    if size > 0 and settings.htf_label_show
        top = CandleSetHigh(candleSet.candles, 0)
        bottom = CandleSetLow(candleSet.candles, top)
        left = bar_index + offset + (settings.width + 1) * (size - 1) / 2
        
        string lbl_text = HTFName(candleSet.settings.htf)
        if settings.htf_timer_show
            lbl_text := lbl_text + '\n\n(' + RemainingTime(candleSet.settings.htf) + ')'
        
        if settings.label_position == 'Both' or settings.label_position == 'Top'
            bin.labels.push(label.new(left, top, lbl_text, color = color_transparent, textcolor = settings.htf_label_color, style = label.style_label_down, size = settings.htf_label_size))
        if settings.label_position == 'Both' or settings.label_position == 'Bottom'
            bin.labels.push(label.new(left, bottom, lbl_text, color = color_transparent, textcolor = settings.htf_label_color, style = label.style_label_up, size = settings.htf_label_size))
    candleSet

method DrawTrace(CandleSet candleSet, int offset) =>
    if settings.trace_show and candleSet.candles.size() > 0
        Candle candle = candleSet.candles.first()
        if bar_index - candle.o_idx < 5000
            bin.lines.push(line.new(candle.o_idx, candle.o, candle.candle_left, candle.o, color = settings.trace_o_color, style = LineStyle(settings.trace_o_style), width = settings.trace_o_size))
    candleSet

method DrawSetups(CandleSet candleSet) =>
    // Cache style calculations once for both sections
    sweep_line_style = LineStyle(settings.sweep_style)
    cisd_line_style = LineStyle(settings.cisd_style)
    
    // Draw confirmed setups
    if candleSet.setups.size() > 0
        int non_visible_count = 0
        int total_count = 0
        
        for [i, setup] in candleSet.setups
            // Skip if not confirmed
            if not setup.is_confirmed
                continue
            
            // Apply bias filter - skip if bias doesn't match
            bool bias_ok = settings.bias == 'Neutral' or (settings.bias == 'Bullish' and setup.is_bullish) or (settings.bias == 'Bearish' and not setup.is_bullish)
            if not bias_ok
                continue
            
            // Check if setup's HTF candle is visible
            bool is_visible = false
            for [j, candle] in candleSet.candles
                if candle.o_idx == setup.htf_candle_idx
                    is_visible := true
                    break
            
            // Determine if we should draw this setup
            bool should_draw = false
            if settings.sweep_visible_only
                if is_visible
                    should_draw := true
                else if non_visible_count < settings.sweep_history
                    should_draw := true
                    non_visible_count := non_visible_count + 1
            else
                if total_count < settings.sweep_history
                    should_draw := true
                    total_count := total_count + 1
            
            if should_draw
                // ==== LAYER 1: LIQUIDITY LINES (behind) - SKIP if invalid ====
                if not setup.is_invalid and settings.liq_show and setup.cisd_triggered and not na(setup.liq_c1_price) and not na(setup.liq_end_time)
                    liq_line_style = LineStyle(settings.liq_style)
                    
                    // Calculate C1 end point: mitigation bar, current bar (if developing), or C4 end
                    int c1_start_time = time[bar_index - setup.liq_c1_start_idx]
                    int c1_end_time = na
                    if not na(setup.liq_c1_mitigated_idx)
                        c1_end_time := time[bar_index - setup.liq_c1_mitigated_idx]
                    else if time < setup.liq_end_time
                        c1_end_time := time  // Developing: extend to current bar
                    else
                        c1_end_time := setup.liq_end_time
                    bin.lines.push(line.new(c1_start_time, setup.liq_c1_price, c1_end_time, setup.liq_c1_price, 
                        xloc = xloc.bar_time, color = settings.liq_color, style = liq_line_style, width = settings.liq_width))
                    
                    // Draw C0 liquidity line if condition was met
                    if not na(setup.liq_c0_price)
                        int c0_start_time = time[bar_index - setup.liq_c0_start_idx]
                        int c0_end_time = na
                        if not na(setup.liq_c0_mitigated_idx)
                            c0_end_time := time[bar_index - setup.liq_c0_mitigated_idx]
                        else if time < setup.liq_end_time
                            c0_end_time := time  // Developing: extend to current bar
                        else
                            c0_end_time := setup.liq_end_time
                        bin.lines.push(line.new(c0_start_time, setup.liq_c0_price, c0_end_time, setup.liq_c0_price, 
                            xloc = xloc.bar_time, color = settings.liq_color, style = liq_line_style, width = settings.liq_width))
                
                // ==== LAYER 2: PROJECTIONS - SKIP if invalid ====
                if not setup.is_invalid and settings.proj_show and setup.cisd_triggered and not na(setup.proj_anchor_1) and not na(setup.proj_anchor_0)
                    proj_line_style = LineStyle(settings.proj_style)
                    proj_label_sz = LabelSize(settings.proj_label_size)
                    float proj_range = setup.proj_anchor_1 - setup.proj_anchor_0
                    
                    for dv = 0 to proj_deviations.size() - 1
                        dev = proj_deviations.get(dv)
                        float price = na
                        if setup.is_bullish
                            price := setup.proj_anchor_0 - (math.abs(proj_range) * dev)
                        else
                            price := setup.proj_anchor_0 + (proj_range * dev)
                        
                        bin.lines.push(line.new(setup.proj_start_idx, price, setup.proj_end_idx, price, 
                            color = settings.proj_color, style = proj_line_style, width = settings.proj_width))
                        
                        if settings.proj_label_show
                            bin.labels.push(label.new(setup.proj_start_idx, price, str.tostring(dev), 
                                color = color_transparent, textcolor = settings.proj_color, 
                                style = label.style_label_right, size = proj_label_sz))
                
                // ==== LAYER 3: C2 LABEL - show "xC2" in red if invalid ====
                if settings.show_c2_lbl
                    lbl_style = setup.is_bullish ? label.style_label_up : label.style_label_down
                    string lbl_text = setup.is_invalid ? "xC2" : "C2"
                    color lbl_color = setup.is_invalid ? color.red : settings.c2_color
                    bin.labels.push(label.new(setup.c2_x, setup.c2_y, lbl_text, color = color_transparent, textcolor = lbl_color, style = lbl_style, size = settings.c2_size))
                
                // ==== LAYER 4: SWEEP LINES (near top) - SKIP if invalid ====
                if not setup.is_invalid and settings.sweep_show
                    bin.lines.push(line.new(setup.sweep_ltf_idx, setup.sweep_price, setup.ltf_end_idx, setup.sweep_price, color = settings.sweep_color, style = sweep_line_style, width = settings.sweep_size))
                
                // Draw HTF sweep line - only when projection is visible, SKIP if invalid
                if not setup.is_invalid and not settings.hide_candles
                    int htf_x1 = na
                    int htf_x2 = na
                    for [k, candle] in candleSet.candles
                        if candle.o_idx == setup.swept_candle_idx
                            htf_x1 := candle.wick_x
                        if candle.o_idx == setup.htf_candle_idx
                            htf_x2 := candle.candle_right
                    if not na(htf_x1) and not na(htf_x2)
                        if settings.sweep_show
                            bin.lines.push(line.new(htf_x1, setup.sweep_price, htf_x2, setup.sweep_price, color = settings.sweep_color, style = sweep_line_style, width = settings.sweep_size))
                
                // ==== LAYER 5: CISD LINE (on top) ====
                if settings.cisd_show and setup.cisd_triggered and setup.has_cisd
                    cisd_color = setup.is_bullish ? settings.cisd_bull_color : settings.cisd_bear_color
                    // Extend 1 bar beyond trigger
                    bin.lines.push(line.new(setup.cisd_start_idx, setup.cisd_level, setup.cisd_end_idx + 1, setup.cisd_level, color = cisd_color, style = cisd_line_style, width = settings.cisd_width))
                
                // ==== LAYER 5b: IC-CISD (draw only after sweep-back-in / show) ====
                if settings.ic_cisd_show and setup.cisd_triggered and not na(setup.ic_list) and setup.ic_list.size() > 0
                    for ic_i = 0 to setup.ic_list.size() - 1
                        ICCisd ic = setup.ic_list.get(ic_i)
                        color ic_col = ic.taken ? color.gray : (setup.is_bullish ? settings.cisd_bull_color : settings.cisd_bear_color)
                        if not na(ic.level) and not na(ic.start_idx) and not na(ic.end_idx)
                            bin.lines.push(line.new(ic.start_idx, ic.level, ic.end_idx, ic.level, color = ic_col, style = cisd_line_style, width = settings.cisd_width))
                        bool ic_dot_ok = psp_show_input and (not ic_dots_current_only or (i == 0 and not candleSet.has_live_bearish and not candleSet.has_live_bullish))
                        if ic_dot_ok and not na(ic.extreme_price) and not na(ic.extreme_idx)
                            ic_dot_style = setup.is_bullish ? label.style_label_up : label.style_label_down
                            color psp_col = ic.taken ? color.gray : (psp_use_cisd_color ? ic_col : psp_color_input)
                            bin.labels.push(label.new(ic.extreme_idx, ic.extreme_price, "●", color = color_transparent, textcolor = psp_col, style = ic_dot_style, size = settings.ic_dot_size))
                
                // ==== LAYER 6: SMT LINE - SKIP if invalid ====
                if not setup.is_invalid and smt_show_input and setup.has_smt and not na(setup.smt_x1) and not na(setup.smt_x2)
                    smt_line_style_hist = LineStyle(smt_line_style_input)
                    // Draw line from prev high/low to current high/low
                    bin.lines.push(line.new(setup.smt_x1, setup.smt_y1, setup.smt_x2, setup.smt_y2, 
                        color = smt_color_input, style = smt_line_style_hist, width = smt_line_width_input))
                    // Draw label at midpoint
                    if smt_label_show_input
                        int mid_x_hist = math.round((setup.smt_x1 + setup.smt_x2) / 2)
                        float mid_y_hist = (setup.smt_y1 + setup.smt_y2) / 2
                        lbl_style_smt_hist = setup.is_bullish ? label.style_label_up : label.style_label_down
                        bin.labels.push(label.new(mid_x_hist, mid_y_hist, setup.smt_symbol, 
                            color = color_transparent, textcolor = smt_color_input, 
                            style = lbl_style_smt_hist, size = LabelSize(smt_label_size_input)))
                
                // ==== LAYER 7: PREVIOUS EQ (chart) — after confirmed; C2 mid on C3, C3 mid on C4 ====
                if not setup.is_invalid and setup.is_confirmed and ShowChartEQ()
                    eq_line_style = LineStyle(prev_eq_style)
                    // C2 EQ across C3 window
                    if not na(setup.c2_mid) and not na(setup.ez_c3_left_time)
                        int eq3_right = EntryZoneRight(setup.ez_c3_right_time)
                        if eq3_right > setup.ez_c3_left_time
                            bin.lines.push(line.new(setup.ez_c3_left_time, setup.c2_mid, eq3_right, setup.c2_mid,
                                xloc = xloc.bar_time, color = prev_eq_color, style = eq_line_style, width = prev_eq_width))
                    // C3 EQ across C4 window — if C4 invalid: stop at that LTF bar, red
                    if not na(setup.c3_mid) and not na(setup.ez_c4_left_time)
                        int eq4_right = setup.ez_c4_invalid and not na(setup.ez_c4_invalid_time) ? setup.ez_c4_invalid_time : EntryZoneRight(setup.ez_c4_right_time)
                        color eq4_col = setup.ez_c4_invalid ? color.red : prev_eq_color
                        if eq4_right > setup.ez_c4_left_time
                            bin.lines.push(line.new(setup.ez_c4_left_time, setup.c3_mid, eq4_right, setup.c3_mid,
                                xloc = xloc.bar_time, color = eq4_col, style = eq_line_style, width = prev_eq_width))
                
                // ==== LAYER 7b: PREVIOUS EQ (HTF projection) — C2 mid→C3 end+2, C3 mid→C4 end+2 ====
                if not setup.is_invalid and setup.is_confirmed and ShowHtfEQ() and not settings.hide_candles
                    int c2_i = FindCandleIndex(candleSet.candles, setup.htf_candle_idx)
                    eq_htf_style = LineStyle(prev_eq_style)
                    // C2 EQ: mid of C2 projection → end of C3 projection + 2 LTF bars
                    if not na(setup.c2_mid) and c2_i > 0
                        Candle c2_proj = candleSet.candles.get(c2_i)
                        Candle c3_proj = candleSet.candles.get(c2_i - 1)
                        int htf_eq3_x1 = c2_proj.wick_x
                        int htf_eq3_x2 = c3_proj.candle_right + 2
                        if htf_eq3_x2 > htf_eq3_x1
                            bin.lines.push(line.new(htf_eq3_x1, setup.c2_mid, htf_eq3_x2, setup.c2_mid,
                                color = prev_eq_color, style = eq_htf_style, width = prev_eq_width))
                    // C3 EQ: mid of C3 projection → end of C4 projection + 2 LTF bars (red if C4 invalid)
                    if not na(setup.c3_mid) and c2_i > 1
                        Candle c3_proj4 = candleSet.candles.get(c2_i - 1)
                        Candle c4_proj = candleSet.candles.get(c2_i - 2)
                        int htf_eq4_x1 = c3_proj4.wick_x
                        int htf_eq4_x2 = c4_proj.candle_right + 2
                        color htf_eq4_col = setup.ez_c4_invalid ? color.red : prev_eq_color
                        if htf_eq4_x2 > htf_eq4_x1
                            bin.lines.push(line.new(htf_eq4_x1, setup.c3_mid, htf_eq4_x2, setup.c3_mid,
                                color = htf_eq4_col, style = eq_htf_style, width = prev_eq_width))
                
                // ==== LAYER 8: ENTRY ZONE C3 - SKIP if invalid ====
                // Label: bearish = top-left of box (label_down), bullish = bottom-left (label_up) — same gap style as C2; one candle right of left edge
                // Zone right edge develops with LTF bars, then locks at C3 end
                if not setup.is_invalid and settings.entry_zone_show and setup.ez_c3_set and not na(setup.ez_c3_left_time)
                    color ez_col = setup.is_bullish ? settings.entry_zone_bull_color : settings.entry_zone_bear_color
                    int ez_right = EntryZoneRight(setup.ez_c3_right_time)
                    bin.boxes.push(box.new(setup.ez_c3_left_time, setup.ez_c3_top, ez_right, setup.ez_c3_bot,
                        xloc = xloc.bar_time, bgcolor = ez_col, border_color = color_transparent, border_width = 0))
                    if settings.show_c3_lbl
                        float ez_lbl_y = setup.is_bullish ? setup.ez_c3_bot : setup.ez_c3_top
                        int ez_lbl_x = setup.ez_c3_left_time + timeframe.in_seconds() * 1000
                        lbl_style_ez = setup.is_bullish ? label.style_label_up : label.style_label_down
                        bin.labels.push(label.new(ez_lbl_x, ez_lbl_y, "C3", xloc = xloc.bar_time,
                            color = color_transparent, textcolor = settings.c2_color, style = lbl_style_ez, size = settings.c2_size))
                
                // ==== LAYER 9: ENTRY ZONE C4 — zone removed if invalidated; label becomes xC4 ====
                // Zone right edge develops with LTF bars, then locks at C4 end
                if not setup.is_invalid and settings.entry_zone_show and setup.ez_c4_set and not na(setup.ez_c4_left_time)
                    color ez4_col = setup.is_bullish ? settings.entry_zone_bull_color : settings.entry_zone_bear_color
                    int ez4_right = EntryZoneRight(setup.ez_c4_right_time)
                    if not setup.ez_c4_invalid
                        bin.boxes.push(box.new(setup.ez_c4_left_time, setup.ez_c4_top, ez4_right, setup.ez_c4_bot,
                            xloc = xloc.bar_time, bgcolor = ez4_col, border_color = color_transparent, border_width = 0))
                    if settings.show_c4_lbl
                        float ez4_lbl_y = setup.is_bullish ? setup.ez_c4_bot : setup.ez_c4_top
                        int ez4_lbl_x = setup.ez_c4_left_time + timeframe.in_seconds() * 1000
                        string ez4_txt = setup.ez_c4_invalid ? "xC4" : "C4"
                        color ez4_lbl_col = setup.ez_c4_invalid ? color.red : settings.c2_color
                        lbl_style_ez4 = setup.is_bullish ? label.style_label_up : label.style_label_down
                        bin.labels.push(label.new(ez4_lbl_x, ez4_lbl_y, ez4_txt, xloc = xloc.bar_time,
                            color = color_transparent, textcolor = ez4_lbl_col, style = lbl_style_ez4, size = settings.c2_size))
    
    // Draw live setups (both bullish and bearish)
    for is_bull in array.from(false, true)
        // Apply bias filter for live setups
        bool bias_ok = settings.bias == 'Neutral' or (settings.bias == 'Bullish' and is_bull) or (settings.bias == 'Bearish' and not is_bull)
        if not bias_ok
            continue
        bool has_live = is_bull ? candleSet.has_live_bullish : candleSet.has_live_bearish
        if not has_live
            continue
        setup = is_bull ? candleSet.live_bullish : candleSet.live_bearish
        // Live on: developing C2 (sweep back in or post-C2). Live off: only after C2 close + CISD printed.
        if settings.sweep_live
            if not (setup.is_confirmed or setup.is_post_c2)
                continue
        else
            if not (setup.is_post_c2 and setup.cisd_triggered)
                continue
            
        // ==== LAYER 1: LIQUIDITY LINES (behind) - SKIP if invalid ====
        if not setup.is_invalid and settings.liq_show and setup.cisd_triggered and not na(setup.liq_c1_price)
            liq_line_style = LineStyle(settings.liq_style)
            
            // C1 line: extend to current bar or stop at mitigation
            int c1_start_time = time[bar_index - setup.liq_c1_start_idx]
            int c1_end_time = not na(setup.liq_c1_mitigated_idx) ? time[bar_index - setup.liq_c1_mitigated_idx] : time
            bin.lines.push(line.new(c1_start_time, setup.liq_c1_price, c1_end_time, setup.liq_c1_price, 
                xloc = xloc.bar_time, color = settings.liq_color, style = liq_line_style, width = settings.liq_width))
            
            // C0 line: extend to current bar or stop at mitigation
            if not na(setup.liq_c0_price)
                int c0_start_time = time[bar_index - setup.liq_c0_start_idx]
                int c0_end_time = not na(setup.liq_c0_mitigated_idx) ? time[bar_index - setup.liq_c0_mitigated_idx] : time
                bin.lines.push(line.new(c0_start_time, setup.liq_c0_price, c0_end_time, setup.liq_c0_price, 
                    xloc = xloc.bar_time, color = settings.liq_color, style = liq_line_style, width = settings.liq_width))
        
        // ==== LAYER 2: PROJECTIONS - SKIP if invalid ====
        if not setup.is_invalid and settings.proj_show and setup.cisd_triggered and not na(setup.proj_anchor_1) and not na(setup.proj_anchor_0)
            proj_line_style = LineStyle(settings.proj_style)
            proj_label_sz = LabelSize(settings.proj_label_size)
            float proj_range = setup.proj_anchor_1 - setup.proj_anchor_0
            
            for dv = 0 to proj_deviations.size() - 1
                dev = proj_deviations.get(dv)
                float price = na
                if is_bull
                    price := setup.proj_anchor_0 - (math.abs(proj_range) * dev)
                else
                    price := setup.proj_anchor_0 + (proj_range * dev)
                
                bin.lines.push(line.new(setup.proj_start_idx, price, setup.proj_end_idx, price, 
                    color = settings.proj_color, style = proj_line_style, width = settings.proj_width))
                
                if settings.proj_label_show
                    bin.labels.push(label.new(setup.proj_start_idx, price, str.tostring(dev), 
                        color = color_transparent, textcolor = settings.proj_color, 
                        style = label.style_label_right, size = proj_label_sz))
        
        // ==== LAYER 3: C2 LABEL — only after C2 close + CISD (confirmed setup, not developing live) ====
        if settings.show_c2_lbl and setup.is_post_c2 and setup.cisd_triggered
            lbl_style = is_bull ? label.style_label_up : label.style_label_down
            string lbl_text = setup.is_invalid ? "xC2" : "C2"
            color lbl_color = setup.is_invalid ? color.red : settings.c2_color
            bin.labels.push(label.new(setup.c2_x, setup.c2_y, lbl_text, color = color_transparent, textcolor = lbl_color, style = lbl_style, size = settings.c2_size))
        
        // ==== LAYER 4: SWEEP LINES (near top) - SKIP if invalid ====
        if not setup.is_invalid and settings.sweep_show
            // For post-C2 setups, use ltf_end_idx (locked at C3 start); for C2 phase, extend to current bar
            int sweep_end = setup.is_post_c2 ? setup.ltf_end_idx : bar_index
            bin.lines.push(line.new(setup.sweep_ltf_idx, setup.sweep_price, sweep_end, setup.sweep_price, color = settings.sweep_color, style = sweep_line_style, width = settings.sweep_size))
        
        // Draw HTF sweep line - only when projection is visible, SKIP if invalid
        if not setup.is_invalid and not settings.hide_candles
            int htf_x1 = na
            int htf_x2 = na
            for [j, candle] in candleSet.candles
                if candle.o_idx == setup.swept_candle_idx
                    htf_x1 := candle.wick_x
                if candle.o_idx == setup.htf_candle_idx
                    htf_x2 := candle.candle_right  // C2's right edge
            if not na(htf_x1) and not na(htf_x2)
                if settings.sweep_show
                    bin.lines.push(line.new(htf_x1, setup.sweep_price, htf_x2, setup.sweep_price, color = settings.sweep_color, style = sweep_line_style, width = settings.sweep_size))
        
        // ==== LAYER 5: CISD LINE (on top) - ALWAYS DRAW even if invalid ====
        if settings.cisd_show and setup.cisd_triggered and setup.has_cisd
            cisd_color = is_bull ? settings.cisd_bull_color : settings.cisd_bear_color
            bin.lines.push(line.new(setup.cisd_start_idx, setup.cisd_level, setup.cisd_end_idx + 1, setup.cisd_level, color = cisd_color, style = cisd_line_style, width = settings.cisd_width))
        
        // ==== LAYER 5b: IC-CISD (draw only after sweep-back-in / show, live) ====
        if settings.ic_cisd_show and setup.cisd_triggered and not na(setup.ic_list) and setup.ic_list.size() > 0
            for ic_j = 0 to setup.ic_list.size() - 1
                ICCisd ic_l = setup.ic_list.get(ic_j)
                color ic_col_l = ic_l.taken ? color.gray : (is_bull ? settings.cisd_bull_color : settings.cisd_bear_color)
                if not na(ic_l.level) and not na(ic_l.start_idx) and not na(ic_l.end_idx)
                    bin.lines.push(line.new(ic_l.start_idx, ic_l.level, ic_l.end_idx, ic_l.level, color = ic_col_l, style = cisd_line_style, width = settings.cisd_width))
                if psp_show_input and not na(ic_l.extreme_price) and not na(ic_l.extreme_idx)
                    ic_dot_style_l = is_bull ? label.style_label_up : label.style_label_down
                    color psp_col_l = ic_l.taken ? color.gray : (psp_use_cisd_color ? ic_col_l : psp_color_input)
                    bin.labels.push(label.new(ic_l.extreme_idx, ic_l.extreme_price, "●", color = color_transparent, textcolor = psp_col_l, style = ic_dot_style_l, size = settings.ic_dot_size))
        
        // ==== LAYER 6: SMT LINE - SKIP if invalid ====
        if not setup.is_invalid and smt_show_input and setup.has_smt and not na(setup.smt_x1) and not na(setup.smt_x2)
            smt_line_style = LineStyle(smt_line_style_input)
            // Draw line from prev high/low to current high/low
            bin.lines.push(line.new(setup.smt_x1, setup.smt_y1, setup.smt_x2, setup.smt_y2, 
                color = smt_color_input, style = smt_line_style, width = smt_line_width_input))
            // Draw label at midpoint
            if smt_label_show_input
                int mid_x = math.round((setup.smt_x1 + setup.smt_x2) / 2)
                float mid_y = (setup.smt_y1 + setup.smt_y2) / 2
                lbl_style_smt = is_bull ? label.style_label_up : label.style_label_down
                bin.labels.push(label.new(mid_x, mid_y, setup.smt_symbol, 
                    color = color_transparent, textcolor = smt_color_input, 
                    style = lbl_style_smt, size = LabelSize(smt_label_size_input)))
        
        // ==== LAYER 7: PREVIOUS EQ (chart) — after confirmed; C2 mid on C3, C3 mid on C4 ====
        if not setup.is_invalid and setup.is_confirmed and ShowChartEQ()
            eq_line_style_live = LineStyle(prev_eq_style)
            // C2 EQ across C3 window
            if not na(setup.c2_mid) and not na(setup.ez_c3_left_time)
                int eq3_right_live = EntryZoneRight(setup.ez_c3_right_time)
                if eq3_right_live > setup.ez_c3_left_time
                    bin.lines.push(line.new(setup.ez_c3_left_time, setup.c2_mid, eq3_right_live, setup.c2_mid,
                        xloc = xloc.bar_time, color = prev_eq_color, style = eq_line_style_live, width = prev_eq_width))
            // C3 EQ across C4 window — if C4 invalid: stop at that LTF bar, red
            if not na(setup.c3_mid) and not na(setup.ez_c4_left_time)
                int eq4_right_live = setup.ez_c4_invalid and not na(setup.ez_c4_invalid_time) ? setup.ez_c4_invalid_time : EntryZoneRight(setup.ez_c4_right_time)
                color eq4_col_live = setup.ez_c4_invalid ? color.red : prev_eq_color
                if eq4_right_live > setup.ez_c4_left_time
                    bin.lines.push(line.new(setup.ez_c4_left_time, setup.c3_mid, eq4_right_live, setup.c3_mid,
                        xloc = xloc.bar_time, color = eq4_col_live, style = eq_line_style_live, width = prev_eq_width))
        
        // ==== LAYER 7b: PREVIOUS EQ (HTF projection) — live ====
        if not setup.is_invalid and setup.is_confirmed and ShowHtfEQ() and not settings.hide_candles
            int c2_i_live = FindCandleIndex(candleSet.candles, setup.htf_candle_idx)
            eq_htf_style_live = LineStyle(prev_eq_style)
            if not na(setup.c2_mid) and c2_i_live > 0
                Candle c2_proj_l = candleSet.candles.get(c2_i_live)
                Candle c3_proj_l = candleSet.candles.get(c2_i_live - 1)
                int htf_eq3_x1_l = c2_proj_l.wick_x
                int htf_eq3_x2_l = c3_proj_l.candle_right + 2
                if htf_eq3_x2_l > htf_eq3_x1_l
                    bin.lines.push(line.new(htf_eq3_x1_l, setup.c2_mid, htf_eq3_x2_l, setup.c2_mid,
                        color = prev_eq_color, style = eq_htf_style_live, width = prev_eq_width))
            if not na(setup.c3_mid) and c2_i_live > 1
                Candle c3_proj4_l = candleSet.candles.get(c2_i_live - 1)
                Candle c4_proj_l = candleSet.candles.get(c2_i_live - 2)
                int htf_eq4_x1_l = c3_proj4_l.wick_x
                int htf_eq4_x2_l = c4_proj_l.candle_right + 2
                color htf_eq4_col_l = setup.ez_c4_invalid ? color.red : prev_eq_color
                if htf_eq4_x2_l > htf_eq4_x1_l
                    bin.lines.push(line.new(htf_eq4_x1_l, setup.c3_mid, htf_eq4_x2_l, setup.c3_mid,
                        color = htf_eq4_col_l, style = eq_htf_style_live, width = prev_eq_width))
        
        // ==== LAYER 8: ENTRY ZONE C3 - SKIP if invalid ====
        // Label: bearish = top-left of box (label_down), bullish = bottom-left (label_up) — same gap style as C2
        // Zone right edge develops with LTF bars (option A), then locks at C3 end
        if not setup.is_invalid and settings.entry_zone_show and setup.ez_c3_set and not na(setup.ez_c3_left_time)
            color ez_col_live = is_bull ? settings.entry_zone_bull_color : settings.entry_zone_bear_color
            int ez_right_live = EntryZoneRight(setup.ez_c3_right_time)
            bin.boxes.push(box.new(setup.ez_c3_left_time, setup.ez_c3_top, ez_right_live, setup.ez_c3_bot,
                xloc = xloc.bar_time, bgcolor = ez_col_live, border_color = color_transparent, border_width = 0))
            if settings.show_c3_lbl
                float ez_lbl_y_live = is_bull ? setup.ez_c3_bot : setup.ez_c3_top
                // One chart candle right of box left edge (same rule for C4 later)
                int ez_lbl_x_live = setup.ez_c3_left_time + timeframe.in_seconds() * 1000
                lbl_style_ez_live = is_bull ? label.style_label_up : label.style_label_down
                bin.labels.push(label.new(ez_lbl_x_live, ez_lbl_y_live, "C3", xloc = xloc.bar_time,
                    color = color_transparent, textcolor = settings.c2_color, style = lbl_style_ez_live, size = settings.c2_size))
        
    candleSet

method DrawAll(CandleSet candleSet, int offset) =>
    // Always calculate positions (needed for HTF sweep line drawing)
    candleSet.CalculatePositions(offset)
    
    // Always draw VT/HL lines (these are on the LTF chart, not the projection)
    candleSet.DrawVTHLLines()
    
    // When hiding projection, skip candles/labels/trace
    if not settings.hide_candles
        candleSet.DrawCandles()
        candleSet.DrawLabels(offset)
        candleSet.DrawTrace(offset)
    
    // Draw setups (projections, sweeps, CISD, liquidity) - skip if hide_setups enabled
    if not settings.hide_setups
        candleSet.DrawSetups()
    candleSet

// ============================================================================
// Main Execution
// ============================================================================

// Calculate on close setting - only affects live setup detection within HTF candle
// When a new HTF candle opens, Monitor() always runs to create the new candle
bool calculate_on_close = input.bool(true, 'Calculate on Close?', tooltip='When enabled, live setup detection only runs when LTF candles close (better performance). New HTF candle creation always runs immediately.', group = 'Performance')

// Session change detection for Quarterly mode (must be in main execution to modify global var)
string currentQuarterlySession = getCurrentQuarterlySession()
bool isNewQuarterlySession = currentQuarterlySession != prevQuarterlySession and currentQuarterlySession != ""
prevQuarterlySession := currentQuarterlySession

// Check if this is a new HTF candle (works for both timeframe-based and session-based modes)
bool isNewHTFCandle = isQuarterlyMode() ? isNewQuarterlySession : ta.change(time(htf.settings.htf)) > 0

// SMT Tracker updates - reset on new HTF candle, update high/low every bar
if isNewHTFCandle and smt_show_input
    // Store previous HTF candle values before resetting - CURRENT SYMBOL
    smt_tracker_curr.prev_h := smt_tracker_curr.h
    smt_tracker_curr.prev_l := smt_tracker_curr.l
    smt_tracker_curr.prev_h_idx := smt_tracker_curr.h_idx
    smt_tracker_curr.prev_l_idx := smt_tracker_curr.l_idx
    smt_tracker_curr.h := high
    smt_tracker_curr.l := low
    smt_tracker_curr.h_idx := bar_index
    smt_tracker_curr.l_idx := bar_index
    
    // COMPARISON SYMBOL 1
    smt_tracker1.prev_h := smt_tracker1.h
    smt_tracker1.prev_l := smt_tracker1.l
    smt_tracker1.prev_h_idx := smt_tracker1.h_idx
    smt_tracker1.prev_l_idx := smt_tracker1.l_idx
    smt_tracker1.h := smt_sym1_h
    smt_tracker1.l := smt_sym1_l
    smt_tracker1.h_idx := bar_index
    smt_tracker1.l_idx := bar_index
    
    // COMPARISON SYMBOL 2
    smt_tracker2.prev_h := smt_tracker2.h
    smt_tracker2.prev_l := smt_tracker2.l
    smt_tracker2.prev_h_idx := smt_tracker2.h_idx
    smt_tracker2.prev_l_idx := smt_tracker2.l_idx
    smt_tracker2.h := smt_sym2_h
    smt_tracker2.l := smt_sym2_l
    smt_tracker2.h_idx := bar_index
    smt_tracker2.l_idx := bar_index

// Update running highs/lows for all symbols (every bar)
if smt_show_input
    // Current symbol
    if high > smt_tracker_curr.h or na(smt_tracker_curr.h)
        smt_tracker_curr.h := high
        smt_tracker_curr.h_idx := bar_index
    if low < smt_tracker_curr.l or na(smt_tracker_curr.l)
        smt_tracker_curr.l := low
        smt_tracker_curr.l_idx := bar_index
    // Comparison symbol 1
    if not na(smt_sym1_h) and (smt_sym1_h > smt_tracker1.h or na(smt_tracker1.h))
        smt_tracker1.h := smt_sym1_h
        smt_tracker1.h_idx := bar_index
    if not na(smt_sym1_l) and (smt_sym1_l < smt_tracker1.l or na(smt_tracker1.l))
        smt_tracker1.l := smt_sym1_l
        smt_tracker1.l_idx := bar_index
    // Comparison symbol 2
    if not na(smt_sym2_h) and (smt_sym2_h > smt_tracker2.h or na(smt_tracker2.h))
        smt_tracker2.h := smt_sym2_h
        smt_tracker2.h_idx := bar_index
    if not na(smt_sym2_l) and (smt_sym2_l < smt_tracker2.l or na(smt_tracker2.l))
        smt_tracker2.l := smt_sym2_l
        smt_tracker2.l_idx := bar_index

// Determine if we should run Monitor:
// - Always run when new HTF candle opens (for HTF candle creation, vertical lines, etc.)
// - Otherwise, respect calculate_on_close setting
bool should_run_monitor = isNewHTFCandle or not calculate_on_close or barstate.isconfirmed

// Always clear bin first
bool valid_htf = ValidTimeframe(htf.settings.htf)
bin.clear()

// Data collection
int offset = settings.offset
if valid_htf
    // Monitor - runs on new HTF candle, or per calculate_on_close setting (pass isNewHTFCandle)
    if should_run_monitor
        htf.Monitor(isNewHTFCandle)
    // HTF candle updates - always run every tick
    htf.Update()

// Drawing (only on last bar)
if barstate.islast or barstate.isrealtime
    if valid_htf
        htf.DrawAll(offset)

// ============================================================================
// BPI EXTENSIONS — everything below is added on top of the Raptor fractal model:
//   1) HTF 2 / HTF 3 candle blocks + Daily HTF candle (right of the model's HTF block)
//   2) Key Levels (Midnight / 8:30 Open, PDH/PDL, Asia & London H/L)
//   3) ICT HTF FVGs (fadi)
// ============================================================================

//#region [BPI HELPERS]
noColor = color.new(#000000, 100)

tfLabel(string tf) =>
    switch tf
        '1'   => '1m'
        '2'   => '2m'
        '3'   => '3m'
        '5'   => '5m'
        '15'  => '15m'
        '30'  => '30m'
        '60'  => '1H'
        '90'  => '90m'
        '240' => '4H'
        '360' => '6H'
        '1D'  => '1D'
        'D'   => '1D'
        '1W'  => '1W'
        'W'   => '1W'
        '1M'  => '1M'
        '3M'  => '3M'
        '6M'  => '6M'
        '12M' => '12M'
        =>       tf + 'm'

tfMins(string tf) =>
    switch tf
        '1D'  => 1440
        'D'   => 1440
        '1W'  => 10080
        'W'   => 10080
        '1M'  => 43200
        'M'   => 43200
        '3M'  => 129600
        '6M'  => 259200
        '12M' => 518400
        =>       int(str.tonumber(tf))

lineStyleFromStr(string s) =>
    switch s
        'Solid'  => line.style_solid
        'Dashed' => line.style_dashed
        'Dotted' => line.style_dotted
        =>          line.style_dashed

textSize(string s) =>
    switch s
        'Tiny'   => size.tiny
        'Small'  => size.small
        'Normal' => size.normal
        'Large'  => size.large
        =>          size.huge

pad2(int v) =>
    v < 10 ? '0' + str.tostring(v) : str.tostring(v)

formatRemaining(int ms, bool forceHours) =>
    totalSec = int(math.max(ms, 0) / 1000)
    dd = int(totalSec / 86400)
    hh = int((totalSec % 86400) / 3600)
    mm = int((totalSec % 3600) / 60)
    ss = int(totalSec % 60)
    if forceHours and dd > 0
        str.tostring(dd) + 'D ' + pad2(hh) + ':' + pad2(mm) + ':' + pad2(ss)
    else if forceHours
        pad2(hh) + ':' + pad2(mm) + ':' + pad2(ss)
    else
        pad2(mm) + ':' + pad2(ss)
//#endregion

//#region [HTF 2 / HTF 3 / DAILY CANDLES]
grpExtHtf      = group_htf
htfCandleCount = input.int(5, 'HTF 2/3 Candles', minval = 1, maxval = 10, group = grpExtHtf, inline = 'count')
hideHtf        = input.bool(false, 'Hide HTF 2/3?', group = grpExtHtf, inline = 'count', tooltip = 'Hide the HTF 2 / HTF 3 blocks and the Daily candle')
showHtf2       = input.bool(true, 'Show HTF 2', group = grpExtHtf, inline = 'extrahtf')
showHtf3       = input.bool(true, 'Show HTF 3', group = grpExtHtf, inline = 'extrahtf', tooltip = 'Extra HTF candle blocks drawn to the right of the fractal model\'s HTF block. Timeframes are picked automatically from the chart timeframe. They follow "Offset HTF Candles".')
extBlockGap    = input.int(2, 'Gap between blocks', minval = 0, maxval = 30, group = grpExtHtf, inline = 'extgap', tooltip = 'Bars of space between the HTF 1, HTF 2, HTF 3 and Daily blocks.')

bullBody   = input.color(color.rgb(165, 214, 167), 'HTF 2/3 Body', group = grpExtHtf, inline = 'body2')
bearBody   = input.color(color.rgb(46, 46, 46), '', group = grpExtHtf, inline = 'body2')
borderBull = input.color(color.rgb(46, 46, 46), 'HTF 2/3 Borders', group = grpExtHtf, inline = 'border2')
borderBear = input.color(color.rgb(46, 46, 46), '', group = grpExtHtf, inline = 'border2')
wickBull   = input.color(color.rgb(46, 46, 46), 'HTF 2/3 Wick', group = grpExtHtf, inline = 'wick2')
wickBear   = input.color(color.rgb(46, 46, 46), '', group = grpExtHtf, inline = 'wick2')

showHtfTf     = input.bool(true, 'HTF 2/3 Info', group = grpExtHtf, inline = 'htfinfo', tooltip = 'Shows the higher timeframe label and/or a countdown to the close of the live HTF candle, centered above each block.')
showHtfTimer  = input.bool(true, 'Countdown', group = grpExtHtf, inline = 'htfinfo')
showHtfStamps = input.bool(false, 'Time Stamps', group = grpExtHtf, inline = 'htfinfo', tooltip = 'Shows the open time (or day name for daily+ candles) under each individual HTF candle.')
htfInfoColor  = input.color(color.new(#1a1a1a, 0), '', group = grpExtHtf, inline = 'htfinfo')
labelSize     = input.string('Small', 'HTF 2/3 Label Size', options = ['Tiny', 'Small', 'Normal', 'Large', 'Huge'], group = grpExtHtf, inline = 'lblsize')

grpDaily         = 'HTF Daily Candle'
showDaily        = input.bool(true, 'Show Daily Candle', group = grpDaily, inline = 'daily', tooltip = 'Draws the live candle of the selected period as a single wide candle to the right of the HTF blocks.')
dailyTf          = input.timeframe('1D', '', group = grpDaily, inline = 'daily')
dailyWidth       = input.int(6, 'Body Width', minval = 2, maxval = 20, group = grpDaily, inline = 'dailyw')
dailyGap         = input.int(2, 'Gap', minval = 0, maxval = 30, group = grpDaily, inline = 'dailyw', tooltip = 'Extra bars of space between the last HTF block and the daily candle.')
showDailyOpenLn  = input.bool(true, 'Open Line', group = grpDaily, inline = 'dailyopen', tooltip = 'Dotted line from the period open back on the chart out to the daily candle.')
dailyOpenColor   = input.color(color.new(color.gray, 30), '', group = grpDaily, inline = 'dailyopen')
showDailyLevels  = input.bool(true, 'H/O/L Labels', group = grpDaily, inline = 'dailylbl', tooltip = 'Dotted stubs from the daily candle with text-only price labels for the period High, Open and Low.')
dailyLabelColor  = input.color(#4e5057, '', group = grpDaily, inline = 'dailylbl')
dailyLabelSize   = input.string('Small', '', options = ['Tiny', 'Small', 'Normal', 'Large', 'Huge'], group = grpDaily, inline = 'dailylbl')

// Geometry shared with the model's HTF block
// Geometry: our blocks use a fixed 3-bar candle (as before); HTF 1 geometry comes from the model
int extCandleW   = 2
int extSpacing   = 3
int extCount     = htfCandleCount
bool extHideAll  = hideHtf
int htf1CandleW  = settings.width
int htf1Spacing  = settings.width + 1
int htf1Count    = htf.settings.max_display

type HtfCandle
    float o
    float h
    float l
    float c
    int   hBar
    int   lBar
    box   body
    line  wickUp
    line  wickDown
    int   midX
    int   openTime = na
    label timeLbl  = na

var array<HtfCandle> htf2Candles = array.new<HtfCandle>()
var array<HtfCandle> htf3Candles = array.new<HtfCandle>()
var label htf2InfoLbl = na
var label htf3InfoLbl = na

var float dailyO       = na
var float dailyH       = na
var float dailyL       = na
var float dailyC       = na
var int   dailyFromBar = na
var box   dailyBody    = na
var line  dailyWick    = na
var line  dailyOpenLn  = na
var label dailyInfoLbl = na
var array<line>  dailyLvlLines  = array.new<line>()
var array<label> dailyLvlLabels = array.new<label>()

method delete(HtfCandle c) =>
    box.delete(c.body)
    line.delete(c.wickUp)
    line.delete(c.wickDown)
    if not na(c.timeLbl)
        label.delete(c.timeLbl)

method update(HtfCandle c, float curH, float curL, float curC, int curBar) =>
    if curH > c.h
        c.h    := curH
        c.hBar := curBar
    if curL < c.l
        c.l    := curL
        c.lBar := curBar
    c.c := curC
    c

method draw(HtfCandle c, int leftBar, string tf) =>
    bool  isBull = c.c >= c.o
    int   midX   = leftBar + int(extCandleW / 2)
    box.set_left(c.body, leftBar)
    box.set_right(c.body, leftBar + extCandleW)
    box.set_top(c.body, math.max(c.o, c.c))
    box.set_bottom(c.body, math.min(c.o, c.c))
    box.set_bgcolor(c.body, isBull ? bullBody : bearBody)
    box.set_border_color(c.body, isBull ? borderBull : borderBear)
    line.set_xy1(c.wickUp, midX, c.h)
    line.set_xy2(c.wickUp, midX, math.max(c.o, c.c))
    line.set_color(c.wickUp, isBull ? wickBull : wickBear)
    line.set_xy1(c.wickDown, midX, c.l)
    line.set_xy2(c.wickDown, midX, math.min(c.o, c.c))
    line.set_color(c.wickDown, isBull ? wickBull : wickBear)
    c.midX := midX

    string timeText = ''
    if timeframe.in_seconds(tf) >= timeframe.in_seconds('1D')
        int labelTime = c.openTime + 12 * 60 * 60 * 1000
        timeText := str.upper(str.format_time(labelTime, 'EEE', 'America/New_York'))
    else
        timeText := str.format_time(c.openTime, 'HH:mm', 'America/New_York')

    if showHtfStamps
        if na(c.timeLbl)
            c.timeLbl := label.new(midX, c.l, timeText, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_up, color = na, textcolor = htfInfoColor, size = textSize(labelSize), text_font_family = font.family_default)
        else
            label.set_xy(c.timeLbl, midX, c.l)
            label.set_text(c.timeLbl, timeText)
            label.set_textcolor(c.timeLbl, htfInfoColor)
            label.set_size(c.timeLbl, textSize(labelSize))
    else if not na(c.timeLbl)
        label.delete(c.timeLbl)
        c.timeLbl := na
    c

newHtfCandle() =>
    HtfCandle.new(open, high, low, close, bar_index, bar_index,
         box.new(bar_index, high, bar_index, low, border_color = borderBull, border_width = 1),
         line.new(bar_index, high, bar_index, high, color = wickBull),
         line.new(bar_index, low, bar_index, low, color = wickBull),
         na, openTime = time)

getExtraHTFs() =>
    string tf2 = na
    string tf3 = na
    switch timeframe.period
        '1'  =>
            tf2 := '30'
            tf3 := '60'
        '2'  =>
            tf2 := '30'
            tf3 := '60'
        '3'  =>
            tf2 := '60'
            tf3 := '240'
        '5'  =>
            tf2 := '240'
            tf3 := '1D'
        '15' =>
            tf2 := '360'
            tf3 := '1D'
        '30' =>
            tf2 := '1D'
            tf3 := '1W'
        '60' =>
            tf2 := '1W'
            tf3 := '1M'
        '240' =>
            tf2 := '1M'
            tf3 := '3M'
        '1D' =>
            tf2 := '3M'
            tf3 := na
        =>
            tf2 := na
            tf3 := na
    [tf2, tf3]

manageExtraHTF(array<HtfCandle> candles, string tf, int maxCount) =>
    if na(tf)
        candles
    else
        bool changed = time(tf) != time(tf)[1]
        if changed
            candles.unshift(newHtfCandle())
            while candles.size() > maxCount
                candles.pop().delete()
        else if candles.size() > 0
            candles.set(0, candles.first().update(high, low, close, bar_index))
        candles

// Draw one extra HTF block; returns its info label
drawExtBlock(array<HtfCandle> candles, string tf, int startRel, label infoLbl) =>
    label lbl = infoLbl
    int n = candles.size()
    for i = n - 1 to 0
        candles.get(i).draw(bar_index + startRel + extSpacing * (n - 1 - i), tf)
    float blockHigh = candles.get(0).h
    for i = 1 to n - 1
        blockHigh := math.max(blockHigh, candles.get(i).h)
    int center = bar_index + startRel + int(extSpacing * (n - 1) / 2) + int(extCandleW / 2)
    string infoText = showHtfTf ? tfLabel(tf) : ''
    if showHtfTimer
        int remMs = time_close(tf) - (barstate.isrealtime ? timenow : time_close)
        infoText := infoText + '\n(' + formatRemaining(remMs, tfMins(tf) >= 60) + ')'
    if (showHtfTf or showHtfTimer)
        if na(lbl)
            lbl := label.new(center, blockHigh, infoText, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_down, color = na, textcolor = htfInfoColor, size = textSize(labelSize), text_font_family = font.family_default)
        else
            label.set_xy(lbl, center, blockHigh)
            label.set_text(lbl, infoText)
            label.set_textcolor(lbl, htfInfoColor)
    else if not na(lbl)
        label.delete(lbl)
        lbl := na
    lbl

clearExtBlock(array<HtfCandle> candles, label infoLbl) =>
    while candles.size() > 0
        candles.pop().delete()
    if not na(infoLbl)
        label.delete(infoLbl)
    label(na)

// --- data ---
[htf2Tf, htf3Tf] = getExtraHTFs()

bool dailyNewPeriod = time(dailyTf) != time(dailyTf)[1]
if showDaily
    if dailyNewPeriod or na(dailyO)
        dailyO       := open
        dailyH       := high
        dailyL       := low
        dailyFromBar := bar_index
    else
        dailyH := math.max(dailyH, high)
        dailyL := math.min(dailyL, low)
    dailyC := close

if showHtf2 and not extHideAll
    htf2Candles := manageExtraHTF(htf2Candles, htf2Tf, extCount)
if showHtf3 and not extHideAll
    htf3Candles := manageExtraHTF(htf3Candles, htf3Tf, extCount)

// --- drawing (last bar) ---
if barstate.islast or barstate.isrealtime
    // Right edge of the model's HTF 1 block, relative to bar_index
    int htf1Right = settings.offset + htf1Spacing * (htf1Count - 1) + htf1CandleW
    int htf2Start = htf1Right + 1 + extBlockGap
    int nextStart = htf2Start

    bool draw2 = showHtf2 and not extHideAll and not na(htf2Tf) and htf2Candles.size() > 0
    if draw2
        htf2InfoLbl := drawExtBlock(htf2Candles, htf2Tf, htf2Start, htf2InfoLbl)
        nextStart := htf2Start + extSpacing * (extCount - 1) + extCandleW + 1 + extBlockGap
    else
        htf2InfoLbl := clearExtBlock(htf2Candles, htf2InfoLbl)

    bool draw3 = showHtf3 and not extHideAll and not na(htf3Tf) and htf3Candles.size() > 0
    int htf3Start = nextStart
    if draw3
        htf3InfoLbl := drawExtBlock(htf3Candles, htf3Tf, htf3Start, htf3InfoLbl)
        nextStart := htf3Start + extSpacing * (extCount - 1) + extCandleW + 1 + extBlockGap
    else
        htf3InfoLbl := clearExtBlock(htf3Candles, htf3InfoLbl)

    int dailyLeft  = bar_index + nextStart + dailyGap
    int dailyRight = dailyLeft + dailyWidth
    int dailyMid   = dailyLeft + int(dailyWidth / 2)

    if showDaily and not extHideAll and not na(dailyO)
        bool  dBull  = dailyC >= dailyO
        color dBody  = dBull ? bullBody : bearBody
        color dBord  = dBull ? borderBull : borderBear
        color dWick  = dBull ? wickBull : wickBear
        float dTop   = math.max(dailyO, dailyC)
        float dBot   = math.min(dailyO, dailyC)
        if na(dailyBody)
            dailyBody := box.new(dailyLeft, dTop, dailyRight, dBot, dBord, 1, bgcolor = dBody, xloc = xloc.bar_index)
            dailyWick := line.new(dailyMid, dailyH, dailyMid, dailyL, xloc.bar_index, extend.none, dWick)
        else
            box.set_lefttop(dailyBody, dailyLeft, dTop)
            box.set_rightbottom(dailyBody, dailyRight, dBot)
            box.set_bgcolor(dailyBody, dBody)
            box.set_border_color(dailyBody, dBord)
            line.set_xy1(dailyWick, dailyMid, dailyH)
            line.set_xy2(dailyWick, dailyMid, dailyL)
            line.set_color(dailyWick, dWick)

        if showDailyOpenLn
            if na(dailyOpenLn)
                dailyOpenLn := line.new(dailyFromBar, dailyO, dailyLeft, dailyO, xloc.bar_index, extend.none, dailyOpenColor, line.style_dotted)
            else
                line.set_xy1(dailyOpenLn, dailyFromBar, dailyO)
                line.set_xy2(dailyOpenLn, dailyLeft, dailyO)
                line.set_color(dailyOpenLn, dailyOpenColor)
        else if not na(dailyOpenLn)
            line.delete(dailyOpenLn)
            dailyOpenLn := na

        string dailyInfoText = showHtfTf ? tfLabel(dailyTf) : ''
        if showHtfTimer
            int dailyRemainingMs = time_close(dailyTf) - (barstate.isrealtime ? timenow : time_close)
            dailyInfoText := dailyInfoText + '\n(' + formatRemaining(dailyRemainingMs, tfMins(dailyTf) >= 60) + ')'
        if (showHtfTf or showHtfTimer)
            if na(dailyInfoLbl)
                dailyInfoLbl := label.new(dailyMid, dailyH, dailyInfoText, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_down, color = na, textcolor = htfInfoColor, size = textSize(labelSize), text_font_family = font.family_default)
            else
                label.set_xy(dailyInfoLbl, dailyMid, dailyH)
                label.set_text(dailyInfoLbl, dailyInfoText)
                label.set_textcolor(dailyInfoLbl, htfInfoColor)
        else if not na(dailyInfoLbl)
            label.delete(dailyInfoLbl)
            dailyInfoLbl := na

        if showDailyLevels
            int dailyLblX = dailyRight + 3
            array<float>  lvlPrices = array.from(dailyH, dailyO, dailyL)
            array<string> lvlNames  = array.from('D.High', 'D.Open', 'D.Low')
            for i = 0 to 2
                float  p   = lvlPrices.get(i)
                string txt = lvlNames.get(i) + ' ' + str.tostring(p, format.mintick)
                if dailyLvlLines.size() <= i
                    dailyLvlLines.push(line.new(dailyMid, p, dailyLblX, p, xloc.bar_index, extend.none, dailyLabelColor, line.style_dotted))
                    dailyLvlLabels.push(label.new(dailyLblX, p, txt, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = na, textcolor = dailyLabelColor, size = textSize(dailyLabelSize), text_font_family = font.family_monospace))
                else
                    line ln = dailyLvlLines.get(i)
                    line.set_xy1(ln, dailyMid, p)
                    line.set_xy2(ln, dailyLblX, p)
                    line.set_color(ln, dailyLabelColor)
                    label lb = dailyLvlLabels.get(i)
                    label.set_xy(lb, dailyLblX, p)
                    label.set_text(lb, txt)
                    label.set_textcolor(lb, dailyLabelColor)
                    label.set_size(lb, textSize(dailyLabelSize))
        else
            while dailyLvlLines.size() > 0
                line.delete(dailyLvlLines.pop())
            while dailyLvlLabels.size() > 0
                label.delete(dailyLvlLabels.pop())
    else
        if not na(dailyBody)
            box.delete(dailyBody)
            dailyBody := na
        if not na(dailyWick)
            line.delete(dailyWick)
            dailyWick := na
        if not na(dailyOpenLn)
            line.delete(dailyOpenLn)
            dailyOpenLn := na
        if not na(dailyInfoLbl)
            label.delete(dailyInfoLbl)
            dailyInfoLbl := na
        while dailyLvlLines.size() > 0
            line.delete(dailyLvlLines.pop())
        while dailyLvlLabels.size() > 0
            label.delete(dailyLvlLabels.pop())
//#endregion

//#region [KEY LEVELS — Midnight Open, 8:30 Open, PDH/PDL]
// Ported from the previous BPI_Indicator.pine. Dotted line extended past the last bar
// with a text-only monospace label at the right end (BSL/SSL style).

grpKeyLvls        = 'Key Levels'
kl_showMidnight   = input.bool(true, 'Midnight Open (00:00 ET)', group = grpKeyLvls, inline = 'klmid')
kl_midnightColor  = input.color(#4e5057, '', group = grpKeyLvls, inline = 'klmid')
kl_midnightText   = input.string('Midnight', '', group = grpKeyLvls, inline = 'klmid')
kl_midnightBold   = input.bool(true, 'Bold', group = grpKeyLvls, inline = 'klmid', tooltip = 'Bold: thicker line (Line width + 1) and bold label text.')
kl_show830        = input.bool(true, '8:30 Open (ET)', group = grpKeyLvls, inline = 'kl830')
kl_830Color       = input.color(#4e5057, '', group = grpKeyLvls, inline = 'kl830')
kl_830Text        = input.string('8:30', '', group = grpKeyLvls, inline = 'kl830')
kl_830Bold        = input.bool(true, 'Bold', group = grpKeyLvls, inline = 'kl830')
kl_showPdh        = input.bool(true, 'Previous Day High', group = grpKeyLvls, inline = 'klpdh')
kl_pdhColor       = input.color(#4e5057, '', group = grpKeyLvls, inline = 'klpdh')
kl_pdhText        = input.string('PDH', '', group = grpKeyLvls, inline = 'klpdh')
kl_showPdl        = input.bool(true, 'Previous Day Low', group = grpKeyLvls, inline = 'klpdl')
kl_pdlColor       = input.color(#4e5057, '', group = grpKeyLvls, inline = 'klpdl')
kl_pdlText        = input.string('PDL', '', group = grpKeyLvls, inline = 'klpdl')
kl_lineStyle      = input.string('Dotted', 'Line', options = ['Solid', 'Dashed', 'Dotted'], group = grpKeyLvls, inline = 'klstyle')
kl_lineWidth      = input.int(1, '', minval = 1, maxval = 4, group = grpKeyLvls, inline = 'klstyle')
kl_extend         = input.int(10, 'Extend (bars)', minval = 0, maxval = 100, group = grpKeyLvls, inline = 'klstyle', tooltip = 'How far past the last bar the level lines are extended before the label.')
kl_showAsia       = input.bool(true, 'Asia High/Low', group = grpKeyLvls, inline = 'klasia')
kl_asiaColor      = input.color(#4e5057, '', group = grpKeyLvls, inline = 'klasia')
kl_asiaHighText   = input.string('A.High', '', group = grpKeyLvls, inline = 'klasia')
kl_asiaLowText    = input.string('A.Low', '', group = grpKeyLvls, inline = 'klasia')
kl_asiaSession    = input.session('2000-0000', 'Asia Session (ET)', group = grpKeyLvls, inline = 'klasia2')
kl_showLondon     = input.bool(true, 'London High/Low', group = grpKeyLvls, inline = 'klldn')
kl_londonColor    = input.color(#4e5057, '', group = grpKeyLvls, inline = 'klldn')
kl_londonHighText = input.string('L.High', '', group = grpKeyLvls, inline = 'klldn')
kl_londonLowText  = input.string('L.Low', '', group = grpKeyLvls, inline = 'klldn')
kl_londonSession  = input.session('0200-0500', 'London Session (ET)', group = grpKeyLvls, inline = 'klldn2', tooltip = 'Session highs/lows update while the session runs, then extend right until price takes them out (high: wick >= level, low: wick <= level). The line stops at the takeout bar.')
kl_showLabels     = input.bool(true, 'Labels', group = grpKeyLvls, inline = 'kllbl')
kl_labelSize      = input.string('Small', '', options = ['Tiny', 'Small', 'Normal', 'Large', 'Huge'], group = grpKeyLvls, inline = 'kllbl')

type KeyLevel
    float price    = na
    int   startBar = na
    int   takenBar = na
    line  ln       = na
    label lbl      = na

method reset(KeyLevel k) =>
    if not na(k.ln)
        line.delete(k.ln)
        k.ln := na
    if not na(k.lbl)
        label.delete(k.lbl)
        k.lbl := na
    k.price    := na
    k.startBar := na
    k.takenBar := na

method render(KeyLevel k, bool show, color clr, string txt, bool bold = false) =>
    bool showLine = show and not na(k.price)
    bool showLbl  = showLine and kl_showLabels
    int  x2       = na(k.takenBar) ? bar_index + kl_extend : k.takenBar
    int  lnWidth  = bold ? kl_lineWidth + 1 : kl_lineWidth
    if not showLine and not na(k.ln)
        line.delete(k.ln)
        k.ln := na
    if not showLbl and not na(k.lbl)
        label.delete(k.lbl)
        k.lbl := na
    if showLine
        if na(k.ln)
            k.ln := line.new(k.startBar, k.price, x2, k.price, xloc.bar_index, extend.none, clr, lineStyleFromStr(kl_lineStyle), lnWidth)
        line.set_xy1(k.ln, k.startBar, k.price)
        line.set_xy2(k.ln, x2, k.price)
        line.set_color(k.ln, clr)
        line.set_style(k.ln, lineStyleFromStr(kl_lineStyle))
        line.set_width(k.ln, lnWidth)
    if showLbl
        if na(k.lbl)
            k.lbl := label.new(x2, k.price, txt, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = na, textcolor = clr, size = textSize(kl_labelSize), text_font_family = font.family_monospace, text_formatting = bold ? text.format_bold : text.format_none)
        label.set_xy(k.lbl, x2, k.price)
        label.set_text(k.lbl, txt)
        label.set_textcolor(k.lbl, clr)
        label.set_size(k.lbl, textSize(kl_labelSize))
        label.set_text_formatting(k.lbl, bold ? text.format_bold : text.format_none)

var KeyLevel kl_midnight = KeyLevel.new()
var KeyLevel kl_830      = KeyLevel.new()
var KeyLevel kl_pdh      = KeyLevel.new()
var KeyLevel kl_pdl      = KeyLevel.new()

// First bar inside a narrow window at 00:00 / 08:30 New York time
int kl_midnightSess = time(timeframe.period, '0000-0002', 'America/New_York')
int kl_830Sess      = time(timeframe.period, '0830-0832', 'America/New_York')
bool kl_isMidnight  = not na(kl_midnightSess) and na(kl_midnightSess[1])
bool kl_is830       = not na(kl_830Sess) and na(kl_830Sess[1])

if kl_isMidnight
    kl_midnight.reset()
    kl_midnight.price    := open
    kl_midnight.startBar := bar_index
if kl_is830
    kl_830.reset()
    kl_830.price    := open
    kl_830.startBar := bar_index

// Running current-day H/L, snapshotted to PDH/PDL at each new day
var float kl_curDayHigh     = na
var float kl_curDayLow      = na
var int   kl_curDayStartBar = na
bool kl_isNewDay = ta.change(time('D')) != 0

if kl_isNewDay
    if not na(kl_curDayHigh)
        kl_pdh.reset()
        kl_pdh.price    := kl_curDayHigh
        kl_pdh.startBar := kl_curDayStartBar
        kl_pdl.reset()
        kl_pdl.price    := kl_curDayLow
        kl_pdl.startBar := kl_curDayStartBar
    kl_curDayHigh     := high
    kl_curDayLow      := low
    kl_curDayStartBar := bar_index
else
    kl_curDayHigh     := na(kl_curDayHigh) ? high : math.max(kl_curDayHigh, high)
    kl_curDayLow      := na(kl_curDayLow)  ? low  : math.min(kl_curDayLow, low)
    kl_curDayStartBar := na(kl_curDayStartBar) ? bar_index : kl_curDayStartBar

// --- Asia / London session highs & lows (ported from the original indicator) ---
var KeyLevel kl_asiaHigh   = KeyLevel.new()
var KeyLevel kl_asiaLow    = KeyLevel.new()
var KeyLevel kl_londonHigh = KeyLevel.new()
var KeyLevel kl_londonLow  = KeyLevel.new()

// Session start: init both levels from this bar. In session: track new extremes.
// After session: first wick through a level marks it taken and freezes the line there.
updateSessionLevels(KeyLevel hi, KeyLevel lo, bool inSess, bool sessStart) =>
    if sessStart
        hi.reset()
        lo.reset()
        hi.price    := high
        hi.startBar := bar_index
        lo.price    := low
        lo.startBar := bar_index
    else if inSess
        if high > hi.price
            hi.price    := high
            hi.startBar := bar_index
        if low < lo.price
            lo.price    := low
            lo.startBar := bar_index
    else
        if not na(hi.price) and na(hi.takenBar) and high >= hi.price
            hi.takenBar := bar_index
        if not na(lo.price) and na(lo.takenBar) and low <= lo.price
            lo.takenBar := bar_index

bool kl_inAsia   = not na(time(timeframe.period, kl_asiaSession, 'America/New_York'))
bool kl_inLondon = not na(time(timeframe.period, kl_londonSession, 'America/New_York'))
bool kl_asiaStart   = kl_inAsia and not kl_inAsia[1]
bool kl_londonStart = kl_inLondon and not kl_inLondon[1]
if kl_showAsia
    updateSessionLevels(kl_asiaHigh, kl_asiaLow, kl_inAsia, kl_asiaStart)
if kl_showLondon
    updateSessionLevels(kl_londonHigh, kl_londonLow, kl_inLondon, kl_londonStart)

if barstate.islast
    kl_midnight.render(kl_showMidnight, kl_midnightColor, kl_midnightText, kl_midnightBold)
    kl_830.render(kl_show830, kl_830Color, kl_830Text, kl_830Bold)
    kl_pdh.render(kl_showPdh, kl_pdhColor, kl_pdhText)
    kl_pdl.render(kl_showPdl, kl_pdlColor, kl_pdlText)
    kl_asiaHigh.render(kl_showAsia, kl_asiaColor, kl_asiaHighText)
    kl_asiaLow.render(kl_showAsia, kl_asiaColor, kl_asiaLowText)
    kl_londonHigh.render(kl_showLondon, kl_londonColor, kl_londonHighText)
    kl_londonLow.render(kl_showLondon, kl_londonColor, kl_londonLowText)
//#endregion

//#region [HTF FVG (ICT) — fadi]


//+------------------------------------------------------------------------------------------------------------+//
//+--- ICT HTF FVGs (fadi)                                                                                  ---+//
//+------------------------------------------------------------------------------------------------------------+//
// Ported (behavior-preserving) from the standalone "ICT HTF FVGs (fadi)" indicator.
// © fadizeidan — licensed under the Mozilla Public License 2.0 (https://mozilla.org/MPL/2.0/).
// All identifiers namespaced with `hfvg_` to avoid collisions with the host BPI script.
// Renders up to 6 configurable HTF fair-value gaps as boxes/labels/CE lines to the right of
// price, with mitigation handling. Independent of the BPI HTF-candle engine (does not feed models).

//+--- Types ---+//
type hfvg_Settings
    bool   CE_show
    string CE_style
    color  CE_color
    bool   Border_show
    bool   mitigated_show
    string mitigated_type
    color  mitigated_color_bull
    color  mitigated_color_bear
    bool   ltf_hide
    bool   label_show
    color  label_color
    color  label_bgcolor
    string label_size
    int    padding
    int    buffer

type hfvg_Imbalance_Settings
    bool   show
    string htf
    color  color_bull
    color  color_bear
    int    max_count

type hfvg_Imbalance
    int   open_time
    int   close_time
    float open
    float middle
    float close
    bool  mitigated
    int   mitigated_time
    line  line_middle
    label lbl
    box   box

type hfvg_ImbalanceStructure
    hfvg_Imbalance[]        imbalance
    hfvg_Imbalance_Settings settings

type hfvg_Helper
    string name = "Helper"

//+--- Settings ---+//
var hfvg_GRP = "HTF FVG (ICT)"

hfvg_Settings          hfvg_settings        = hfvg_Settings.new()
hfvg_Imbalance_Settings hfvg_HTF_1_Settings = hfvg_Imbalance_Settings.new()
hfvg_Imbalance_Settings hfvg_HTF_2_Settings = hfvg_Imbalance_Settings.new()
hfvg_Imbalance_Settings hfvg_HTF_3_Settings = hfvg_Imbalance_Settings.new()
hfvg_Imbalance_Settings hfvg_HTF_4_Settings = hfvg_Imbalance_Settings.new()
hfvg_Imbalance_Settings hfvg_HTF_5_Settings = hfvg_Imbalance_Settings.new()
hfvg_Imbalance_Settings hfvg_HTF_6_Settings = hfvg_Imbalance_Settings.new()

string hfvg_tooltip1 = "HTF FVG Settings:\n\tShow/Hide timeframe\n\tTimeframe to display\n\tBullish FVG Color\n\tBearish FVG Color\n\tMaximum number of FVGs to display"
string hfvg_tooltip2 = "Mitigated FVG Settings:\n\tShow/Hide mitigated (Applies to all).\n\tBullish FVG Color\n\tBearish FVG Color\n\tWhen to mark it as mitigated (Based on HTF timeframe, not current timeframe)"

hfvg_HTF_1_Settings.show       := input.bool(false, "", inline="htf1", group=hfvg_GRP)
