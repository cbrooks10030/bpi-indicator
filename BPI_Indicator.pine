hfvg_HTF_2_Settings.color_bull := input.color(color.new(color.green,90), "", inline="htf2", group=hfvg_GRP)
hfvg_HTF_2_Settings.color_bear := input.color(color.new(color.blue,90), "", inline="htf2", group=hfvg_GRP)
hfvg_HTF_2_Settings.max_count  := input.int(2, "", inline="htf2", group=hfvg_GRP, tooltip = hfvg_tooltip1)

hfvg_HTF_3_Settings.show       := input.bool(true, "", inline="htf3", group=hfvg_GRP)
hfvg_htf_3                      = input.timeframe("60", "", inline="htf3", group=hfvg_GRP)
hfvg_HTF_3_Settings.htf        := hfvg_htf_3
hfvg_HTF_3_Settings.color_bull := input.color(color.new(color.green,90), "", inline="htf3", group=hfvg_GRP)
hfvg_HTF_3_Settings.color_bear := input.color(color.new(color.blue,90), "", inline="htf3", group=hfvg_GRP)
hfvg_HTF_3_Settings.max_count  := input.int(2, "", inline="htf3", group=hfvg_GRP, tooltip = hfvg_tooltip1)

hfvg_HTF_4_Settings.show       := input.bool(false, "", inline="htf4", group=hfvg_GRP)
hfvg_htf_4                      = input.timeframe("240", "", inline="htf4", group=hfvg_GRP)
hfvg_HTF_4_Settings.htf        := hfvg_htf_4
hfvg_HTF_4_Settings.color_bull := input.color(color.new(color.green,90), "", inline="htf4", group=hfvg_GRP)
hfvg_HTF_4_Settings.color_bear := input.color(color.new(color.blue,90), "", inline="htf4", group=hfvg_GRP)
hfvg_HTF_4_Settings.max_count  := input.int(10, "", inline="htf4", group=hfvg_GRP, tooltip = hfvg_tooltip1)

hfvg_HTF_5_Settings.show       := input.bool(false, "", inline="htf5", group=hfvg_GRP)
hfvg_htf_5                      = input.timeframe("1D", "", inline="htf5", group=hfvg_GRP)
hfvg_HTF_5_Settings.htf        := hfvg_htf_5
hfvg_HTF_5_Settings.color_bull := input.color(color.new(color.green,90), "", inline="htf5", group=hfvg_GRP)
hfvg_HTF_5_Settings.color_bear := input.color(color.new(color.blue,90), "", inline="htf5", group=hfvg_GRP)
hfvg_HTF_5_Settings.max_count  := input.int(10, "", inline="htf5", group=hfvg_GRP, tooltip = hfvg_tooltip1)

hfvg_HTF_6_Settings.show       := input.bool(false, "", inline="htf6", group=hfvg_GRP)
hfvg_htf_6                      = input.timeframe("1W", "", inline="htf6", group=hfvg_GRP)
hfvg_HTF_6_Settings.htf        := hfvg_htf_6
hfvg_HTF_6_Settings.color_bull := input.color(color.new(color.green,90), "", inline="htf6", group=hfvg_GRP)
hfvg_HTF_6_Settings.color_bear := input.color(color.new(color.blue,90), "", inline="htf6", group=hfvg_GRP)
hfvg_HTF_6_Settings.max_count  := input.int(2, "", inline="htf6", group=hfvg_GRP, tooltip = hfvg_tooltip1)

hfvg_settings.ltf_hide             := input.bool(true, "Hide Lower Timeframes", group=hfvg_GRP)
hfvg_settings.Border_show          := input.bool(true, "Show Border", group=hfvg_GRP, inline="4")
hfvg_settings.mitigated_show       := input.bool(true, "Show Mitigated", group=hfvg_GRP, inline="2")
hfvg_settings.mitigated_color_bull := input.color(color.new(color.gray,95), "", group=hfvg_GRP, inline="2")
hfvg_settings.mitigated_color_bear := input.color(color.new(color.gray,95), "", group=hfvg_GRP, inline="2")
hfvg_settings.mitigated_type       := input.string('Wick filled', 'when', options = ['None', 'Wick filled', 'Body filled', 'Wick filled half', 'Body filled half'], group=hfvg_GRP, inline="2", tooltip=hfvg_tooltip2)
hfvg_settings.CE_show              := input.bool(true, "Show C.E.", group=hfvg_GRP, inline="3")
hfvg_settings.CE_color             := input.color(color.new(color.black,60), "", group=hfvg_GRP, inline="3")
hfvg_settings.CE_style             := input.string('····', '', options = ['', '----', '····'], group=hfvg_GRP, inline="3")
hfvg_settings.label_show           := input.bool(true, "Show Label", group=hfvg_GRP, inline="label")
hfvg_settings.label_color          := input.color(color.new(color.black, 10), "", group=hfvg_GRP, inline='label')
hfvg_settings.label_bgcolor        := input.color(color.new(color.white, 100), "", group=hfvg_GRP, inline='label')
hfvg_settings.label_size           := input.string(size.small, "", [size.tiny, size.small, size.normal, size.large, size.huge], group=hfvg_GRP, inline="label")
hfvg_settings.padding              := input.int(4, "Distance from current candle", minval=0, group=hfvg_GRP)
hfvg_settings.buffer               := input.int(6, "Spacing between timeframes", minval=0, group=hfvg_GRP)

//+--- Variables ---+//
color hfvg_color_transparent = #ffffff00

hfvg_Helper hfvg_helper = hfvg_Helper.new()

var hfvg_ImbalanceStructure hfvg_FVG_1 = hfvg_ImbalanceStructure.new()
var hfvg_ImbalanceStructure hfvg_FVG_2 = hfvg_ImbalanceStructure.new()
var hfvg_ImbalanceStructure hfvg_FVG_3 = hfvg_ImbalanceStructure.new()
var hfvg_ImbalanceStructure hfvg_FVG_4 = hfvg_ImbalanceStructure.new()
var hfvg_ImbalanceStructure hfvg_FVG_5 = hfvg_ImbalanceStructure.new()
var hfvg_ImbalanceStructure hfvg_FVG_6 = hfvg_ImbalanceStructure.new()

var hfvg_Imbalance[] hfvg_FVGs_1 = array.new<hfvg_Imbalance>()
var hfvg_Imbalance[] hfvg_FVGs_2 = array.new<hfvg_Imbalance>()
var hfvg_Imbalance[] hfvg_FVGs_3 = array.new<hfvg_Imbalance>()
var hfvg_Imbalance[] hfvg_FVGs_4 = array.new<hfvg_Imbalance>()
var hfvg_Imbalance[] hfvg_FVGs_5 = array.new<hfvg_Imbalance>()
var hfvg_Imbalance[] hfvg_FVGs_6 = array.new<hfvg_Imbalance>()

hfvg_FVG_1.imbalance := hfvg_FVGs_1
hfvg_FVG_1.settings  := hfvg_HTF_1_Settings
hfvg_FVG_2.imbalance := hfvg_FVGs_2
hfvg_FVG_2.settings  := hfvg_HTF_2_Settings
hfvg_FVG_3.imbalance := hfvg_FVGs_3
hfvg_FVG_3.settings  := hfvg_HTF_3_Settings
hfvg_FVG_4.imbalance := hfvg_FVGs_4
hfvg_FVG_4.settings  := hfvg_HTF_4_Settings
hfvg_FVG_5.imbalance := hfvg_FVGs_5
hfvg_FVG_5.settings  := hfvg_HTF_5_Settings
hfvg_FVG_6.imbalance := hfvg_FVGs_6
hfvg_FVG_6.settings  := hfvg_HTF_6_Settings

// Used internally for padding
var int hfvg_TF_1 = 0
var int hfvg_TF_2 = 0
var int hfvg_TF_3 = 0
var int hfvg_TF_4 = 0
var int hfvg_TF_5 = 0
var int hfvg_TF_6 = 0

var float hfvg_daily   = 0
var float hfvg_monthly = 0

//+--- Methods ---+//
method LineStyle(hfvg_Helper helper, string style) =>
    helper.name := style
    out = switch style
        '----' => line.style_dashed
        '····' => line.style_dotted
        => line.style_solid
    out

method Gethtftext(hfvg_Helper helper, string htf) =>
    helper.name := htf
    formatted = htf
    seconds = timeframe.in_seconds(htf)
    if seconds < 60
        formatted := str.tostring(seconds) + "s"
    else if (seconds / 60) < 60
        formatted := str.tostring((seconds/60)) + "m"
    else if (seconds/60/60) < 24
        formatted := str.tostring((seconds/60/60)) + "H"
    formatted

method Validtimeframe(hfvg_Helper helper, tf) =>
    helper.name := tf
    n1 = timeframe.in_seconds()
    n2 = timeframe.in_seconds(tf)
    n1 < n2

method ProximityRange(hfvg_Helper helper, tf) =>
    helper.name := tf
    float range_high = 0
    float range_low  = 0
    if timeframe.isseconds or timeframe.isminutes
        range_high := close + hfvg_daily
        range_low  := close - hfvg_daily
    if timeframe.isdaily
        range_high := close + hfvg_monthly*3
        range_low  := close - hfvg_monthly*3
    if timeframe.isweekly
        range_high := close + hfvg_monthly*12
        range_low  := close - hfvg_monthly*12
    [range_low, range_high]

//+--- Imbalances Methods ---+//
// AddZone is used to display and manage imbalance related boxes
method AddZone(hfvg_ImbalanceStructure IS, hfvg_Imbalance imb, int step) =>
    bool visible = true
    if IS.settings.show
        int buffer = time+((time-time[1])*(hfvg_settings.padding+1+(hfvg_settings.buffer*(step-1))))
        if na(imb.box)
            imb.box := box.new(imb.open_time, imb.open, buffer, imb.close, hfvg_settings.Border_show ? imb.open < imb.close ? color.new(IS.settings.color_bull, color.t(IS.settings.color_bull)/ 3) : color.new(IS.settings.color_bear, color.t(IS.settings.color_bear)/ 3) : hfvg_color_transparent, hfvg_settings.Border_show ? 1 : 0, bgcolor = imb.open < imb.close ? IS.settings.color_bull : IS.settings.color_bear, xloc=xloc.bar_time)
            if hfvg_settings.label_show
                imb.lbl := label.new(buffer, imb.middle, text=hfvg_helper.Gethtftext(IS.settings.htf), xloc=xloc.bar_time, textcolor=hfvg_settings.label_color, style=label.style_label_left, color=hfvg_settings.label_bgcolor, size = hfvg_settings.label_size)
            if hfvg_settings.CE_show
                imb.line_middle := line.new(imb.open_time, imb.middle, buffer, imb.middle, xloc=xloc.bar_time, style=hfvg_helper.LineStyle(hfvg_settings.CE_style), color=hfvg_settings.CE_color)
        else
            box.set_right(imb.box, imb.mitigated ? imb.mitigated_time : buffer)
            box.set_bgcolor(imb.box, imb.open < imb.close ? imb.mitigated ? hfvg_settings.mitigated_color_bull : IS.settings.color_bull : imb.mitigated ? hfvg_settings.mitigated_color_bear : IS.settings.color_bear)
            box.set_border_color(imb.box, hfvg_settings.Border_show ? imb.open < imb.close ? color.new(hfvg_settings.mitigated_color_bull, color.t(hfvg_settings.mitigated_color_bull)/ 3) : color.new(hfvg_settings.mitigated_color_bear, color.t(hfvg_settings.mitigated_color_bear)/ 3) : hfvg_color_transparent)
            label.set_x(imb.lbl, imb.mitigated ? imb.mitigated_time : buffer)
            if hfvg_settings.CE_show
                line.set_x2(imb.line_middle, imb.mitigated ? imb.mitigated_time : buffer)
        if imb.mitigated and not hfvg_settings.mitigated_show
            if not na(imb.box)
                box.delete(imb.box)
                line.delete(imb.line_middle)
                label.delete(imb.lbl)
                visible := false
    visible

// AddImbalance adds a newly discovered imbalance. this applies for both FVG and Volume Imbalance
method AddImbalance(hfvg_ImbalanceStructure IS, float o, float c, int o_time) =>
    hfvg_Imbalance imb = hfvg_Imbalance.new()
    imb.open_time := o_time
    imb.open      := o
    imb.middle    := (o+c)/2
    imb.close     := c
    IS.imbalance.unshift(imb)
    if IS.imbalance.size() > 100
        temp = IS.imbalance.pop()
        if not na(temp.box)
            box.delete(temp.box)
            line.delete(temp.line_middle)
            label.delete(temp.lbl)
    IS

// CheckMitigated checks if the imbalance has been mitigated based on the settings
method CheckMitigated(hfvg_ImbalanceStructure IS, o, h, l, c) =>
    if IS.imbalance.size() > 0
        for i = IS.imbalance.size() - 1 to 0
            imb = IS.imbalance.get(i)
            if not imb.mitigated
                bool mitigated_now = switch hfvg_settings.mitigated_type
                    "None" =>
                        false
                    'Wick filled' =>
                        imb.open <= imb.close ? low <= imb.open : high >= imb.open
                    'Body filled' =>
                        imb.open < imb.close ? math.min(o, c) <= imb.open : math.max(o, c) >= imb.open
                    'Wick filled half' =>
                        imb.open <= imb.close ? low <= imb.middle : high >= imb.middle
                    'Body filled half' =>
                        imb.open <= imb.close ? math.min(o, c) <= imb.middle : math.max(o, c) >= imb.middle
                    =>
                        false
                imb.mitigated := mitigated_now
                if imb.mitigated
                    if not hfvg_settings.mitigated_show
                        if not na(imb.box)
                            box.delete(imb.box)
                            line.delete(imb.line_middle)
                            label.delete(imb.lbl)
                        IS.imbalance.remove(i)
                    else
                        imb.mitigated_time := time
    IS

method AdjustMargins(hfvg_ImbalanceStructure IS, int step) =>
    int count = 0
    if IS.imbalance.size() > 0
        int buffer = time+((time-time[1])*(hfvg_settings.padding+1+(hfvg_settings.buffer*(step-1))))
        [rl, rh] = hfvg_helper.ProximityRange(IS.settings.htf)
        for i = 0 to IS.imbalance.size() - 1
            imb = IS.imbalance.get(i)
            if ((math.max(imb.open, imb.close) > rl) and (math.min(imb.open, imb.close) < rh)) and count < IS.settings.max_count
                if IS.AddZone(imb, step)
                    count := count+1
            else
                if not na(imb.box)
                    box.delete(imb.box)
                    label.delete(imb.lbl)
                    line.delete((imb.line_middle))
    IS

// FindImbalance looks for imbalances and, if found, adds it to the list
method FindImbalance(hfvg_ImbalanceStructure IS, o, h, l, c, t, o1, h1, l1, c1, t1, o2, h2, l2, c2, t2) =>
    if IS.settings.show and (h < l2 or l > h2)
        o = h < l2 ? l2 : h2
        c = h < l2 ? h : l
        if IS.imbalance.size() == 0
            IS.AddImbalance(o, c, t2)
        else
            if IS.imbalance.first().open_time < t2
                IS.AddImbalance(o, c, t2)
    IS

method Process(hfvg_ImbalanceStructure IS, float o, float h, float l, float c, int t, float o1, float h1, float l1, float c1, int t1, float o2, float h2, float l2, float c2, int t2) =>
    var int visible = 0
    if IS.settings.show
        if not hfvg_settings.ltf_hide or (hfvg_settings.ltf_hide and hfvg_helper.Validtimeframe(IS.settings.htf))
            if IS.settings.show
                IS.FindImbalance(o, h, l, c, t, o1, h1, l1, c1, t1, o2, h2, l2, c2, t2)
                visible := 1
        IS.CheckMitigated(o, h, l, c)
    visible

//+--- Main call to start the process ---+//
hfvg_daily   := request.security(syminfo.tickerid, "1D", ta.atr(14))
hfvg_monthly := request.security(syminfo.tickerid, "1M", ta.atr(14))

[hfvg_o_1, hfvg_h_1, hfvg_l_1, hfvg_c_1, hfvg_t_1]           = request.security(syminfo.tickerid, hfvg_htf_1, [open[1], high[1], low[1], close[1], time[1]])
[hfvg_o1_1, hfvg_h1_1, hfvg_l1_1, hfvg_c1_1, hfvg_t1_1]      = request.security(syminfo.tickerid, hfvg_htf_1, [open[2], high[2], low[2], close[2], time[2]])
[hfvg_o2_1, hfvg_h2_1, hfvg_l2_1, hfvg_c2_1, hfvg_t2_1]      = request.security(syminfo.tickerid, hfvg_htf_1, [open[3], high[3], low[3], close[3], time[3]])
hfvg_TF_1 := hfvg_FVG_1.Process(hfvg_o_1, hfvg_h_1, hfvg_l_1, hfvg_c_1, hfvg_t_1, hfvg_o1_1, hfvg_h1_1, hfvg_l1_1, hfvg_c1_1, hfvg_t1_1, hfvg_o2_1, hfvg_h2_1, hfvg_l2_1, hfvg_c2_1, hfvg_t2_1)
hfvg_FVG_1.AdjustMargins(hfvg_TF_1)

[hfvg_o_2, hfvg_h_2, hfvg_l_2, hfvg_c_2, hfvg_t_2]           = request.security(syminfo.tickerid, hfvg_htf_2, [open[1], high[1], low[1], close[1], time[1]])
[hfvg_o1_2, hfvg_h1_2, hfvg_l1_2, hfvg_c1_2, hfvg_t1_2]      = request.security(syminfo.tickerid, hfvg_htf_2, [open[2], high[2], low[2], close[2], time[2]])
[hfvg_o2_2, hfvg_h2_2, hfvg_l2_2, hfvg_c2_2, hfvg_t2_2]      = request.security(syminfo.tickerid, hfvg_htf_2, [open[3], high[3], low[3], close[3], time[3]])
hfvg_TF_2 := hfvg_TF_1 + hfvg_FVG_2.Process(hfvg_o_2, hfvg_h_2, hfvg_l_2, hfvg_c_2, hfvg_t_2, hfvg_o1_2, hfvg_h1_2, hfvg_l1_2, hfvg_c1_2, hfvg_t1_2, hfvg_o2_2, hfvg_h2_2, hfvg_l2_2, hfvg_c2_2, hfvg_t2_2)
hfvg_FVG_2.AdjustMargins(hfvg_TF_2)

[hfvg_o_3, hfvg_h_3, hfvg_l_3, hfvg_c_3, hfvg_t_3]           = request.security(syminfo.tickerid, hfvg_htf_3, [open[1], high[1], low[1], close[1], time[1]])
[hfvg_o1_3, hfvg_h1_3, hfvg_l1_3, hfvg_c1_3, hfvg_t1_3]      = request.security(syminfo.tickerid, hfvg_htf_3, [open[2], high[2], low[2], close[2], time[2]])
[hfvg_o2_3, hfvg_h2_3, hfvg_l2_3, hfvg_c2_3, hfvg_t2_3]      = request.security(syminfo.tickerid, hfvg_htf_3, [open[3], high[3], low[3], close[3], time[3]])
hfvg_TF_3 := hfvg_TF_2 + hfvg_FVG_3.Process(hfvg_o_3, hfvg_h_3, hfvg_l_3, hfvg_c_3, hfvg_t_3, hfvg_o1_3, hfvg_h1_3, hfvg_l1_3, hfvg_c1_3, hfvg_t1_3, hfvg_o2_3, hfvg_h2_3, hfvg_l2_3, hfvg_c2_3, hfvg_t2_3)
hfvg_FVG_3.AdjustMargins(hfvg_TF_3)

[hfvg_o_4, hfvg_h_4, hfvg_l_4, hfvg_c_4, hfvg_t_4]           = request.security(syminfo.tickerid, hfvg_htf_4, [open[1], high[1], low[1], close[1], time[1]])
[hfvg_o1_4, hfvg_h1_4, hfvg_l1_4, hfvg_c1_4, hfvg_t1_4]      = request.security(syminfo.tickerid, hfvg_htf_4, [open[2], high[2], low[2], close[2], time[2]])
[hfvg_o2_4, hfvg_h2_4, hfvg_l2_4, hfvg_c2_4, hfvg_t2_4]      = request.security(syminfo.tickerid, hfvg_htf_4, [open[3], high[3], low[3], close[3], time[3]])
hfvg_TF_4 := hfvg_TF_3 + hfvg_FVG_4.Process(hfvg_o_4, hfvg_h_4, hfvg_l_4, hfvg_c_4, hfvg_t_4, hfvg_o1_4, hfvg_h1_4, hfvg_l1_4, hfvg_c1_4, hfvg_t1_4, hfvg_o2_4, hfvg_h2_4, hfvg_l2_4, hfvg_c2_4, hfvg_t2_4)
hfvg_FVG_4.AdjustMargins(hfvg_TF_4)

[hfvg_o_5, hfvg_h_5, hfvg_l_5, hfvg_c_5, hfvg_t_5]           = request.security(syminfo.tickerid, hfvg_htf_5, [open[1], high[1], low[1], close[1], time[1]])
[hfvg_o1_5, hfvg_h1_5, hfvg_l1_5, hfvg_c1_5, hfvg_t1_5]      = request.security(syminfo.tickerid, hfvg_htf_5, [open[2], high[2], low[2], close[2], time[2]])
[hfvg_o2_5, hfvg_h2_5, hfvg_l2_5, hfvg_c2_5, hfvg_t2_5]      = request.security(syminfo.tickerid, hfvg_htf_5, [open[3], high[3], low[3], close[3], time[3]])
hfvg_TF_5 := hfvg_TF_4 + hfvg_FVG_5.Process(hfvg_o_5, hfvg_h_5, hfvg_l_5, hfvg_c_5, hfvg_t_5, hfvg_o1_5, hfvg_h1_5, hfvg_l1_5, hfvg_c1_5, hfvg_t1_5, hfvg_o2_5, hfvg_h2_5, hfvg_l2_5, hfvg_c2_5, hfvg_t2_5)
hfvg_FVG_5.AdjustMargins(hfvg_TF_5)

[hfvg_o_6, hfvg_h_6, hfvg_l_6, hfvg_c_6, hfvg_t_6]           = request.security(syminfo.tickerid, hfvg_htf_6, [open[1], high[1], low[1], close[1], time[1]])
[hfvg_o1_6, hfvg_h1_6, hfvg_l1_6, hfvg_c1_6, hfvg_t1_6]      = request.security(syminfo.tickerid, hfvg_htf_6, [open[2], high[2], low[2], close[2], time[2]])
[hfvg_o2_6, hfvg_h2_6, hfvg_l2_6, hfvg_c2_6, hfvg_t2_6]      = request.security(syminfo.tickerid, hfvg_htf_6, [open[3], high[3], low[3], close[3], time[3]])
hfvg_TF_6 := hfvg_TF_5 + hfvg_FVG_6.Process(hfvg_o_6, hfvg_h_6, hfvg_l_6, hfvg_c_6, hfvg_t_6, hfvg_o1_6, hfvg_h1_6, hfvg_l1_6, hfvg_c1_6, hfvg_t1_6, hfvg_o2_6, hfvg_h2_6, hfvg_l2_6, hfvg_c2_6, hfvg_t2_6)
hfvg_FVG_6.AdjustMargins(hfvg_TF_6)


//+------------------------------------------------------------------------------------------------------------+//
//+--- ICT Fair Value Gaps (from "Simple ICT OB & FVG" by Gowtham Kannakaje L)                              ---+//
//+------------------------------------------------------------------------------------------------------------+//
// FVG-only port (behavior-preserving) — the Order Blocks and HTF-FVG parts of the source are intentionally
// NOT included, per request. All identifiers namespaced with `gkf_` to avoid collisions with the host script.
// © Gowtham Kannakaje L.

// --- Inputs ---
var gkf_GRP = "ICT FVG (GK)"

gkf_mitType = input.string("Close", title="Mitigation Type", options=["Close", "Wick"], tooltip="Choose how Fair Value Gaps are mitigated", inline="gkf_first", group=gkf_GRP)
gkf_mitLow  = gkf_mitType == "Close" ? close[1] : low
gkf_mitHigh = gkf_mitType == "Close" ? close[1] : high

gkf_simple  = input(true, title='Show simple version of the FVGs', tooltip="Select this to keep chart clean (box will not be extended)", inline="gkf_first", group=gkf_GRP)

gkf_show       = input(true,  title='Show FVG Boxes', group=gkf_GRP, inline='gkf_3')
gkf_delMit     = input(false, title='Delete Mitigated FVG', group=gkf_GRP, tooltip="Removes the mitigated Fair Value Gaps from the chart based on the Mitigation Type specified.", inline='gkf_3')
gkf_bullBorder = input.color(color.rgb(76, 175, 80, 80),  title="FVG border: Bullish ", group=gkf_GRP, inline="gkf_4")
gkf_bearBorder = input.color(color.rgb(255, 82, 82, 80),  title="Bearish", group=gkf_GRP, inline="gkf_4")
gkf_bullBox    = input.color(color.rgb(76, 175, 80, 97),  title="FVG box:", group=gkf_GRP, inline="gkf_4")
gkf_bearBox    = input.color(color.rgb(255, 82, 82, 97),  title="Bearish", group=gkf_GRP, inline="gkf_4")

// --- Detection ---
gkf_bullFVG = low - high[2] > 0  and open[1] < close[1]
gkf_bearFVG = low[2] - high > 0  and open[1] > close[1]

// --- Box arrays ---
var box gkf_bull = na
var box gkf_bear = na
var gkf_bullArr = array.new_box()
var gkf_bearArr = array.new_box()
var box[] gkf_bullMit = array.new_box()
var box[] gkf_bearMit = array.new_box()

// --- Draw new FVGs ---
if (gkf_bullFVG and gkf_show)
    gkf_bull := box.new(bar_index-2, high[2], bar_index, low, border_color = gkf_simple ? color.rgb(76, 175, 79, 50) : gkf_bullBorder, bgcolor = gkf_bullBox, text = "", text_color = color.rgb(255, 255, 255, 80), text_size = size.small, extend = gkf_simple ? extend.none : extend.right)
    array.push(gkf_bullArr, gkf_bull)

if (gkf_bearFVG and gkf_show)
    gkf_bear := box.new(bar_index-2, low[2], bar_index, high, border_color = gkf_simple ? color.rgb(255, 82, 82, 50) : gkf_bearBorder, bgcolor = gkf_bearBox, text = "", text_color = color.rgb(255, 255, 255, 80), text_size = size.small, extend = gkf_simple ? extend.none : extend.right)
    array.push(gkf_bearArr, gkf_bear)

// --- Bullish clean up / mitigation ---
if array.size(gkf_bullArr) > 0 and not gkf_simple
    for i = array.size(gkf_bullArr) - 1 to 0 by 1
        XX = array.get(gkf_bullArr, i)
        XXxx = box.get_bottom(XX)
        XXx = box.get_top(XX)
        // If the last close/low is below the low of the bullish FVG - remove the FVG
        if gkf_mitLow < XXxx
            box.set_right(XX, bar_index)
            box.set_extend(XX, extend.none)
            array.unshift(gkf_bullMit, XX)
            array.remove(gkf_bullArr, i)
            if gkf_delMit
                box.delete(XX)

// --- Bearish clean up / mitigation ---
if array.size(gkf_bearArr) > 0 and not gkf_simple
    for i = array.size(gkf_bearArr) - 1 to 0 by 1
        XX = array.get(gkf_bearArr, i)
        XXx = box.get_top(XX)
        XXxx = box.get_bottom(XX)
        // If the last close/high is above the high of the bearish FVG - remove the FVG
        if gkf_mitHigh > XXx
            box.set_right(XX, bar_index)
            box.set_extend(XX, extend.none)
            array.unshift(gkf_bearMit, XX)
            array.remove(gkf_bearArr, i)
            if gkf_delMit
                box.delete(XX)

// --- Alerts ---
alertcondition((gkf_bullFVG),                 "Bullish FVG", "Bullish FVG")
alertcondition((gkf_bearFVG),                 "Bearish FVG", "Bearish FVG")
alertcondition((gkf_bullFVG or gkf_bearFVG),  "All FVG",     "All FVG")


//+------------------------------------------------------------------------------------------------------------+//
//+--- CISD by tncylyv  (Change In State of Delivery)                                                       ---+//
//+------------------------------------------------------------------------------------------------------------+//
// Visual port (behavior-preserving) of the standalone "CISD by tncylyv" indicator. Replaces the host script's
// old on-chart CISD lines/labels (now disabled via `cisd_old_visual`). This is a self-contained visual +
// MTF trend table and does NOT feed the C2/C3/C4/ATM models (those use the new source's per-bar CISD triggers).
// All identifiers namespaced with `tcisd_`.

var string tcisd_grpVisual = "CISD (tncylyv) — Visual"
var string tcisd_grpColors = "CISD (tncylyv) — Colors"
var string tcisd_grpDebug  = "CISD (tncylyv) — Debug"
var string tcisd_grpPanel  = "CISD (tncylyv) — HTF Trend Panel"

tcisd_showActive = input.bool(false, "Show Active CISD Level (Plot)", group=tcisd_grpVisual)
tcisd_display    = input.string("Both", "Triggered CISD Display", options=["Both", "Bullish Only", "Bearish Only", "None"], group=tcisd_grpVisual)
tcisd_limitHist  = input.bool(true, "Limit Displayed Historical Lines", group=tcisd_grpVisual)
tcisd_maxLines   = input.int(2, "Max Lines to Show", minval=1, maxval=10, group=tcisd_grpVisual)
tcisd_extend     = input.int(0, "Extend Lines (Bars)", minval=0, group=tcisd_grpVisual, tooltip="0 = Boring normal length. >0 = Stretch that stuff into the future.")
tcisd_showLabels = input.bool(true, "Show Labels", group=tcisd_grpVisual)
tcisd_labelPos   = input.string("Center", "Label Position", options=["Left", "Center", "Right"], group=tcisd_grpVisual)
tcisd_lineWidth  = input.int(2, "Line Width", minval=1, group=tcisd_grpVisual)
tcisd_labelSize  = input.string(size.small, "Label Size", options=[size.tiny, size.small, size.normal, size.large], group=tcisd_grpVisual)
tcisd_font       = input.string("Default", "Font Family", options=["Default", "Monospace"], group=tcisd_grpVisual)
tcisd_lineStyle  = input.string("Solid", "Triggered Line Style", options=["Solid", "Dashed", "Dotted"], group=tcisd_grpVisual)
tcisd_bullText   = input.string("+CISD", "Bullish CISD Label Text", group=tcisd_grpVisual)
tcisd_bearText   = input.string("-CISD", "Bearish CISD Label Text", group=tcisd_grpVisual)

tcisd_bullColor  = input.color(color.new(color.green, 0), "Bullish CISD", group=tcisd_grpColors)
tcisd_bearColor  = input.color(color.new(color.red, 0), "Bearish CISD", group=tcisd_grpColors)

tcisd_debug      = input.bool(false, "Debug: Show Extreme Tracking", group=tcisd_grpDebug)

tcisd_showTable  = input.bool(true, "Show Multi-Timeframe Table", group=tcisd_grpPanel)
tcisd_tablePos   = input.string("Bottom Right", "Table Position", options=["Top Right", "Middle Right", "Bottom Right", "Bottom Left"], group=tcisd_grpPanel)
tcisd_tableSize  = input.string("Small", "Table Size", options=["Tiny", "Small", "Normal", "Large"], group=tcisd_grpPanel)

var string tcisd_fontFamily = tcisd_font == "Monospace" ? font.family_monospace : font.family_default

tcisd_decodeStyle(outfit) =>
    switch outfit
        "Solid"  => line.style_solid
        "Dashed" => line.style_dashed
        => line.style_dotted

tcisd_chosenStyle = tcisd_decodeStyle(tcisd_lineStyle)

var int   tcisd_vibes   = 0
var float tcisd_entry   = na
var int   tcisd_timeSet = na
var float tcisd_pain    = na
var label tcisd_sticky  = na
var array<line>  tcisd_lines  = array.new<line>()
var array<label> tcisd_labels = array.new<label>()

tcisd_crystalBall(int bias) =>
    int temporal_shift = 0
    float extreme = open[0]
    int candle_attitude = close[0] > open[0] ? 1 : close[0] < open[0] ? -1 : 0
    if candle_attitude == 0 or candle_attitude != bias
        [extreme, bar_index]
    for i = 1 to 500
        candle_attitude := close[i] > open[i] ? 1 : close[i] < open[i] ? -1 : 0
        if candle_attitude == 0
            continue
        bool mood_match = candle_attitude == bias
        if not mood_match
            break
        temporal_shift := i
        if bias == 1
            if open[i] < extreme
                extreme := open[i]
        else
            if open[i] > extreme
                extreme := open[i]
    int extreme_shift = na
    for k = 0 to temporal_shift
        if open[k] == extreme
            extreme_shift := k
            break
    [extreme, bar_index - extreme_shift]

tcisd_archaeologist(int bias) =>
    int i = 1
    bool artifact_found = false
    int max_shift = na
    float extreme = na
    for j = 1 to 500
        i := j
        int candle_attitude = close[i] > open[i] ? 1 : close[i] < open[i] ? -1 : 0
        if candle_attitude == 0
            continue
        bool is_correct_era = candle_attitude == bias
        if not artifact_found
            if is_correct_era
                artifact_found := true
                max_shift := i
                extreme := open[i]
        else
            if not is_correct_era
                break
            max_shift := i
            if bias == 1
                if open[i] < extreme
                    extreme := open[i]
            else
                if open[i] > extreme
                    extreme := open[i]
    int extreme_shift = na
    for k = 1 to max_shift
        if open[k] == extreme
            extreme_shift := k
            break
    [extreme, bar_index - extreme_shift]

if tcisd_vibes == 0 and bar_index > 10
    int first_impression = close > open ? 1 : close < open ? -1 : 0
    if first_impression == 0
        for k = 1 to 50
            first_impression := close[k] > open[k] ? 1 : close[k] < open[k] ? -1 : 0
            if first_impression != 0
                break
    if first_impression != 0
        tcisd_vibes := first_impression
        [origin_price, origin_time] = tcisd_crystalBall(first_impression)
        tcisd_entry   := origin_price
        tcisd_timeSet := origin_time
        tcisd_pain    := first_impression == 1 ? high : low

int   tcisd_candlePersonality = close > open ? 1 : close < open ? -1 : 0
float tcisd_freshHopium = na
int   tcisd_freshTimestamp = na

if tcisd_vibes == 1
    if high > tcisd_pain
        tcisd_pain := high
        if tcisd_candlePersonality == 1
            [p_price, p_idx] = tcisd_crystalBall(1)
            tcisd_freshHopium := p_price
            tcisd_freshTimestamp := p_idx
        else
            [p_price, p_idx] = tcisd_archaeologist(1)
            tcisd_freshHopium := p_price
            tcisd_freshTimestamp := p_idx
        tcisd_entry   := tcisd_freshHopium
        tcisd_timeSet := tcisd_freshTimestamp
else if tcisd_vibes == -1
    if low < tcisd_pain
        tcisd_pain := low
        if tcisd_candlePersonality == -1
            [p_price, p_idx] = tcisd_crystalBall(-1)
            tcisd_freshHopium := p_price
            tcisd_freshTimestamp := p_idx
        else
            [p_price, p_idx] = tcisd_archaeologist(-1)
            tcisd_freshHopium := p_price
            tcisd_freshTimestamp := p_idx
        tcisd_entry   := tcisd_freshHopium
        tcisd_timeSet := tcisd_freshTimestamp

bool tcisd_shortsSqueezed = tcisd_vibes == -1 and close > tcisd_entry
bool tcisd_longsRekt      = tcisd_vibes == 1  and close < tcisd_entry

if tcisd_shortsSqueezed or tcisd_longsRekt
    bool should_i_paint_it = false
    if tcisd_display == "Both"
        should_i_paint_it := true
    else if tcisd_display == "Bullish Only"
        should_i_paint_it := tcisd_shortsSqueezed
    else if tcisd_display == "Bearish Only"
        should_i_paint_it := tcisd_longsRekt
    if should_i_paint_it
        color mood_ring = tcisd_shortsSqueezed ? tcisd_bullColor : tcisd_bearColor
        line tragedy_line = line.new(tcisd_timeSet, tcisd_entry, bar_index + tcisd_extend, tcisd_entry, color=mood_ring, width=tcisd_lineWidth, style=tcisd_chosenStyle)
        array.push(tcisd_lines, tragedy_line)
        label loud_noise = na
        if tcisd_showLabels
            int soapbox_location = na
            if tcisd_labelPos == "Left"
                soapbox_location := tcisd_timeSet
            else if tcisd_labelPos == "Right"
                soapbox_location := bar_index + tcisd_extend
            else
                soapbox_location := math.round((tcisd_timeSet + bar_index + tcisd_extend) / 2)
            string gibberish = tcisd_shortsSqueezed ? tcisd_bullText : tcisd_bearText
            color ink_color = tcisd_shortsSqueezed ? tcisd_bullColor : tcisd_bearColor
            loud_noise := label.new(soapbox_location, tcisd_entry, gibberish, style=tcisd_shortsSqueezed ? label.style_label_down : label.style_label_up, color=color.new(#000000, 100), textcolor=ink_color, size=tcisd_labelSize, text_font_family=tcisd_fontFamily)
            array.push(tcisd_labels, loud_noise)
    int new_emotional_state = tcisd_shortsSqueezed ? 1 : -1
    tcisd_vibes := new_emotional_state
    [reset_price, reset_time] = tcisd_crystalBall(new_emotional_state)
    tcisd_entry   := reset_price
    tcisd_timeSet := reset_time
    tcisd_pain    := new_emotional_state == 1 ? high : low

color tcisd_activeCrayon = tcisd_vibes == 1 ? tcisd_bullColor : tcisd_bearColor

plot(tcisd_showActive ? tcisd_entry : na, "Active CISD", color=tcisd_activeCrayon, linewidth=tcisd_lineWidth, style=plot.style_linebr)

if tcisd_showActive and not na(tcisd_entry)
    label.delete(tcisd_sticky)
    string status_msg = tcisd_vibes == 1 ? "+Active CISD" : "-Active CISD"
    tcisd_sticky := label.new(bar_index, tcisd_entry, status_msg, color=color.new(tcisd_activeCrayon, 100), textcolor=tcisd_activeCrayon, style=label.style_label_left, size=size.small, text_font_family=tcisd_fontFamily)

int tcisd_hoardingLimit = tcisd_limitHist ? tcisd_maxLines : 450

if array.size(tcisd_lines) > tcisd_hoardingLimit
    int trash_accumulation = array.size(tcisd_lines) - tcisd_hoardingLimit
    for janitor_duty = 0 to trash_accumulation - 1
        if array.size(tcisd_lines) > 0
            line.delete(array.shift(tcisd_lines))
        if array.size(tcisd_labels) > 0
            label.delete(array.shift(tcisd_labels))

plot(tcisd_debug ? tcisd_pain : na, "Debug Extreme", color=color.orange, linewidth=2, style=plot.style_circles)
alertcondition(tcisd_shortsSqueezed, title="Bullish CISD Trigger", message="Bullish CISD (+CISD) Triggered!")
alertcondition(tcisd_longsRekt,      title="Bearish CISD Trigger", message="Bearish CISD (-CISD) Triggered!")

tcisd_r_1m  = request.security(syminfo.tickerid, "1",   tcisd_vibes)
tcisd_r_3m  = request.security(syminfo.tickerid, "3",   tcisd_vibes)
tcisd_r_5m  = request.security(syminfo.tickerid, "5",   tcisd_vibes)
tcisd_r_15m = request.security(syminfo.tickerid, "15",  tcisd_vibes)
tcisd_r_1h  = request.security(syminfo.tickerid, "60",  tcisd_vibes)
tcisd_r_4h  = request.security(syminfo.tickerid, "240", tcisd_vibes)
tcisd_r_1d  = request.security(syminfo.tickerid, "1D",  tcisd_vibes)
tcisd_r_1w  = request.security(syminfo.tickerid, "1W",  tcisd_vibes)

tcisd_tableFontSize = tcisd_tableSize == "Tiny" ? size.tiny : tcisd_tableSize == "Small" ? size.small : tcisd_tableSize == "Large" ? size.large : size.normal
tcisd_tableSpot = tcisd_tablePos == "Top Right" ? position.top_right : tcisd_tablePos == "Middle Right" ? position.middle_right : tcisd_tablePos == "Bottom Left" ? position.bottom_left : position.bottom_right

var table tcisd_table = table.new(tcisd_tableSpot, 2, 9, border_width=1, border_color=color.gray, frame_color=color.gray, frame_width=1)

tcisd_vibeColor(mood) =>
    mood == 1 ? tcisd_bullColor : mood == -1 ? tcisd_bearColor : color.gray

tcisd_moodText(mood) =>
    mood == 1 ? "Bullish" : mood == -1 ? "Bearish" : "Loading"

if tcisd_showTable and barstate.islast
    table.cell(tcisd_table, 0, 0, "Timeframe", bgcolor=color.new(color.gray, 80), text_color=color.white, text_size=tcisd_tableFontSize)
    table.cell(tcisd_table, 1, 0, "Trend Status", bgcolor=color.new(color.gray, 80), text_color=color.white, text_size=tcisd_tableFontSize)
    table.cell(tcisd_table, 0, 1, "1m", bgcolor=color.new(color.black, 50), text_color=color.white, text_size=tcisd_tableFontSize)
    table.cell(tcisd_table, 1, 1, tcisd_moodText(tcisd_r_1m), bgcolor=tcisd_vibeColor(tcisd_r_1m), text_color=color.white, text_size=tcisd_tableFontSize)
    table.cell(tcisd_table, 0, 2, "3m", bgcolor=color.new(color.black, 50), text_color=color.white, text_size=tcisd_tableFontSize)
    table.cell(tcisd_table, 1, 2, tcisd_moodText(tcisd_r_3m), bgcolor=tcisd_vibeColor(tcisd_r_3m), text_color=color.white, text_size=tcisd_tableFontSize)
    table.cell(tcisd_table, 0, 3, "5m", bgcolor=color.new(color.black, 50), text_color=color.white, text_size=tcisd_tableFontSize)
    table.cell(tcisd_table, 1, 3, tcisd_moodText(tcisd_r_5m), bgcolor=tcisd_vibeColor(tcisd_r_5m), text_color=color.white, text_size=tcisd_tableFontSize)
    table.cell(tcisd_table, 0, 4, "15m", bgcolor=color.new(color.black, 50), text_color=color.white, text_size=tcisd_tableFontSize)
    table.cell(tcisd_table, 1, 4, tcisd_moodText(tcisd_r_15m), bgcolor=tcisd_vibeColor(tcisd_r_15m), text_color=color.white, text_size=tcisd_tableFontSize)
    table.cell(tcisd_table, 0, 5, "1H", bgcolor=color.new(color.black, 50), text_color=color.white, text_size=tcisd_tableFontSize)
    table.cell(tcisd_table, 1, 5, tcisd_moodText(tcisd_r_1h), bgcolor=tcisd_vibeColor(tcisd_r_1h), text_color=color.white, text_size=tcisd_tableFontSize)
    table.cell(tcisd_table, 0, 6, "4H", bgcolor=color.new(color.black, 50), text_color=color.white, text_size=tcisd_tableFontSize)
    table.cell(tcisd_table, 1, 6, tcisd_moodText(tcisd_r_4h), bgcolor=tcisd_vibeColor(tcisd_r_4h), text_color=color.white, text_size=tcisd_tableFontSize)
    table.cell(tcisd_table, 0, 7, "1D", bgcolor=color.new(color.black, 50), text_color=color.white, text_size=tcisd_tableFontSize)
    table.cell(tcisd_table, 1, 7, tcisd_moodText(tcisd_r_1d), bgcolor=tcisd_vibeColor(tcisd_r_1d), text_color=color.white, text_size=tcisd_tableFontSize)
    table.cell(tcisd_table, 0, 8, "1W", bgcolor=color.new(color.black, 50), text_color=color.white, text_size=tcisd_tableFontSize)
    table.cell(tcisd_table, 1, 8, tcisd_moodText(tcisd_r_1w), bgcolor=tcisd_vibeColor(tcisd_r_1w), text_color=color.white, text_size=tcisd_tableFontSize)
