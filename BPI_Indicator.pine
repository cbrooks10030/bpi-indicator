var string LINE_STYLE_DASHED = line.style_dashed
var string LINE_STYLE_DOTTED = line.style_dotted

// Text Sizes
var string SIZE_TINY = size.tiny
var string SIZE_SMALL = size.small
var string SIZE_NORMAL = size.normal
var string SIZE_LARGE = size.large
var string SIZE_HUGE = size.huge

// Label-size resolver — defined early so all downstream code (CISD, sweep, info-box) can use it.
f_resolveSize(simple string sz) =>
    sz == SIZE_HUGE   ? size.huge   :
      sz == SIZE_LARGE  ? size.large  :
      sz == SIZE_NORMAL ? size.normal :
      sz == SIZE_SMALL  ? size.small  :
      size.tiny






// === ICT HTF Candle Fractal Model — integrated source ===
// Replaces our previous fractal/CISD/HTF-engine implementations entirely. Provides:
//   - Auto/manual HTF TF (1m→15m, 3m→30m, 5m→1h, 15m→4h, 60m→1D, 240m→1W, else 1M)
//   - HTF candles drawn to the right of the live chart
//   - HTF FVG, Volume Imbalance, swing lines, sweep markers, O/C lines
//   - C2 / C3 / C4 fractal flow with bias filter + XC2/XC4 invalidation
//   - CISD neo (Pending / Faded / Confirmed / Hybrid)
//   - Standard-deviation projections off each C2
//   - HTF Open / EQ lines + Trading Zone box
//   - HH / HL / LH / LL markers
// (First 1m FVG and the source's own info-table are intentionally excluded.)

