open_830_label_text = input.string("8:30", "8:30 Open Label", group=GRP_SESSIONS)

show_session_labels = input.bool(true, "Show Session Text Labels", group=GRP_SESSIONS, tooltip="If off, lines still show but text labels are hidden.")
session_line_width = input.int(1, "Session Line Width", minval=1, maxval=4, group=GRP_SESSIONS)
session_line_style_in = input.string("solid", "Session Line Style", options=["solid","dashed","dotted"], group=GRP_SESSIONS)
session_label_size = input.string(SIZE_SMALL, "Session Label Size", options=[SIZE_TINY, SIZE_SMALL, SIZE_NORMAL, SIZE_LARGE, SIZE_HUGE], group=GRP_SESSIONS)
session_label_pos_in = input.string("Right", "Session Label Position", options=["Above","Below","Left","Right","Center","Inside-Left"], group=GRP_SESSIONS, tooltip="Where each session's text sits relative to the end of its line. 'Inside-Left' pins the RIGHT edge of the text to the end of the line so the text reads BACK into the line and never overflows past the endpoint. 'Center' has NO callout arrow — text sits directly at the anchor (may overflow past line end). Above/Below/Left/Right use a Pine callout label.")
session_label_padding = input.int(0, "Session Label Nudge (signed bars, −500 to +500)", minval=-500, maxval=500, group=GRP_SESSIONS, tooltip="Signed horizontal nudge for the session label. 0 = label sits at the chart's right edge (current bar). NEGATIVE values pull the text BACKWARD (left, into history). POSITIVE values push the text FORWARD (right, into the future / projection area). Range −500 to +500 bars. NOTE: if the slider in Settings still shows 0 as the minimum after updating the script, that's a TradingView input cache — remove the indicator from the chart and re-add it.")
session_taken_label_pad = input.int(6, "Swept-Level Label Left Pad (bars)", minval=0, maxval=100, group=GRP_SESSIONS, tooltip="For NY AM / Asia / London levels that have been swept: how many bars to the LEFT of the takeout point the text sits. The text reads back to the left of the takeout candle so it never overlaps the wicks/candles that swept the level. Increase for more clearance.")
session_taken_center_thresh = input.int(25, "Swept-Level Auto-Center Threshold (bars)", minval=0, maxval=500, group=GRP_SESSIONS, tooltip="If a swept level's line is SHORTER than this many bars (i.e. price took it out soon after it formed, leaving too little room for left-padded text), the text is automatically CENTERED on the line instead. Set to 0 to always left-pad and never auto-center.")

auto_hide_sessions_on_htf = input.bool(true, "Auto-hide Sessions on 15m+", group=GRP_SESSIONS, tooltip="When ON, the Asia / London / NY AM session high & low lines (and their labels) are automatically hidden on charts with a 15-minute or higher timeframe to reduce clutter. Midnight Open, 8:30 Open, Previous Day H/L, and the 1hr/15m swing labels are NOT affected. Turn OFF to always show the sessions regardless of chart timeframe.")
sessions_hidden_by_tf = auto_hide_sessions_on_htf and timeframe.in_seconds() >= 15 * 60

session_line_style = session_line_style_in == "dashed" ? line.style_dashed : session_line_style_in == "dotted" ? line.style_dotted : line.style_solid

// Session Swings — at AM (9:30-12:00 ET) and optional PM (13:30-15:30 ET) opens, snapshot
// the last N swing highs and N swing lows from the 1h and/or 15m timeframes (each
// independently toggleable) and draw each as a horizontal line anchored at its pivot
// bar's time, extending right until session end OR taken out (wick or body close).
// Lines do NOT carry over to the next day.
string GRP_SWINGS         = "Session Swings"
ss_show                   = input.bool(true,  "Show session swings", group=GRP_SWINGS, tooltip="Master toggle. Off = no lines/labels drawn.")
ss_show_h1                = input.bool(true,  "1h source",   inline="src",  group=GRP_SWINGS, tooltip="Detect swings on the 1-hour timeframe.")
ss_show_m15               = input.bool(true,  "15m source",  inline="src",  group=GRP_SWINGS, tooltip="Detect swings on the 15-minute timeframe.")
ss_show_am                = input.bool(true,  "AM session (9:30-12:00 ET)",  group=GRP_SWINGS)
ss_show_pm                = input.bool(false, "PM session (13:30-15:30 ET)", group=GRP_SWINGS)
ss_per_side               = input.int(2, "Swings per side (per TF)", minval=1, maxval=5, group=GRP_SWINGS, tooltip="How many of the most-recent swing highs AND swing lows to snapshot at session open from each enabled source TF. Default 2 → up to 4 lines per TF.")
ss_pivot_len              = input.int(1, "Pivot length", minval=1, maxval=10, group=GRP_SWINGS, tooltip="Bars on each side of the pivot. 1 = middle candle has lower high on both sides for a swing high (ICT/BPI style).")
ss_h1_prefix              = input.string("1hr", "1h label prefix",  inline="pfx", group=GRP_SWINGS)
ss_m15_prefix             = input.string("15m", "15m label prefix", inline="pfx", group=GRP_SWINGS)
ss_line_color             = input.color(color.new(color.white, 0), "Line color", inline="col", group=GRP_SWINGS)
ss_text_color             = input.color(color.new(color.white, 0), "Text color", inline="col", group=GRP_SWINGS)
ss_line_width             = input.int(1, "Line width", minval=1, maxval=4, inline="ln", group=GRP_SWINGS)
ss_line_style_s           = input.string("solid", "Line style", options=["solid","dashed","dotted"], inline="ln", group=GRP_SWINGS)
ss_show_text              = input.bool(true,  "Show labels", group=GRP_SWINGS)
ss_label_size_s           = input.string(SIZE_SMALL, "Label size", options=[SIZE_TINY, SIZE_SMALL, SIZE_NORMAL, SIZE_LARGE, SIZE_HUGE], group=GRP_SWINGS)
ss_text_pos               = input.string("Right", "Label Position", options=["Top","Bottom","Left","Right","Center"], group=GRP_SWINGS, tooltip="Where the label sits relative to the line's right end. Same options as CISD.")
ss_text_pad               = input.int(0, "Label Padding (bars)", minval=-50, maxval=50, group=GRP_SWINGS, tooltip="Extra bars added to the label's x position. Positive pushes right, negative pulls left.")
ss_line_style             = ss_line_style_s == "dashed" ? line.style_dashed : ss_line_style_s == "dotted" ? line.style_dotted : line.style_solid

// Daily & Previous Day Levels
string GRP_DAILY = "Daily Levels"
show_daily_high     = input.bool(true,  "Show Daily High",          inline="dhl",  group=GRP_DAILY)
show_daily_low      = input.bool(true,  "Show Daily Low",           inline="dhl",  group=GRP_DAILY)
daily_high_color    = input.color(color.new(color.red, 0), "Daily High Color", inline="dhlc", group=GRP_DAILY)
daily_low_color     = input.color(color.new(color.red, 0), "Daily Low Color",  inline="dhlc", group=GRP_DAILY)
show_pdh            = input.bool(true,  "Show Previous Day High",   inline="pdhl", group=GRP_DAILY)
show_pdl            = input.bool(true,  "Show Previous Day Low",    inline="pdhl", group=GRP_DAILY)
pdh_color           = input.color(color.new(color.red, 0), "PDH Color", inline="pdhlc", group=GRP_DAILY)
pdl_color           = input.color(color.new(color.red, 0), "PDL Color", inline="pdhlc", group=GRP_DAILY)
show_daily_labels   = input.bool(true, "Show Daily Text Labels", group=GRP_DAILY, tooltip="If off, lines still show but text labels are hidden.")
daily_line_width    = input.int(1, "Daily Line Width", minval=1, maxval=4, group=GRP_DAILY)
daily_line_style_in = input.string("solid", "Daily Line Style", options=["solid","dashed","dotted"], group=GRP_DAILY)
daily_label_size    = input.string(SIZE_SMALL, "Daily Label Size", options=[SIZE_TINY, SIZE_SMALL, SIZE_NORMAL, SIZE_LARGE, SIZE_HUGE], group=GRP_DAILY)
daily_label_pos_in  = input.string("Center", "Daily Label Position", options=["Above","Below","Left","Right","Center"], group=GRP_DAILY, tooltip="Where the Daily High/Low, PDH/PDL text sits relative to the end of the line. 'Center' has NO callout arrow — text sits directly at the anchor. Above/Below/Left/Right use a Pine callout label whose body visibly extends past the anchor.")
daily_label_padding = input.int(0, "Daily Label Padding (bars)", minval=0, maxval=500, group=GRP_DAILY, tooltip="Bars between the label anchor and the end of the line. 0 = text sits exactly at the line end. Increase to push text further from the line end.")
daily_line_style    = daily_line_style_in == "dashed" ? line.style_dashed : daily_line_style_in == "dotted" ? line.style_dotted : line.style_solid

// Map a friendly position string to a Pine label style.
// IMPORTANT: Pine's "callout" styles (label_up/down/left/right) render the text BODY
// visibly offset from the anchor point by a non-trivial chunk of pixels (the arrow +
// body). At low bar widths that visual offset can look like many bars of horizontal
// drift, making labels appear far past the end of their line even when the anchor is
// exactly at bar_index. "Center" (label.style_none) draws just the text with NO arrow
// or background bubble, anchored directly at the bar — use it when you want labels to
// sit right next to the line end with zero callout drift.
// "Above"  → callout label sits above the anchor (arrow points down into the level)
// "Below"  → callout label sits below the anchor (arrow points up into the level)
// "Left"   → callout label sits left of the anchor (arrow points right)
// "Right"  → callout label sits right of the anchor (arrow points left)
// "Center" → no arrow, bare text at the anchor (tightest "next to the line" look)
f_labelStyle(simple string pos) =>
    switch pos
        "Above" => label.style_label_down
        "Below" => label.style_label_up
        "Left"  => label.style_label_right
        "Right" => label.style_label_left
        "Inside-Left" => label.style_label_right   // pointer on RIGHT of text box → text sits to LEFT of anchor (inside the line)
        => label.style_none

// Session & daily label styles (derived from Position dropdowns) + padded x offsets.
// For "Left", padding moves the label to the LEFT of the anchor; otherwise to the RIGHT.
session_label_style    = f_labelStyle(session_label_pos_in)
daily_label_style      = f_labelStyle(daily_label_pos_in)
// For "Left" position mode the padding's sign is flipped (so a positive padding pushes
// further left of the anchor). For Inside-Left and all other modes the user-supplied
// offset is taken as-is: NEGATIVE = backward (left), POSITIVE = forward (right).
session_label_x_offset = session_label_pos_in == "Left" ? -session_label_padding : session_label_padding
daily_label_x_offset   = daily_label_pos_in   == "Left" ? -daily_label_padding   : daily_label_padding

// Resolve the x-anchor + label style for a session H/L label.
//  - Not swept: label at the right edge using the user's Session Label Position.
//  - Swept + enough room on the line: text reads to the LEFT of the takeout point
//    (left-pointing callout), padded by session_taken_label_pad.
//  - Swept + line too short (span < session_taken_center_thresh): text is CENTERED
//    on the line (no callout arrow) so it never overflows past the tiny line.
f_sessionLabelPos(bool taken, int level_bar, int taken_bar) =>
    int   x   = bar_index + session_label_x_offset
    string stl = session_label_style
    if taken
        int span = taken_bar - level_bar
        if session_taken_center_thresh > 0 and span < session_taken_center_thresh
            x   := int(math.round((level_bar + taken_bar) / 2.0))
            stl := label.style_none
        else
            x   := taken_bar - session_taken_label_pad
            stl := label.style_label_right
    [x, stl]

// Std-Dev CISD projections feature removed to keep the script under Pine's
// compile token cap. Will be re-added later as a leaner module.

// +---------------------------------------------------------------+
// | Main Chart Fair Value Gap (LTF, actual bars)                  |
// | Standard 3-candle FVG detected on the chart's own timeframe.  |
// | Fully customizable: fill + border colors, length, CE midline  |
// | style/color/width, background transparency, and realtime cap. |
// | Hidden by default — toggle "Show Fair Value Gaps" to enable.  |
// +---------------------------------------------------------------+
string GRP_FVG = "Main Chart FVG"
show_fvg_main        = input.bool(false, "Show Fair Value Gaps on Main Chart", group=GRP_FVG, inline="fvg_on")
fvg_max_display      = input.int(9, "Max FVGs on Chart", minval=0, maxval=50, group=GRP_FVG, inline="fvg_on", tooltip="0 = hide all. Max 50. Also uncheck 'Show Fair Value Gaps on Main Chart' to disable entirely.")
fvg_bull_color_raw   = input.color(color.white, "Bull FVG Fill (base)", inline="fvgfill", group=GRP_FVG)
fvg_bear_color_raw   = input.color(color.red,   "Bear FVG Fill (base)", inline="fvgfill", group=GRP_FVG)
fvg_bull_border_raw  = input.color(color.white, "Bull Border (base)",   inline="fvgbord", group=GRP_FVG)
fvg_bear_border_raw  = input.color(color.red,   "Bear Border (base)",   inline="fvgbord", group=GRP_FVG)
fvg_bg_transparency  = input.int(90, "Background Transparency (0 solid → 100 invisible)", minval=0, maxval=100, group=GRP_FVG)
fvg_bd_transparency  = input.int(80, "Border Transparency (0 solid → 100 invisible)",     minval=0, maxval=100, group=GRP_FVG)
fvg_length           = input.int(3, "FVG Length (bars to extend right)", minval=1, maxval=500, group=GRP_FVG)
fvg_show_ce          = input.bool(true, "Show CE (Midline)", inline="ce",  group=GRP_FVG)
fvg_ce_color         = input.color(color.white, "CE Color",   inline="ce", group=GRP_FVG)
fvg_ce_style_in      = input.string("dotted", "CE Style", options=["solid","dashed","dotted"], inline="ce2", group=GRP_FVG)
fvg_ce_width         = input.int(1, "CE Width", minval=1, maxval=4, inline="ce2", group=GRP_FVG)
fvg_ce_style = fvg_ce_style_in == "dashed" ? line.style_dashed : fvg_ce_style_in == "dotted" ? line.style_dotted : line.style_solid

// Final colors: apply transparency on top of the user's picked base color.
fvg_bull_color  = color.new(fvg_bull_color_raw,  fvg_bg_transparency)
fvg_bear_color  = color.new(fvg_bear_color_raw,  fvg_bg_transparency)
fvg_bull_border = color.new(fvg_bull_border_raw, fvg_bd_transparency)
fvg_bear_border = color.new(fvg_bear_border_raw, fvg_bd_transparency)

// IFVG (Inverse Fair Value Gap) feature removed.

// +---------------------------------------------------------------+
// | ICT OB & FVG (GK)                                             |
// | Ported from "Simple ICT OB & FVG by Gowtham Kannakaje L".     |
// | Adds mitigation-aware LTF Fair Value Gaps, Naked/Covered      |
// | Order Blocks (2/3/4-bar patterns), optional bar coloring on   |
// | OB bars, Simple mode (non-extending boxes), and alert         |
// | conditions for Bullish/Bearish OBs and FVGs.                  |
// +---------------------------------------------------------------+
string GRP_GK = "ICT OB & FVG (GK)"
gk_mitigation        = input.string("Close", "Mitigation Type", options=["Close","Wick"], group=GRP_GK, tooltip="Close = mitigated only when a candle closes through the level. Wick = mitigated if any wick pierces the level.")
gk_simple            = input.bool(false, "Simple Mode (non-extending boxes)", group=GRP_GK, tooltip="When on, OB/FVG boxes are drawn for a single bar only and don't extend right.")

gk_show_ob           = input.bool(false, "Show Order Blocks", group=GRP_GK, inline="gk_ob1", tooltip="Master toggle — turn ALL order blocks on/off. Default OFF; enable in Settings if you want OBs rendered.")
gk_ob_delete_mit     = input.bool(true,  "Delete on Mitigation", group=GRP_GK, inline="gk_ob1", tooltip="When on, mitigated OBs are deleted. When off, mitigated OBs are frozen in place.")
gk_ob_show_bull      = input.bool(true,  "  Show Buy-Side (Bull) OBs",  group=GRP_GK, inline="gk_ob_bull_sh", tooltip="Turn buy-side (bullish) order blocks on/off.")
gk_ob_max_bull       = input.int(5, "  Max Buy-Side Displayed",  minval=1, maxval=10, group=GRP_GK, inline="gk_ob_bull_sh", tooltip="How many most-recent buy-side OBs to keep on the chart (1–10). Older ones are dropped.")
gk_ob_show_bear      = input.bool(true,  "  Show Sell-Side (Bear) OBs", group=GRP_GK, inline="gk_ob_bear_sh", tooltip="Turn sell-side (bearish) order blocks on/off.")
gk_ob_max_bear       = input.int(5, "  Max Sell-Side Displayed", minval=1, maxval=10, group=GRP_GK, inline="gk_ob_bear_sh", tooltip="How many most-recent sell-side OBs to keep on the chart (1–10). Older ones are dropped.")
gk_ob_bull_color_raw  = input.color(color.green, "Bullish OB Fill (base)",   inline="gk_obfill", group=GRP_GK)
gk_ob_bear_color_raw  = input.color(color.red,   "Bearish OB Fill (base)",   inline="gk_obfill", group=GRP_GK)
gk_ob_bull_border_raw = input.color(color.green, "Bullish OB Border (base)", inline="gk_obbord", group=GRP_GK)
gk_ob_bear_border_raw = input.color(color.red,   "Bearish OB Border (base)", inline="gk_obbord", group=GRP_GK)
gk_ob_bg_transparency = input.int(90, "OB Fill Transparency (0 solid → 100 invisible)",   minval=0, maxval=100, group=GRP_GK, tooltip="Order-block fill transparency. Default 90 — very faded so OBs don't overwhelm the chart.")
gk_ob_bd_transparency = input.int(30, "OB Border Transparency (0 solid → 100 invisible)", minval=0, maxval=100, group=GRP_GK, tooltip="Order-block border transparency. Default 30 — crisp visible border.")
// Final OB colors: apply transparency on top of the user's picked base color.
gk_ob_bull_color  = color.new(gk_ob_bull_color_raw,  gk_ob_bg_transparency)
gk_ob_bear_color  = color.new(gk_ob_bear_color_raw,  gk_ob_bg_transparency)
gk_ob_bull_border = color.new(gk_ob_bull_border_raw, gk_ob_bd_transparency)
gk_ob_bear_border = color.new(gk_ob_bear_border_raw, gk_ob_bd_transparency)
gk_ob_text           = input.color(color.new(color.white, 0),  "OB Text Color",    group=GRP_GK)
gk_ob_barcolor       = input.bool(false, "Color OB Bars", group=GRP_GK, inline="gk_obbar")
gk_ob_bull_bar       = input.color(color.new(color.green, 0), "Bull Bar",         inline="gk_obbar", group=GRP_GK)
gk_ob_bear_bar       = input.color(color.new(color.red,   0), "Bear Bar",         inline="gk_obbar", group=GRP_GK)

gk_show_fvg             = input.bool(false, "Show LTF FVGs (GK)", group=GRP_GK, inline="gk_fvg1")
gk_fvg_delete_mit       = input.bool(true,  "Delete on Mitigation", group=GRP_GK, inline="gk_fvg1")
gk_fvg_bull_color_raw   = input.color(color.white, "Bullish FVG Fill (base)",   inline="gk_fvgfill", group=GRP_GK)
gk_fvg_bear_color_raw   = input.color(color.red,   "Bearish FVG Fill (base)",   inline="gk_fvgfill", group=GRP_GK)
gk_fvg_bull_border_raw  = input.color(color.white, "Bullish FVG Border (base)", inline="gk_fvgbord", group=GRP_GK)
gk_fvg_bear_border_raw  = input.color(color.red,   "Bearish FVG Border (base)", inline="gk_fvgbord", group=GRP_GK)
gk_fvg_bg_transparency  = input.int(85, "FVG Background Transparency (0 solid → 100 invisible)", minval=0, maxval=100, group=GRP_GK)
gk_fvg_bd_transparency  = input.int(30, "FVG Border Transparency (0 solid → 100 invisible)",     minval=0, maxval=100, group=GRP_GK)
gk_fvg_length           = input.int(30, "FVG Length (bars to extend right, Simple mode off)", minval=1, maxval=500, group=GRP_GK)
gk_fvg_show_ce          = input.bool(false, "Show FVG CE (Midline)", inline="gk_fvgce",  group=GRP_GK)
gk_fvg_ce_color         = input.color(color.white, "CE Color",       inline="gk_fvgce",  group=GRP_GK)
gk_fvg_ce_style_in      = input.string("dashed", "CE Style", options=["solid","dashed","dotted"], inline="gk_fvgce2", group=GRP_GK)
gk_fvg_ce_width         = input.int(1, "CE Width", minval=1, maxval=4, inline="gk_fvgce2", group=GRP_GK)
gk_fvg_ce_style = gk_fvg_ce_style_in == "dashed" ? line.style_dashed : gk_fvg_ce_style_in == "dotted" ? line.style_dotted : line.style_solid

// Final LTF GK FVG colors
gk_fvg_bull_color  = color.new(gk_fvg_bull_color_raw,  gk_fvg_bg_transparency)
gk_fvg_bear_color  = color.new(gk_fvg_bear_color_raw,  gk_fvg_bg_transparency)
gk_fvg_bull_border = color.new(gk_fvg_bull_border_raw, gk_fvg_bd_transparency)
gk_fvg_bear_border = color.new(gk_fvg_bear_border_raw, gk_fvg_bd_transparency)

// +---------------------------------------------------------------+
// | ICT HTF FVG (GK)                                              |
// | Pulls 3-bar FVGs from two higher timeframes and plots them    |
// | on the chart. Each HTF has its own timeframe + color controls.|
// +---------------------------------------------------------------+
string GRP_GKHTF = "ICT HTF FVG (GK)"
gk_htf1_show            = input.bool(false, "Show HTF1 FVG", group=GRP_GKHTF, inline="gk_htf1_on")
gk_htf1_tf              = input.string("15 Mins", "HTF1 Timeframe", options=["3 Mins","5 Mins","15 Mins","30 Mins","1 Hour","2 Hour","3 Hour","4 Hour","1 Day","1 Week","1 Month","3 Month","6 Month","1 Year"], group=GRP_GKHTF, inline="gk_htf1_on")
gk_htf1_max_count       = input.int(2, "Max HTF1 FVGs per direction", minval=1, maxval=10, group=GRP_GKHTF, tooltip="Keep only the latest N HTF1 FVGs of each direction (bull & bear tracked separately). Max 10.")
gk_htf1_length          = input.int(0, "HTF1 Box Length (chart bars, 0 = extend to current)", minval=0, maxval=500, group=GRP_GKHTF, tooltip="0 = box auto-extends right to the current bar. >0 = fixed width in chart-TF bars past the FVG origin.")
gk_htf1_bull_color_raw  = input.color(color.white, "HTF1 Bull Fill (base)",   inline="gk_htf1fill", group=GRP_GKHTF)
gk_htf1_bear_color_raw  = input.color(color.red,   "HTF1 Bear Fill (base)",   inline="gk_htf1fill", group=GRP_GKHTF)
gk_htf1_bull_border_raw = input.color(color.white, "HTF1 Bull Border (base)", inline="gk_htf1bord", group=GRP_GKHTF)
gk_htf1_bear_border_raw = input.color(color.red,   "HTF1 Bear Border (base)", inline="gk_htf1bord", group=GRP_GKHTF)
gk_htf1_bg_transparency = input.int(85, "HTF1 Background Transparency", minval=0, maxval=100, group=GRP_GKHTF)
gk_htf1_bd_transparency = input.int(30, "HTF1 Border Transparency",     minval=0, maxval=100, group=GRP_GKHTF)
gk_htf1_show_ce         = input.bool(false, "Show HTF1 CE (Midline)", inline="gk_htf1ce", group=GRP_GKHTF)
gk_htf1_ce_color        = input.color(color.white, "HTF1 CE Color",   inline="gk_htf1ce", group=GRP_GKHTF)
gk_htf1_ce_style_in     = input.string("dashed", "HTF1 CE Style", options=["solid","dashed","dotted"], inline="gk_htf1ce2", group=GRP_GKHTF)
gk_htf1_ce_width        = input.int(1, "HTF1 CE Width", minval=1, maxval=4, inline="gk_htf1ce2", group=GRP_GKHTF)
gk_htf1_ce_style = gk_htf1_ce_style_in == "dashed" ? line.style_dashed : gk_htf1_ce_style_in == "dotted" ? line.style_dotted : line.style_solid

gk_htf2_show            = input.bool(false, "Show HTF2 FVG", group=GRP_GKHTF, inline="gk_htf2_on")
gk_htf2_tf              = input.string("1 Hour", "HTF2 Timeframe", options=["3 Mins","5 Mins","15 Mins","30 Mins","1 Hour","2 Hour","3 Hour","4 Hour","1 Day","1 Week","1 Month","3 Month","6 Month","1 Year"], group=GRP_GKHTF, inline="gk_htf2_on")
gk_htf2_max_count       = input.int(2, "Max HTF2 FVGs per direction", minval=1, maxval=10, group=GRP_GKHTF, tooltip="Keep only the latest N HTF2 FVGs of each direction (bull & bear tracked separately). Max 10.")
gk_htf2_length          = input.int(0, "HTF2 Box Length (chart bars, 0 = extend to current)", minval=0, maxval=500, group=GRP_GKHTF, tooltip="0 = box auto-extends right to the current bar. >0 = fixed width in chart-TF bars past the FVG origin.")
gk_htf2_bull_color_raw  = input.color(color.white, "HTF2 Bull Fill (base)",   inline="gk_htf2fill", group=GRP_GKHTF)
gk_htf2_bear_color_raw  = input.color(color.red,   "HTF2 Bear Fill (base)",   inline="gk_htf2fill", group=GRP_GKHTF)
gk_htf2_bull_border_raw = input.color(color.white, "HTF2 Bull Border (base)", inline="gk_htf2bord", group=GRP_GKHTF)
gk_htf2_bear_border_raw = input.color(color.red,   "HTF2 Bear Border (base)", inline="gk_htf2bord", group=GRP_GKHTF)
gk_htf2_bg_transparency = input.int(85, "HTF2 Background Transparency", minval=0, maxval=100, group=GRP_GKHTF)
gk_htf2_bd_transparency = input.int(30, "HTF2 Border Transparency",     minval=0, maxval=100, group=GRP_GKHTF)
gk_htf2_show_ce         = input.bool(false, "Show HTF2 CE (Midline)", inline="gk_htf2ce", group=GRP_GKHTF)
gk_htf2_ce_color        = input.color(color.white, "HTF2 CE Color",   inline="gk_htf2ce", group=GRP_GKHTF)
gk_htf2_ce_style_in     = input.string("dashed", "HTF2 CE Style", options=["solid","dashed","dotted"], inline="gk_htf2ce2", group=GRP_GKHTF)
gk_htf2_ce_width        = input.int(1, "HTF2 CE Width", minval=1, maxval=4, inline="gk_htf2ce2", group=GRP_GKHTF)
gk_htf2_ce_style = gk_htf2_ce_style_in == "dashed" ? line.style_dashed : gk_htf2_ce_style_in == "dotted" ? line.style_dotted : line.style_solid

// Final HTF GK FVG colors
gk_htf1_bull_color  = color.new(gk_htf1_bull_color_raw,  gk_htf1_bg_transparency)
gk_htf1_bear_color  = color.new(gk_htf1_bear_color_raw,  gk_htf1_bg_transparency)
gk_htf1_bull_border = color.new(gk_htf1_bull_border_raw, gk_htf1_bd_transparency)
gk_htf1_bear_border = color.new(gk_htf1_bear_border_raw, gk_htf1_bd_transparency)
gk_htf2_bull_color  = color.new(gk_htf2_bull_color_raw,  gk_htf2_bg_transparency)
gk_htf2_bear_color  = color.new(gk_htf2_bear_color_raw,  gk_htf2_bg_transparency)
gk_htf2_bull_border = color.new(gk_htf2_bull_border_raw, gk_htf2_bd_transparency)
gk_htf2_bear_border = color.new(gk_htf2_bear_border_raw, gk_htf2_bd_transparency)

// Friendly-name → Pine timeframe code. Mirrors v5 source options.
f_gkTF(simple string _htf) =>
    switch _htf
        "3 Mins"   => "3"
        "5 Mins"   => "5"
        "15 Mins"  => "15"
        "30 Mins"  => "30"
        "1 Hour"   => "60"
        "2 Hour"   => "120"
        "3 Hour"   => "180"
        "4 Hour"   => "240"
        "1 Day"    => "D"
        "1 Week"   => "W"
        "1 Month"  => "M"
        "3 Month"  => "3M"
        "6 Month"  => "6M"
        "1 Year"   => "12M"
        => "60"

// +---------------------------------------------------------------+
// | Global Text & Color Control                                   |
// | Master override to hide every text label the indicator draws, |
// | plus per-category toggles and color pickers.                  |
// +---------------------------------------------------------------+
string GRP_TEXT = "Text & Color Control"
hide_all_labels        = input.bool(false, "Hide ALL Text Labels (master override)", group=GRP_TEXT, tooltip="When on, every text label drawn by this indicator is hidden. Lines, boxes and fills still render.")
show_session_text      = input.bool(true,  "Show Session Text (duplicate of per-session setting)", group=GRP_TEXT)
show_daily_text        = input.bool(true,  "Show Daily/PDH/PDL Text (duplicate of per-daily setting)", group=GRP_TEXT)

// Master-resolved flags. Master override wins over any individual toggle.
text_session_visible = not hide_all_labels and show_session_text and show_session_labels
text_daily_visible   = not hide_all_labels and show_daily_text   and show_daily_labels


//+------------------------------------------------------------------------------------------------------------+//
//+--- Session Levels: NY AM Range (07:00-09:30), Asia, London, Midnight & 8:30 Opens                      ---+//
//+------------------------------------------------------------------------------------------------------------+//

// --- Session state (NY AM 07:00-09:30) ---
var float ny_am_high = na
var float ny_am_low  = na
var int   ny_am_high_bar = na
var int   ny_am_low_bar  = na
var line  ny_am_high_line  = na
var line  ny_am_low_line   = na
var label ny_am_high_label = na
var label ny_am_low_label  = na
// "Taken" state: once session ended and a later wick reaches the level, freeze line at that bar
var bool  ny_am_high_taken     = false
var int   ny_am_high_taken_bar = na
var bool  ny_am_low_taken      = false
var int   ny_am_low_taken_bar  = na

// --- Asia session state ---
var float asia_high = na
var float asia_low  = na
var int   asia_high_bar = na
var int   asia_low_bar  = na
var line  asia_high_line  = na
var line  asia_low_line   = na
var label asia_high_label = na
var label asia_low_label  = na
var bool  asia_high_taken     = false
var int   asia_high_taken_bar = na
var bool  asia_low_taken      = false
var int   asia_low_taken_bar  = na

// --- London session state ---
var float london_high = na
var float london_low  = na
var int   london_high_bar = na
var int   london_low_bar  = na
var line  london_high_line  = na
var line  london_low_line   = na
var label london_high_label = na
var label london_low_label  = na
var bool  london_high_taken     = false
var int   london_high_taken_bar = na
var bool  london_low_taken      = false
var int   london_low_taken_bar  = na

// --- Midnight open state ---
var float midnight_open_price = na
var int   midnight_open_bar   = na
var line  midnight_open_line  = na
var label midnight_open_label = na

// --- 8:30 open state ---
var float open_830_price = na
var int   open_830_bar   = na
var line  open_830_line  = na
var label open_830_label = na

// Session detection via time() -- returns non-na bar time when inside the session, na otherwise
ny_am_time  = time(timeframe.period, "0700-0930", "America/New_York")
asia_time   = time(timeframe.period, asia_session_in, "America/New_York")
london_time = time(timeframe.period, london_session_in, "America/New_York")

is_ny_am  = not na(ny_am_time)
is_asia   = not na(asia_time)
is_london = not na(london_time)

is_ny_am_start  = is_ny_am  and not (is_ny_am[1])
is_asia_start   = is_asia   and not (is_asia[1])
is_london_start = is_london and not (is_london[1])

// Narrow session-window triggers for midnight and 8:30 opens (first bar of the minute-window)
midnight_sess_time = time(timeframe.period, "0000-0002", "America/New_York")
open830_sess_time  = time(timeframe.period, "0830-0832", "America/New_York")

is_midnight_start = not na(midnight_sess_time) and na(midnight_sess_time[1])
is_830_start      = not na(open830_sess_time)  and na(open830_sess_time[1])

// --- NY AM (07:00-09:30 ET) BSL/SSL ---
if show_ny_am_range and not sessions_hidden_by_tf
    if is_ny_am_start
        ny_am_high := high
        ny_am_low  := low
        ny_am_high_bar := bar_index
        ny_am_low_bar  := bar_index
        ny_am_high_taken     := false
        ny_am_high_taken_bar := na
        ny_am_low_taken      := false
        ny_am_low_taken_bar  := na
        if not na(ny_am_high_line)
            line.delete(ny_am_high_line)
            line.delete(ny_am_low_line)
            if not na(ny_am_high_label)
                label.delete(ny_am_high_label)
                ny_am_high_label := na
            if not na(ny_am_low_label)
                label.delete(ny_am_low_label)
                ny_am_low_label  := na
        ny_am_high_line  := line.new(bar_index, high, bar_index, high, color=ny_am_bsl_color, width=session_line_width, style=session_line_style)
        ny_am_low_line   := line.new(bar_index, low,  bar_index, low,  color=ny_am_ssl_color, width=session_line_width, style=session_line_style)
        // NOTE: labels are NOT created here. They are rebuilt fresh on barstate.islast
        // (see end of this block) so they can never get "stuck" at a stale bar_index.
    else if is_ny_am
        if high > ny_am_high
            ny_am_high := high
            ny_am_high_bar := bar_index
            ny_am_high_taken     := false
            ny_am_high_taken_bar := na
        if low < ny_am_low
            ny_am_low := low
            ny_am_low_bar := bar_index
            ny_am_low_taken     := false
            ny_am_low_taken_bar := na
    // Takeout detection: only AFTER the session has finalized the level
    if not is_ny_am and not na(ny_am_high_line)
        if not ny_am_high_taken and not na(ny_am_high) and high >= ny_am_high
            ny_am_high_taken     := true
            ny_am_high_taken_bar := bar_index
        if not ny_am_low_taken and not na(ny_am_low) and low <= ny_am_low
            ny_am_low_taken     := true
            ny_am_low_taken_bar := bar_index
    if not na(ny_am_high_line)
        int ny_am_h_x2 = ny_am_high_taken ? ny_am_high_taken_bar : bar_index
        int ny_am_l_x2 = ny_am_low_taken  ? ny_am_low_taken_bar  : bar_index
        line.set_xy1(ny_am_high_line, ny_am_high_bar, ny_am_high)
        line.set_xy2(ny_am_high_line, ny_am_h_x2,     ny_am_high)
        line.set_xy1(ny_am_low_line,  ny_am_low_bar,  ny_am_low)
        line.set_xy2(ny_am_low_line,  ny_am_l_x2,     ny_am_low)
    // Label rebuild on the latest bar.
    //  - If the line is FROZEN at takeout: anchor the label at the line's x2 (takeout bar)
    //    with text floating ABOVE the line for highs / BELOW for lows so it never lands on
    //    candles that traded after the sweep.
    //  - If the line is still EXTENDING to the right edge: anchor at the right edge using
    //    the user-selected session label position style.
    if barstate.islast and not na(ny_am_high_line)
        if not na(ny_am_high_label)
            label.delete(ny_am_high_label)
        if not na(ny_am_low_label)
            label.delete(ny_am_low_label)
        [ny_h_lbl_x, ny_h_lbl_stl] = f_sessionLabelPos(ny_am_high_taken, ny_am_high_bar, ny_am_high_taken_bar)
        [ny_l_lbl_x, ny_l_lbl_stl] = f_sessionLabelPos(ny_am_low_taken,  ny_am_low_bar,  ny_am_low_taken_bar)
        ny_am_high_label := label.new(ny_h_lbl_x, ny_am_high, text_session_visible ? ny_am_bsl_label_text : "", color=color.new(color.white, 100), textcolor=ny_am_bsl_color, style=ny_h_lbl_stl, size=session_label_size, text_font_family=font.family_monospace)
        ny_am_low_label  := label.new(ny_l_lbl_x, ny_am_low,  text_session_visible ? ny_am_ssl_label_text : "", color=color.new(color.white, 100), textcolor=ny_am_ssl_color, style=ny_l_lbl_stl, size=session_label_size, text_font_family=font.family_monospace)

// --- Asia High/Low ---
if show_asia_range and not sessions_hidden_by_tf
    if is_asia_start
        asia_high := high
        asia_low  := low
        asia_high_bar := bar_index
        asia_low_bar  := bar_index
        asia_high_taken     := false
        asia_high_taken_bar := na
        asia_low_taken      := false
        asia_low_taken_bar  := na
        if not na(asia_high_line)
            line.delete(asia_high_line)
            line.delete(asia_low_line)
            if not na(asia_high_label)
                label.delete(asia_high_label)
                asia_high_label := na
            if not na(asia_low_label)
                label.delete(asia_low_label)
                asia_low_label  := na
        asia_high_line  := line.new(bar_index, high, bar_index, high, color=asia_color, width=session_line_width, style=session_line_style)
        asia_low_line   := line.new(bar_index, low,  bar_index, low,  color=asia_color, width=session_line_width, style=session_line_style)
        // Labels rebuilt on barstate.islast at end of block.
    else if is_asia
        if high > asia_high
            asia_high := high
            asia_high_bar := bar_index
            asia_high_taken     := false
            asia_high_taken_bar := na
        if low < asia_low
            asia_low := low
            asia_low_bar := bar_index
            asia_low_taken     := false
            asia_low_taken_bar := na
    // Takeout detection: only AFTER the Asia session has finalized the level
    if not is_asia and not na(asia_high_line)
        if not asia_high_taken and not na(asia_high) and high >= asia_high
            asia_high_taken     := true
            asia_high_taken_bar := bar_index
        if not asia_low_taken and not na(asia_low) and low <= asia_low
            asia_low_taken     := true
            asia_low_taken_bar := bar_index
    if not na(asia_high_line)
        int asia_h_x2 = asia_high_taken ? asia_high_taken_bar : bar_index
        int asia_l_x2 = asia_low_taken  ? asia_low_taken_bar  : bar_index
        line.set_xy1(asia_high_line, asia_high_bar, asia_high)
        line.set_xy2(asia_high_line, asia_h_x2,     asia_high)
        line.set_xy1(asia_low_line,  asia_low_bar,  asia_low)
        line.set_xy2(asia_low_line,  asia_l_x2,     asia_low)
    // Label rebuild on the latest bar (frozen → at line end above/below; active → right edge).
    if barstate.islast and not na(asia_high_line)
        if not na(asia_high_label)
            label.delete(asia_high_label)
        if not na(asia_low_label)
            label.delete(asia_low_label)
        [asia_h_lbl_x, asia_h_lbl_stl] = f_sessionLabelPos(asia_high_taken, asia_high_bar, asia_high_taken_bar)
        [asia_l_lbl_x, asia_l_lbl_stl] = f_sessionLabelPos(asia_low_taken,  asia_low_bar,  asia_low_taken_bar)
        asia_high_label := label.new(asia_h_lbl_x, asia_high, text_session_visible ? asia_high_label_text : "", color=color.new(color.white, 100), textcolor=asia_color, style=asia_h_lbl_stl, size=session_label_size, text_font_family=font.family_monospace)
        asia_low_label  := label.new(asia_l_lbl_x, asia_low,  text_session_visible ? asia_low_label_text  : "", color=color.new(color.white, 100), textcolor=asia_color, style=asia_l_lbl_stl, size=session_label_size, text_font_family=font.family_monospace)

// --- London High/Low ---
if show_london_range and not sessions_hidden_by_tf
    if is_london_start
        london_high := high
        london_low  := low
        london_high_bar := bar_index
        london_low_bar  := bar_index
        london_high_taken     := false
        london_high_taken_bar := na
        london_low_taken      := false
        london_low_taken_bar  := na
        if not na(london_high_line)
            line.delete(london_high_line)
            line.delete(london_low_line)
            if not na(london_high_label)
                label.delete(london_high_label)
                london_high_label := na
            if not na(london_low_label)
                label.delete(london_low_label)
                london_low_label  := na
        london_high_line  := line.new(bar_index, high, bar_index, high, color=london_color, width=session_line_width, style=session_line_style)
        london_low_line   := line.new(bar_index, low,  bar_index, low,  color=london_color, width=session_line_width, style=session_line_style)
        // Labels rebuilt on barstate.islast at end of block.
    else if is_london
        if high > london_high
            london_high := high
            london_high_bar := bar_index
            london_high_taken     := false
            london_high_taken_bar := na
        if low < london_low
            london_low := low
            london_low_bar := bar_index
            london_low_taken     := false
            london_low_taken_bar := na
    // Takeout detection: only AFTER the London session has finalized the level
    if not is_london and not na(london_high_line)
        if not london_high_taken and not na(london_high) and high >= london_high
            london_high_taken     := true
            london_high_taken_bar := bar_index
        if not london_low_taken and not na(london_low) and low <= london_low
            london_low_taken     := true
            london_low_taken_bar := bar_index
    if not na(london_high_line)
        int london_h_x2 = london_high_taken ? london_high_taken_bar : bar_index
        int london_l_x2 = london_low_taken  ? london_low_taken_bar  : bar_index
        line.set_xy1(london_high_line, london_high_bar, london_high)
        line.set_xy2(london_high_line, london_h_x2,     london_high)
        line.set_xy1(london_low_line,  london_low_bar,  london_low)
        line.set_xy2(london_low_line,  london_l_x2,     london_low)
    // Label rebuild on the latest bar (frozen → at line end above/below; active → right edge).
    if barstate.islast and not na(london_high_line)
        if not na(london_high_label)
            label.delete(london_high_label)
        if not na(london_low_label)
            label.delete(london_low_label)
        [london_h_lbl_x, london_h_lbl_stl] = f_sessionLabelPos(london_high_taken, london_high_bar, london_high_taken_bar)
        [london_l_lbl_x, london_l_lbl_stl] = f_sessionLabelPos(london_low_taken,  london_low_bar,  london_low_taken_bar)
        london_high_label := label.new(london_h_lbl_x, london_high, text_session_visible ? london_high_label_text : "", color=color.new(color.white, 100), textcolor=london_color, style=london_h_lbl_stl, size=session_label_size, text_font_family=font.family_monospace)
        london_low_label  := label.new(london_l_lbl_x, london_low,  text_session_visible ? london_low_label_text  : "", color=color.new(color.white, 100), textcolor=london_color, style=london_l_lbl_stl, size=session_label_size, text_font_family=font.family_monospace)

// --- Midnight Open (00:00 ET) ---
if show_midnight_open
    if is_midnight_start
        midnight_open_price := open
        midnight_open_bar   := bar_index
        if not na(midnight_open_line)
            line.delete(midnight_open_line)
            if not na(midnight_open_label)
                label.delete(midnight_open_label)
                midnight_open_label := na
        midnight_open_line  := line.new(bar_index, open, bar_index, open, color=midnight_color, width=session_line_width, style=session_line_style)
        // Label rebuilt fresh on barstate.islast (right-edge anchor pattern).
    if not na(midnight_open_line)
        line.set_xy1(midnight_open_line, midnight_open_bar, midnight_open_price)
        line.set_xy2(midnight_open_line, bar_index, midnight_open_price)
    if barstate.islast and not na(midnight_open_line)
        if not na(midnight_open_label)
            label.delete(midnight_open_label)
        midnight_open_label := label.new(bar_index + session_label_x_offset, midnight_open_price, text_session_visible ? midnight_label_text : "", color=color.new(color.white, 100), textcolor=midnight_color, style=session_label_style, size=session_label_size, text_font_family=font.family_monospace)

// --- 8:30 AM Open (ET) ---
if show_830_open
    if is_830_start
        open_830_price := open
        open_830_bar   := bar_index
        if not na(open_830_line)
            line.delete(open_830_line)
            if not na(open_830_label)
                label.delete(open_830_label)
                open_830_label := na
        open_830_line  := line.new(bar_index, open, bar_index, open, color=open_830_color, width=session_line_width, style=session_line_style)
        // Label rebuilt fresh on barstate.islast (right-edge anchor pattern).
    if not na(open_830_line)
        line.set_xy1(open_830_line, open_830_bar, open_830_price)
        line.set_xy2(open_830_line, bar_index, open_830_price)
    if barstate.islast and not na(open_830_line)
        if not na(open_830_label)
            label.delete(open_830_label)
        open_830_label := label.new(bar_index + session_label_x_offset, open_830_price, text_session_visible ? open_830_label_text : "", color=color.new(color.white, 100), textcolor=open_830_color, style=session_label_style, size=session_label_size, text_font_family=font.family_monospace)


//+------------------------------------------------------------------------------------------------------------+//
//+--- Session Swings: 1h + 15m swing H/L lines, snapshotted at AM/PM session opens                          ---+//
//+------------------------------------------------------------------------------------------------------------+//
// At each session open (AM 9:30-12:00 ET; PM 13:30-15:30 ET, off by default) snapshots the
// last N (default 2) swing highs and N swing lows from each enabled source TF (1h and/or
// 15m). Each is drawn as a horizontal line anchored at its pivot bar's time, extending
// right. Lines stop extending when:
//   - price wicks OR closes through (same freeze as Asia/London/NY AM session H/L), OR
//   - the session ends.
// Lines do NOT carry over to the next day (cleared at next AM open / new-day boundary).

// --- Pull pivots from h4 / h1 / m15. The h4 / h1 / m15 _prices arrays feed model POI
//     detection downstream (ATM, Unicorn 5m). 1h and 15m feeds are also what the session-
//     anchored lines below use; we additionally keep parallel time arrays so each line
//     can be anchored at its actual pivot time on the chart.
[h4_ph,  h4_pl,  h4_pht,  h4_plt]  = request.security(syminfo.tickerid, "240",
     [ta.pivothigh(2, 2), ta.pivotlow(2, 2), time[2], time[2]],
     lookahead=barmerge.lookahead_off)
[h1_ph,  h1_pl,  h1_pht,  h1_plt]  = request.security(syminfo.tickerid, "60",
     [ta.pivothigh(ss_pivot_len, ss_pivot_len), ta.pivotlow(ss_pivot_len, ss_pivot_len),
      time[ss_pivot_len], time[ss_pivot_len]],
     lookahead=barmerge.lookahead_off)
[m15_ph, m15_pl, m15_pht, m15_plt] = request.security(syminfo.tickerid, "15",
     [ta.pivothigh(ss_pivot_len, ss_pivot_len), ta.pivotlow(ss_pivot_len, ss_pivot_len),
      time[ss_pivot_len], time[ss_pivot_len]],
     lookahead=barmerge.lookahead_off)

// --- POI price arrays (rolling, index 0 = most recent). Consumed by ATM/Unicorn POI tap detection.
var array<float> h4_sh_prices  = array.new<float>()
var array<float> h4_sl_prices  = array.new<float>()
var array<float> h1_sh_prices  = array.new<float>()
var array<float> h1_sl_prices  = array.new<float>()
var array<float> m15_sh_prices = array.new<float>()
var array<float> m15_sl_prices = array.new<float>()
// Parallel chart-bar arrays — for each detected swing, record the bar_index where the pivot
// first showed up on the chart. The session-swing lines use xloc.bar_index (same as PDH/PDL)
// so they render reliably across all chart TFs.
var array<int>   h1_sh_bars  = array.new<int>()
var array<int>   h1_sl_bars  = array.new<int>()
var array<int>   m15_sh_bars = array.new<int>()
var array<int>   m15_sl_bars = array.new<int>()
var int h4_last_pht  = na
var int h4_last_plt  = na
var int h1_last_pht  = na
var int h1_last_plt  = na
var int m15_last_pht = na
var int m15_last_plt = na

ss_pushF(array<float> arr, float v) =>
    array.unshift(arr, v)
    while array.size(arr) > 8
        array.pop(arr)
ss_pushI(array<int> arr, int v) =>
    array.unshift(arr, v)
    while array.size(arr) > 8
        array.pop(arr)

if not na(h4_ph)  and h4_pht  != h4_last_pht
    ss_pushF(h4_sh_prices,  h4_ph)
    h4_last_pht  := h4_pht
if not na(h4_pl)  and h4_plt  != h4_last_plt
    ss_pushF(h4_sl_prices,  h4_pl)
    h4_last_plt  := h4_plt
if not na(h1_ph)  and h1_pht  != h1_last_pht
    ss_pushF(h1_sh_prices,  h1_ph)
    ss_pushI(h1_sh_bars,   bar_index)
    h1_last_pht  := h1_pht
if not na(h1_pl)  and h1_plt  != h1_last_plt
    ss_pushF(h1_sl_prices,  h1_pl)
    ss_pushI(h1_sl_bars,   bar_index)
    h1_last_plt  := h1_plt
if not na(m15_ph) and m15_pht != m15_last_pht
    ss_pushF(m15_sh_prices, m15_ph)
    ss_pushI(m15_sh_bars,  bar_index)
    m15_last_pht := m15_pht
if not na(m15_pl) and m15_plt != m15_last_plt
    ss_pushF(m15_sl_prices, m15_pl)
    ss_pushI(m15_sl_bars,  bar_index)
    m15_last_plt := m15_plt

// --- Resolve dropdowns
ss_label_size_resolved = f_resolveSize(ss_label_size_s)

// --- Session window detection (chart TF)
ss_in_am      = not na(time(timeframe.period, "0930-1200", "America/New_York"))
ss_in_pm      = not na(time(timeframe.period, "1330-1530", "America/New_York"))
ss_am_started = ss_in_am and not ss_in_am[1]
ss_pm_started = ss_in_pm and not ss_in_pm[1]
ss_is_new_day = ta.change(time("D")) != 0

// --- Per-session arrays. Each entry = one swing line + label + price + done flag + isHigh flag.
var array<line>   ss_am_ln = array.new<line>(0)
var array<label>  ss_am_lb = array.new<label>(0)
var array<float>  ss_am_px = array.new<float>(0)
var array<bool>   ss_am_dn = array.new<bool>(0)
var array<bool>   ss_am_hi = array.new<bool>(0)
var array<line>   ss_pm_ln = array.new<line>(0)
var array<label>  ss_pm_lb = array.new<label>(0)
var array<float>  ss_pm_px = array.new<float>(0)
var array<bool>   ss_pm_dn = array.new<bool>(0)
var array<bool>   ss_pm_hi = array.new<bool>(0)

ss_clear(array<line> ln, array<label> lb, array<float> px, array<bool> dn, array<bool> hi) =>
    while array.size(ln) > 0
        line.delete(array.shift(ln))
    while array.size(lb) > 0
        label.delete(array.shift(lb))
    array.clear(px)
    array.clear(dn)
    array.clear(hi)

// Snapshot last-N swings from a TF source and create lines anchored at the chart bar_index
// where each pivot was first detected. Lines use +1 projection so the right end is always
// visible (matching the fix used for sweep markers).
ss_armSrc(array<line> ln, array<label> lb, array<float> px, array<bool> dn, array<bool> hi,
          array<float> srcSH, array<int> srcSHb, array<float> srcSL, array<int> srcSLb,
          string prefix, bool srcEnabled) =>
    if srcEnabled
        int xR = bar_index + 1
        int nH = math.min(ss_per_side, array.size(srcSH))
        if nH > 0
            for i = 0 to nH - 1
                float p = array.get(srcSH, i)
                int   b = array.get(srcSHb, i)
                string txt = ss_show_text ? (prefix + " SH" + str.tostring(i + 1)) : ""
                line  l   = line.new(b, p, xR, p, xloc=xloc.bar_index, color=ss_line_color, width=ss_line_width, style=ss_line_style)
                label la  = label.new(xR + ss_text_pad, p, txt, xloc=xloc.bar_index, color=color.new(color.white, 100), textcolor=ss_text_color, style=f_labelStyleX(ss_text_pos), size=ss_label_size_resolved, text_font_family=font.family_monospace)
                array.push(ln, l)
                array.push(lb, la)
                array.push(px, p)
                array.push(dn, false)
                array.push(hi, true)
        int nL = math.min(ss_per_side, array.size(srcSL))
        if nL > 0
            for i = 0 to nL - 1
                float p = array.get(srcSL, i)
                int   b = array.get(srcSLb, i)
                string txt = ss_show_text ? (prefix + " SL" + str.tostring(i + 1)) : ""
                line  l   = line.new(b, p, xR, p, xloc=xloc.bar_index, color=ss_line_color, width=ss_line_width, style=ss_line_style)
                label la  = label.new(xR + ss_text_pad, p, txt, xloc=xloc.bar_index, color=color.new(color.white, 100), textcolor=ss_text_color, style=f_labelStyleX(ss_text_pos), size=ss_label_size_resolved, text_font_family=font.family_monospace)
                array.push(ln, l)
                array.push(lb, la)
                array.push(px, p)
                array.push(dn, false)
                array.push(hi, false)

ss_update(array<line> ln, array<label> lb, array<float> px, array<bool> dn, array<bool> hi) =>
    if array.size(ln) > 0
        int xR = bar_index + 1
        for i = 0 to array.size(ln) - 1
            if not array.get(dn, i)
                float p     = array.get(px, i)
                bool  isHi  = array.get(hi, i)
                bool  taken = isHi ? (high > p or close > p) : (low < p or close < p)
                line  l     = array.get(ln, i)
                label la    = array.get(lb, i)
                line.set_x2(l, xR)
                label.set_x(la, xR + ss_text_pad)
                if taken
                    array.set(dn, i, true)

// --- Master gate. If feature is fully off, purge and exit.
if not ss_show
    ss_clear(ss_am_ln, ss_am_lb, ss_am_px, ss_am_dn, ss_am_hi)
    ss_clear(ss_pm_ln, ss_pm_lb, ss_pm_px, ss_pm_dn, ss_pm_hi)

if ss_show
    // Clear yesterday's lines at the start of each new day.
    if ss_is_new_day
        ss_clear(ss_am_ln, ss_am_lb, ss_am_px, ss_am_dn, ss_am_hi)
        ss_clear(ss_pm_ln, ss_pm_lb, ss_pm_px, ss_pm_dn, ss_pm_hi)

    // AM session: arm at 9:30, extend during window, freeze on takeout / session end.
    if ss_show_am
        if ss_am_started
            ss_clear(ss_am_ln, ss_am_lb, ss_am_px, ss_am_dn, ss_am_hi)
            ss_armSrc(ss_am_ln, ss_am_lb, ss_am_px, ss_am_dn, ss_am_hi, h1_sh_prices,  h1_sh_bars,  h1_sl_prices,  h1_sl_bars,  ss_h1_prefix,  ss_show_h1)
            ss_armSrc(ss_am_ln, ss_am_lb, ss_am_px, ss_am_dn, ss_am_hi, m15_sh_prices, m15_sh_bars, m15_sl_prices, m15_sl_bars, ss_m15_prefix, ss_show_m15)
        if ss_in_am
            ss_update(ss_am_ln, ss_am_lb, ss_am_px, ss_am_dn, ss_am_hi)
    else
        ss_clear(ss_am_ln, ss_am_lb, ss_am_px, ss_am_dn, ss_am_hi)

    // PM session: arm at 13:30, extend during window, freeze on takeout / session end.
    if ss_show_pm
        if ss_pm_started
            ss_clear(ss_pm_ln, ss_pm_lb, ss_pm_px, ss_pm_dn, ss_pm_hi)
            ss_armSrc(ss_pm_ln, ss_pm_lb, ss_pm_px, ss_pm_dn, ss_pm_hi, h1_sh_prices,  h1_sh_bars,  h1_sl_prices,  h1_sl_bars,  ss_h1_prefix,  ss_show_h1)
            ss_armSrc(ss_pm_ln, ss_pm_lb, ss_pm_px, ss_pm_dn, ss_pm_hi, m15_sh_prices, m15_sh_bars, m15_sl_prices, m15_sl_bars, ss_m15_prefix, ss_show_m15)
        if ss_in_pm
            ss_update(ss_pm_ln, ss_pm_lb, ss_pm_px, ss_pm_dn, ss_pm_hi)
    else
        ss_clear(ss_pm_ln, ss_pm_lb, ss_pm_px, ss_pm_dn, ss_pm_hi)


//+------------------------------------------------------------------------------------------------------------+//
//+--- Daily Levels: current-day high/low + previous-day high/low (live updating)                            ---+//
//+------------------------------------------------------------------------------------------------------------+//

is_new_day = ta.change(time("D")) != 0

// Running current-day H/L
var float cur_day_high = na
var float cur_day_low  = na
var int   cur_day_start_bar = na

// Previous-day snapshot
var float prev_day_high = na
var float prev_day_low  = na
var int   prev_day_start_bar = na
var int   prev_day_end_bar   = na

// Line/label handles
var line  dh_line = na
var label dh_label = na
var line  dl_line = na
var label dl_label = na
var line  pdh_line = na
var label pdh_label = na
var line  pdl_line = na
var label pdl_label = na

if is_new_day
    // snapshot yesterday
    prev_day_high := cur_day_high
    prev_day_low  := cur_day_low
    prev_day_start_bar := cur_day_start_bar
    prev_day_end_bar   := bar_index - 1
    // reset today
    cur_day_high := high
    cur_day_low  := low
    cur_day_start_bar := bar_index
    // Delete old daily lines so they're redrawn for the new day
    if not na(dh_line)
        line.delete(dh_line)
        label.delete(dh_label)
        dh_line := na
        dh_label := na
    if not na(dl_line)
        line.delete(dl_line)
        label.delete(dl_label)
        dl_line := na
        dl_label := na
    // Previous day lines: delete old, then redraw for the new "previous day"
    if not na(pdh_line)
        line.delete(pdh_line)
        label.delete(pdh_label)
        pdh_line := na
        pdh_label := na
    if not na(pdl_line)
        line.delete(pdl_line)
        label.delete(pdl_label)
        pdl_line := na
        pdl_label := na
else
    cur_day_high := na(cur_day_high) ? high : math.max(cur_day_high, high)
    cur_day_low  := na(cur_day_low)  ? low  : math.min(cur_day_low,  low)
    cur_day_start_bar := na(cur_day_start_bar) ? bar_index : cur_day_start_bar

// Draw / update current-day high
if show_daily_high and not na(cur_day_high)
    if na(dh_line)
        dh_line  := line.new(cur_day_start_bar, cur_day_high, bar_index, cur_day_high, color=daily_high_color, width=daily_line_width, style=daily_line_style)
        dh_label := label.new(bar_index + daily_label_x_offset, cur_day_high, text_daily_visible ? "Daily High" : "", color=color.new(color.white, 100), textcolor=daily_high_color, style=daily_label_style, size=daily_label_size, text_font_family=font.family_monospace)
    line.set_xy1(dh_line, cur_day_start_bar, cur_day_high)
    line.set_xy2(dh_line, bar_index, cur_day_high)
    label.set_xy(dh_label, bar_index + daily_label_x_offset, cur_day_high)

// Draw / update current-day low
if show_daily_low and not na(cur_day_low)
    if na(dl_line)
        dl_line  := line.new(cur_day_start_bar, cur_day_low, bar_index, cur_day_low, color=daily_low_color, width=daily_line_width, style=daily_line_style)
        dl_label := label.new(bar_index + daily_label_x_offset, cur_day_low, text_daily_visible ? "Daily Low" : "", color=color.new(color.white, 100), textcolor=daily_low_color, style=daily_label_style, size=daily_label_size, text_font_family=font.family_monospace)
    line.set_xy1(dl_line, cur_day_start_bar, cur_day_low)
    line.set_xy2(dl_line, bar_index, cur_day_low)
    label.set_xy(dl_label, bar_index + daily_label_x_offset, cur_day_low)

// Draw / update previous-day high (horizontal, extends to current bar)
if show_pdh and not na(prev_day_high)
    if na(pdh_line)
        pdh_line  := line.new(prev_day_start_bar, prev_day_high, bar_index, prev_day_high, color=pdh_color, width=daily_line_width, style=daily_line_style)
        pdh_label := label.new(bar_index + daily_label_x_offset, prev_day_high, text_daily_visible ? "PDH" : "", color=color.new(color.white, 100), textcolor=pdh_color, style=daily_label_style, size=daily_label_size, text_font_family=font.family_monospace)
    line.set_xy2(pdh_line, bar_index, prev_day_high)
    label.set_xy(pdh_label, bar_index + daily_label_x_offset, prev_day_high)

// Draw / update previous-day low
if show_pdl and not na(prev_day_low)
    if na(pdl_line)
        pdl_line  := line.new(prev_day_start_bar, prev_day_low, bar_index, prev_day_low, color=pdl_color, width=daily_line_width, style=daily_line_style)
        pdl_label := label.new(bar_index + daily_label_x_offset, prev_day_low, text_daily_visible ? "PDL" : "", color=color.new(color.white, 100), textcolor=pdl_color, style=daily_label_style, size=daily_label_size, text_font_family=font.family_monospace)
    line.set_xy2(pdl_line, bar_index, prev_day_low)
    label.set_xy(pdl_label, bar_index + daily_label_x_offset, prev_day_low)


//+------------------------------------------------------------------------------------------------------------+//
//+--- Main Chart Fair Value Gaps (LTF, actual bars)                                                          ---+//
//+------------------------------------------------------------------------------------------------------------+//
// 3-candle FVG on the chart's own timeframe. Each FVG is a box (top=upper bound, bottom=lower bound)
// with an optional CE midline. Capped at `fvg_max_display` (0 hides all, max 50). Uncheck
// `show_fvg_main` to disable entirely.

type MainFVG
    box  b
    line ce

var array<MainFVG> main_fvgs = array.new<MainFVG>()

// Only evaluate on confirmed bars so FVGs lock in once all three candles are closed.
if show_fvg_main and fvg_max_display > 0 and barstate.isconfirmed and bar_index >= 2
    // Bullish FVG: current low above the 2-bars-ago high (gap formed by middle candle).
    if low > high[2]
        float top    = low
        float bottom = high[2]
        float ce_y   = (top + bottom) / 2
        int   x1     = bar_index - 2
        int   x2     = bar_index + fvg_length
        MainFVG nfvg = MainFVG.new()
        nfvg.b  := box.new(x1, top, x2, bottom, bgcolor=fvg_bull_color, border_color=fvg_bull_border, xloc=xloc.bar_index)
        nfvg.ce := fvg_show_ce ? line.new(x1, ce_y, x2, ce_y, color=fvg_ce_color, style=fvg_ce_style, width=fvg_ce_width, xloc=xloc.bar_index) : na
        array.unshift(main_fvgs, nfvg)
        while array.size(main_fvgs) > fvg_max_display
            MainFVG oldf = array.pop(main_fvgs)
            box.delete(oldf.b)
            if not na(oldf.ce)
                line.delete(oldf.ce)
    // Bearish FVG: current high below the 2-bars-ago low.
    if high < low[2]
        float top    = low[2]
        float bottom = high
        float ce_y   = (top + bottom) / 2
        int   x1     = bar_index - 2
        int   x2     = bar_index + fvg_length
        MainFVG nfvg = MainFVG.new()
        nfvg.b  := box.new(x1, top, x2, bottom, bgcolor=fvg_bear_color, border_color=fvg_bear_border, xloc=xloc.bar_index)
        nfvg.ce := fvg_show_ce ? line.new(x1, ce_y, x2, ce_y, color=fvg_ce_color, style=fvg_ce_style, width=fvg_ce_width, xloc=xloc.bar_index) : na
        array.unshift(main_fvgs, nfvg)
        while array.size(main_fvgs) > fvg_max_display
            MainFVG oldf = array.pop(main_fvgs)
            box.delete(oldf.b)
            if not na(oldf.ce)
                line.delete(oldf.ce)

// When the user drops the cap or unchecks the toggle, purge any extras.
if array.size(main_fvgs) > fvg_max_display or not show_fvg_main
    while array.size(main_fvgs) > fvg_max_display or (not show_fvg_main and array.size(main_fvgs) > 0)
        MainFVG oldf = array.pop(main_fvgs)
        box.delete(oldf.b)
        if not na(oldf.ce)
            line.delete(oldf.ce)


//+------------------------------------------------------------------------------------------------------------+//
//+--- ICT OB & FVG (GK) — ported from "Simple ICT OB & FVG by Gowtham Kannakaje L"                           ---+//
//+------------------------------------------------------------------------------------------------------------+//
// LTF Fair Value Gaps and Order Blocks on the chart timeframe. Order Blocks use the classic GK
// patterns: Naked OB (2-bar), Covered OB (3-bar with validity), Covered OB (4-bar with validity).
// Mitigation type (Close/Wick) is user-selectable; on mitigation the box is either deleted or
// frozen (no longer extends right), depending on the "Delete on Mitigation" toggle. Optional bar
// coloring on OB origin bars. HTF1 + HTF2 FVGs below via request.security.

// --- Mitigation reference levels
gk_mit_lo = gk_mitigation == "Close" ? close[1] : low
gk_mit_hi = gk_mitigation == "Close" ? close[1] : high

// --- LTF FVG detection (3-bar, standard)
gk_bull_fvg_raw = (low - high[2]) > 0 and open[1] < close[1]
gk_bear_fvg_raw = (low[2] - high) > 0 and open[1] > close[1]

// --- Order Block detection (bullish variants)
// 2-bar Naked OB: bearish candle followed by bullish engulfing-style push, new FVG above
gk_ob_bull_2 = close[2] < open[2] and low[0] - high[2] > 0 and open[1] < close[1]
// 3-bar Covered OB candidate + validity
gk_ob_bull_3     = close[3] < open[3] and low[0] - high[3] > 0 and close[2] > open[2]
gk_ob_bull_3_ok  = close[2] > high[3]
// 4-bar Covered OB candidate + validity
gk_ob_bull_4     = close[4] < open[4] and low[0] - high[4] > 0 and close[3] > open[3] and close[2] > open[2]
gk_ob_bull_4_ok  = close[3] > high[4] or close[2] > high[4]

// --- Order Block detection (bearish variants)
gk_ob_bear_2 = close[2] > open[2] and low[2] - high[0] > 0 and open[1] > close[1]
gk_ob_bear_3     = close[3] > open[3] and low[3] - high[0] > 0 and close[2] < open[2]
gk_ob_bear_3_ok  = close[2] < low[3]
gk_ob_bear_4     = close[4] > open[4] and low[4] - high[0] > 0 and close[3] < open[3] and close[2] < open[2]
gk_ob_bear_4_ok  = close[3] < low[4] or close[2] < low[4]

// --- Persistent box arrays (box + parallel CE line array for FVGs)
var array<box>  gk_bull_fvg_boxes = array.new<box>()
var array<box>  gk_bear_fvg_boxes = array.new<box>()
var array<line> gk_bull_fvg_ces   = array.new<line>()
var array<line> gk_bear_fvg_ces   = array.new<line>()
var array<box>  gk_bull_ob_boxes  = array.new<box>()
var array<box>  gk_bear_ob_boxes  = array.new<box>()

gk_ext = gk_simple ? extend.none : extend.right

// --- LTF FVG: create boxes (and CE midlines) on new detection
if gk_show_fvg and gk_bull_fvg_raw and barstate.isconfirmed
    bx = box.new(bar_index - 2, high[2], bar_index, low, bgcolor=gk_fvg_bull_color, border_color=gk_fvg_bull_border, extend=gk_ext, text=gk_simple ? "" : "Bullish FVG", text_color=gk_ob_text, text_size=size.tiny, text_halign=text.align_right, text_valign=text.align_center)
    array.unshift(gk_bull_fvg_boxes, bx)
    ce_y = (high[2] + low) / 2.0
    line ce_ln = gk_fvg_show_ce ? line.new(bar_index - 2, ce_y, bar_index, ce_y, xloc=xloc.bar_index, extend=gk_ext, color=gk_fvg_ce_color, style=gk_fvg_ce_style, width=gk_fvg_ce_width) : na
    array.unshift(gk_bull_fvg_ces, ce_ln)

if gk_show_fvg and gk_bear_fvg_raw and barstate.isconfirmed
    bx = box.new(bar_index - 2, high, bar_index, low[2], bgcolor=gk_fvg_bear_color, border_color=gk_fvg_bear_border, extend=gk_ext, text=gk_simple ? "" : "Bearish FVG", text_color=gk_ob_text, text_size=size.tiny, text_halign=text.align_right, text_valign=text.align_center)
    array.unshift(gk_bear_fvg_boxes, bx)
    ce_y = (high + low[2]) / 2.0
    line ce_ln = gk_fvg_show_ce ? line.new(bar_index - 2, ce_y, bar_index, ce_y, xloc=xloc.bar_index, extend=gk_ext, color=gk_fvg_ce_color, style=gk_fvg_ce_style, width=gk_fvg_ce_width) : na
    array.unshift(gk_bear_fvg_ces, ce_ln)

// --- LTF OB: create boxes on new detection
if gk_show_ob and barstate.isconfirmed
    // ---- Buy-side (Bullish) OBs ----
    if gk_ob_show_bull
        // 2-bar Naked Bullish OB — origin bar is index-2
        if gk_ob_bull_2
            bx = box.new(bar_index - 2, high[2], bar_index, low[2], bgcolor=gk_ob_bull_color, border_color=gk_ob_bull_border, extend=gk_ext, text="", text_color=gk_ob_text, text_size=size.tiny, text_halign=text.align_right, text_valign=text.align_center)
            array.unshift(gk_bull_ob_boxes, bx)
        // 3-bar Covered Bullish OB — origin bar is index-3
        if gk_ob_bull_3 and gk_ob_bull_3_ok
            bx = box.new(bar_index - 3, high[3], bar_index, low[3], bgcolor=gk_ob_bull_color, border_color=gk_ob_bull_border, extend=gk_ext, text="", text_color=gk_ob_text, text_size=size.tiny, text_halign=text.align_right, text_valign=text.align_center)
            array.unshift(gk_bull_ob_boxes, bx)
        // 4-bar Covered Bullish OB — origin bar is index-4
        if gk_ob_bull_4 and gk_ob_bull_4_ok
            bx = box.new(bar_index - 4, high[4], bar_index, low[4], bgcolor=gk_ob_bull_color, border_color=gk_ob_bull_border, extend=gk_ext, text="", text_color=gk_ob_text, text_size=size.tiny, text_halign=text.align_right, text_valign=text.align_center)
            array.unshift(gk_bull_ob_boxes, bx)
        // Trim to max count — drop oldest (tail) so the freshest N survive
        while array.size(gk_bull_ob_boxes) > gk_ob_max_bull
            box.delete(array.pop(gk_bull_ob_boxes))

    // ---- Sell-side (Bearish) OBs ----
    if gk_ob_show_bear
        if gk_ob_bear_2
            bx = box.new(bar_index - 2, high[2], bar_index, low[2], bgcolor=gk_ob_bear_color, border_color=gk_ob_bear_border, extend=gk_ext, text="", text_color=gk_ob_text, text_size=size.tiny, text_halign=text.align_right, text_valign=text.align_center)
            array.unshift(gk_bear_ob_boxes, bx)
        if gk_ob_bear_3 and gk_ob_bear_3_ok
            bx = box.new(bar_index - 3, high[3], bar_index, low[3], bgcolor=gk_ob_bear_color, border_color=gk_ob_bear_border, extend=gk_ext, text="", text_color=gk_ob_text, text_size=size.tiny, text_halign=text.align_right, text_valign=text.align_center)
            array.unshift(gk_bear_ob_boxes, bx)
        if gk_ob_bear_4 and gk_ob_bear_4_ok
            bx = box.new(bar_index - 4, high[4], bar_index, low[4], bgcolor=gk_ob_bear_color, border_color=gk_ob_bear_border, extend=gk_ext, text="", text_color=gk_ob_text, text_size=size.tiny, text_halign=text.align_right, text_valign=text.align_center)
            array.unshift(gk_bear_ob_boxes, bx)
        while array.size(gk_bear_ob_boxes) > gk_ob_max_bear
            box.delete(array.pop(gk_bear_ob_boxes))

// --- If a side is turned off or master is off, purge any lingering boxes of that side ---
if not gk_show_ob or not gk_ob_show_bull
    while array.size(gk_bull_ob_boxes) > 0
        box.delete(array.pop(gk_bull_ob_boxes))
if not gk_show_ob or not gk_ob_show_bear
    while array.size(gk_bear_ob_boxes) > 0
        box.delete(array.pop(gk_bear_ob_boxes))
// If show_ob is on but max was lowered at runtime, trim to the new cap
if gk_show_ob and gk_ob_show_bull
    while array.size(gk_bull_ob_boxes) > gk_ob_max_bull
        box.delete(array.pop(gk_bull_ob_boxes))
if gk_show_ob and gk_ob_show_bear
    while array.size(gk_bear_ob_boxes) > gk_ob_max_bear
        box.delete(array.pop(gk_bear_ob_boxes))

// --- Extend right edge of active boxes + CE lines to current bar
if not gk_simple
    if array.size(gk_bull_fvg_boxes) > 0
        for i = 0 to array.size(gk_bull_fvg_boxes) - 1
            box.set_right(array.get(gk_bull_fvg_boxes, i), bar_index)
            ln = array.get(gk_bull_fvg_ces, i)
            if not na(ln)
                line.set_x2(ln, bar_index)
    if array.size(gk_bear_fvg_boxes) > 0
        for i = 0 to array.size(gk_bear_fvg_boxes) - 1
            box.set_right(array.get(gk_bear_fvg_boxes, i), bar_index)
            ln = array.get(gk_bear_fvg_ces, i)
            if not na(ln)
                line.set_x2(ln, bar_index)
    if array.size(gk_bull_ob_boxes) > 0
        for i = 0 to array.size(gk_bull_ob_boxes) - 1
            box.set_right(array.get(gk_bull_ob_boxes, i), bar_index)
    if array.size(gk_bear_ob_boxes) > 0
        for i = 0 to array.size(gk_bear_ob_boxes) - 1
            box.set_right(array.get(gk_bear_ob_boxes, i), bar_index)

// --- Mitigation sweep: bullish zones are mitigated when price trades back through their TOP (or bottom for bearish)
// For Bullish FVG: mitigated when gk_mit_lo <= box.top (price back-filled the gap from above)
// For Bearish FVG: mitigated when gk_mit_hi >= box.bottom
if array.size(gk_bull_fvg_boxes) > 0
    for i = array.size(gk_bull_fvg_boxes) - 1 to 0
        bx = array.get(gk_bull_fvg_boxes, i)
        if gk_mit_lo <= box.get_bottom(bx)
            ln_del = array.get(gk_bull_fvg_ces, i)
            if not na(ln_del)
                line.delete(ln_del)
            array.remove(gk_bull_fvg_ces, i)
            if gk_fvg_delete_mit
                box.delete(bx)
                array.remove(gk_bull_fvg_boxes, i)
            else
                box.set_right(bx, bar_index)
                box.set_extend(bx, extend.none)
                array.remove(gk_bull_fvg_boxes, i)

if array.size(gk_bear_fvg_boxes) > 0
    for i = array.size(gk_bear_fvg_boxes) - 1 to 0
        bx = array.get(gk_bear_fvg_boxes, i)
        if gk_mit_hi >= box.get_top(bx)
            ln_del = array.get(gk_bear_fvg_ces, i)
            if not na(ln_del)
                line.delete(ln_del)
            array.remove(gk_bear_fvg_ces, i)
            if gk_fvg_delete_mit
                box.delete(bx)
                array.remove(gk_bear_fvg_boxes, i)
            else
                box.set_right(bx, bar_index)
                box.set_extend(bx, extend.none)
                array.remove(gk_bear_fvg_boxes, i)

if array.size(gk_bull_ob_boxes) > 0
    for i = array.size(gk_bull_ob_boxes) - 1 to 0
        bx = array.get(gk_bull_ob_boxes, i)
        if gk_mit_lo <= box.get_bottom(bx)
            if gk_ob_delete_mit
                box.delete(bx)
                array.remove(gk_bull_ob_boxes, i)
            else
                box.set_right(bx, bar_index)
                box.set_extend(bx, extend.none)
                array.remove(gk_bull_ob_boxes, i)

if array.size(gk_bear_ob_boxes) > 0
    for i = array.size(gk_bear_ob_boxes) - 1 to 0
        bx = array.get(gk_bear_ob_boxes, i)
        if gk_mit_hi >= box.get_top(bx)
            if gk_ob_delete_mit
                box.delete(bx)
                array.remove(gk_bear_ob_boxes, i)
            else
                box.set_right(bx, bar_index)
                box.set_extend(bx, extend.none)
                array.remove(gk_bear_ob_boxes, i)

// --- Bar coloring on OB origin bars
gk_bar_col_bull_2 = gk_ob_barcolor and gk_ob_bull_2
gk_bar_col_bull_3 = gk_ob_barcolor and gk_ob_bull_3 and gk_ob_bull_3_ok
gk_bar_col_bull_4 = gk_ob_barcolor and gk_ob_bull_4 and gk_ob_bull_4_ok
gk_bar_col_bear_2 = gk_ob_barcolor and gk_ob_bear_2
gk_bar_col_bear_3 = gk_ob_barcolor and gk_ob_bear_3 and gk_ob_bear_3_ok
gk_bar_col_bear_4 = gk_ob_barcolor and gk_ob_bear_4 and gk_ob_bear_4_ok

barcolor(gk_bar_col_bull_2 ? gk_ob_bull_bar : na, offset=-2)
barcolor(gk_bar_col_bull_3 ? gk_ob_bull_bar : na, offset=-3)
barcolor(gk_bar_col_bull_4 ? gk_ob_bull_bar : na, offset=-4)
barcolor(gk_bar_col_bear_2 ? gk_ob_bear_bar : na, offset=-2)
barcolor(gk_bar_col_bear_3 ? gk_ob_bear_bar : na, offset=-3)
barcolor(gk_bar_col_bear_4 ? gk_ob_bear_bar : na, offset=-4)

// --- Alerts
gk_any_bull_ob = gk_ob_bull_2 or (gk_ob_bull_3 and gk_ob_bull_3_ok) or (gk_ob_bull_4 and gk_ob_bull_4_ok)
gk_any_bear_ob = gk_ob_bear_2 or (gk_ob_bear_3 and gk_ob_bear_3_ok) or (gk_ob_bear_4 and gk_ob_bear_4_ok)
alertcondition(gk_any_bull_ob, title="GK Bullish OB", message="Bullish Order Block detected")
alertcondition(gk_any_bear_ob, title="GK Bearish OB", message="Bearish Order Block detected")
alertcondition(gk_bull_fvg_raw, title="GK Bullish FVG", message="Bullish Fair Value Gap detected")
alertcondition(gk_bear_fvg_raw, title="GK Bearish FVG", message="Bearish Fair Value Gap detected")

//+------------------------------------------------------------------------------------------------------------+//
//+--- Opening Range Gap (9:30 AM ET) — ported from ICT Open Range Gap (fadi)                                 ---+//
//+------------------------------------------------------------------------------------------------------------+//
// The ORG is the gap between the prior session's close (16:14 ET) and the current session's
// open (09:30 ET). Inputs mirror the fadi ORG indicator: open line, close line, C.E., quadrants,
// backgrounds, fills, labels, trace, and "extend to end of day".

string GRP_ORG = "Opening Range Gap (9:30 AM)"
org_show_openrange   = input.bool(true,  "Show Open Range Gap",                        group=GRP_ORG, inline="org_on")
org_hide_above       = input.timeframe("15", "Hide above timeframe",                   group=GRP_ORG, inline="org_on")
org_max              = input.int(5, "Limit to last X days", minval=1, maxval=100,      group=GRP_ORG)
org_buffer           = input.int(10, "Extend to the right by", minval=1, maxval=100,   group=GRP_ORG)
org_factor           = input.float(5.0, "Minimum ORG size",  minval=0.0,               group=GRP_ORG, tooltip="Hide Open Range Gaps smaller than this dollar size.")
org_extend_eod       = input.bool(false, "Extend to end of day",                       group=GRP_ORG)

org_single_on        = input.bool(true,  "Use one color for all", inline="org_single", group=GRP_ORG, tooltip="When on, every ORG element (lines, C.E., quadrants, background, fill, labels) uses the single color chosen here, keeping each element's own transparency.")
org_single_color     = input.color(color.new(color.gray, 10), "",       inline="org_single", group=GRP_ORG)

org_o_color          = input.color(color.new(color.gray, 10), "Open    ",  inline="org_open",  group=GRP_ORG)
org_o_style_in       = input.string("solid", "",  options=["solid","dashed","dotted"], inline="org_open",  group=GRP_ORG)

org_c_color          = input.color(color.new(color.gray, 10), "Close   ",  inline="org_close", group=GRP_ORG)
org_c_style_in       = input.string("solid", "",  options=["solid","dashed","dotted"], inline="org_close", group=GRP_ORG)

org_ce_color         = input.color(color.new(color.red, 10),  "C.E.    ",  inline="org_ce",    group=GRP_ORG)
org_ce_style_in      = input.string("dashed",  "",  options=["solid","dashed","dotted"], inline="org_ce",  group=GRP_ORG)

org_o_trace_color    = input.color(color.new(color.gray, 10), "Trace Open", inline="org_trace", group=GRP_ORG)
org_o_trace_style_in = input.string("solid", "",  options=["solid","dashed","dotted"], inline="org_trace", group=GRP_ORG)

org_show_qdr         = input.bool(true, "Quadrants      ", inline="org_qdr", group=GRP_ORG)
org_qdr_color        = input.color(color.new(color.gray, 10), "", inline="org_qdr", group=GRP_ORG)
org_qdr_style_in     = input.string("dotted", "", options=["solid","dashed","dotted"], inline="org_qdr", group=GRP_ORG)

org_show_bg          = input.bool(true, "Background      ", inline="org_bg", group=GRP_ORG)
org_bg1              = input.color(color.new(color.blue,   90), "", inline="org_bg", group=GRP_ORG)
org_bg2              = input.color(color.new(color.green,  90), "", inline="org_bg", group=GRP_ORG)
org_bg3              = input.color(color.new(color.red,    90), "", inline="org_bg", group=GRP_ORG)
org_bg4              = input.color(color.new(color.orange, 90), "", inline="org_bg", group=GRP_ORG)

org_show_fill        = input.bool(false, "Fill             ", inline="org_fill", group=GRP_ORG)
org_fill1            = input.color(color.new(color.blue, 95), "", inline="org_fill", group=GRP_ORG)
org_fill2            = input.color(color.new(color.blue, 80), "", inline="org_fill", group=GRP_ORG)

org_show_labels_in   = input.bool(false, "Pane labels",       inline="org_label", group=GRP_ORG)
org_label_size_in    = input.string(SIZE_SMALL, "", [SIZE_TINY, SIZE_SMALL, SIZE_NORMAL, SIZE_LARGE, SIZE_HUGE], inline="org_label", group=GRP_ORG)
org_label_color      = input.color(color.gray, "",  inline="org_label", group=GRP_ORG)
org_label_bg         = input.color(color.new(color.black, 100), "", inline="org_label", group=GRP_ORG)

// Single-color override: recolor every ORG element with the chosen hue while
// preserving each element's original transparency.
if org_single_on
    org_o_color       := color.new(org_single_color, color.t(org_o_color))
    org_c_color       := color.new(org_single_color, color.t(org_c_color))
    org_ce_color      := color.new(org_single_color, color.t(org_ce_color))
    org_o_trace_color := color.new(org_single_color, color.t(org_o_trace_color))
    org_qdr_color     := color.new(org_single_color, color.t(org_qdr_color))
    org_bg1           := color.new(org_single_color, color.t(org_bg1))
    org_bg2           := color.new(org_single_color, color.t(org_bg2))
    org_bg3           := color.new(org_single_color, color.t(org_bg3))
    org_bg4           := color.new(org_single_color, color.t(org_bg4))
    org_fill1         := color.new(org_single_color, color.t(org_fill1))
    org_fill2         := color.new(org_single_color, color.t(org_fill2))
    org_label_color   := color.new(org_single_color, color.t(org_label_color))

// Master text override also applies to ORG labels
org_labels_visible   = not hide_all_labels and org_show_labels_in

// Translate style strings to line.style_* constants
lineStyleOrg(string s) =>
    switch s
        "dashed" => line.style_dashed
        "dotted" => line.style_dotted
        =>          line.style_solid

org_o_style       = lineStyleOrg(org_o_style_in)
org_c_style       = lineStyleOrg(org_c_style_in)
org_ce_style      = lineStyleOrg(org_ce_style_in)
org_o_trace_style = lineStyleOrg(org_o_trace_style_in)
org_qdr_style     = lineStyleOrg(org_qdr_style_in)

type OpenRange
    float    ropen
    float    rclose
    int      close_time
    int      open_time
    line     line_open
    line     line_open_trace
    line     line_close
    line     line_q1
    line     line_q2
    line     line_ce
    linefill lf_org1
    linefill lf_org2
    linefill lf_org3
    linefill lf_org4
    label    label_open
    label    label_q1
    label    label_ce
    label    label_q3
    label    label_close
    box      box_fill1
    box      box_fill2

var OpenRange[] org_ranges = array.new<OpenRange>()

// Should ORG draw on this chart timeframe?
orgValidTF() =>
    timeframe.in_seconds() <= timeframe.in_seconds(org_hide_above)

// Session markers (16:14 -> 09:30 ET, i.e. the overnight gap)
org_session_time = time(timeframe.period, "1614-0930", "America/New_York")
org_session_started = not na(org_session_time) and na(org_session_time[1])
org_session_ended   = na(org_session_time)     and not na(org_session_time[1])

method orgClear(OpenRange r) =>
    line.delete(r.line_open)
    line.delete(r.line_open_trace)
    line.delete(r.line_close)
    line.delete(r.line_q1)
    line.delete(r.line_q2)
    line.delete(r.line_ce)
    linefill.delete(r.lf_org1)
    linefill.delete(r.lf_org2)
    linefill.delete(r.lf_org3)
    linefill.delete(r.lf_org4)
    label.delete(r.label_open)
    label.delete(r.label_q1)
    label.delete(r.label_ce)
    label.delete(r.label_q3)
    label.delete(r.label_close)
    box.delete(r.box_fill1)
    box.delete(r.box_fill2)

method orgTerminate(OpenRange r) =>
    // Freeze drawing at current bar and remove the right-hand fill box + quadrant labels
    if not na(r.line_open)
        line.set_x2(r.line_open, time)
        line.set_x2(r.line_close, time)
        if not na(r.line_q1)
            line.set_x2(r.line_q1, time)
        if not na(r.line_q2)
            line.set_x2(r.line_q2, time)
        line.set_x2(r.line_ce, time)
    box.delete(r.box_fill1)
    box.delete(r.box_fill2)
    label.delete(r.label_open)
    label.delete(r.label_q1)
    label.delete(r.label_ce)
    label.delete(r.label_q3)
    label.delete(r.label_close)

method orgUpdateFill(OpenRange r) =>
    if not na(r.box_fill2)
        if r.ropen < r.rclose
            if box.get_bottom(r.box_fill2) >= r.ropen and low < box.get_bottom(r.box_fill2)
                box.set_bottom(r.box_fill2, math.max(low, r.ropen))
                box.set_bottom(r.box_fill1, box.get_bottom(r.box_fill2))
        else
            if box.get_bottom(r.box_fill2) <= r.ropen and high > box.get_bottom(r.box_fill2)
                box.set_bottom(r.box_fill2, math.min(high, r.ropen))
                box.set_bottom(r.box_fill1, box.get_bottom(r.box_fill2))
    r

// ORG render loop
if orgValidTF() and org_show_openrange
    int tc = (time - time[1]) * org_buffer
    int ts = (time - time[1]) * 3

    if org_session_started
        if org_extend_eod and org_ranges.size() > 0
            old = org_ranges.first()
            old.orgTerminate()
        OpenRange nr = OpenRange.new()
        nr.ropen      := close
        nr.open_time  := time
        org_ranges.unshift(nr)

    if org_session_ended and org_ranges.size() > 0
        r = org_ranges.first()
        r.rclose     := open
        r.close_time := time

    // Render latest range
    if org_ranges.size() > 0
        r = org_ranges.first()

        // Phase 1: open-only (trace line from the 16:14 close price)
        if na(r.rclose) and not na(r.ropen)
            if na(r.line_open_trace)
                if org_labels_visible
                    r.label_open := label.new(time + tc, r.ropen, str.tostring(r.ropen, "#,##0.00") + " (open)", xloc=xloc.bar_time, textcolor=org_label_color, color=org_label_bg, size=org_label_size_in, style=label.style_label_left)
                r.line_open_trace := line.new(r.open_time, r.ropen, time + tc, r.ropen, xloc=xloc.bar_time, color=org_o_trace_color, style=org_o_trace_style)
            else
                line.set_x2(r.line_open_trace, time + tc)
                if not na(r.label_open)
                    label.set_x(r.label_open, time + tc)

        // Phase 2: full range (close recorded)
        if not na(r.rclose)
            if math.abs(r.ropen - r.rclose) >= org_factor
                if na(r.line_open)
                    float q  = math.abs(r.ropen - r.rclose) / 4
                    float q1 = r.rclose > r.ropen ? r.rclose - q        : r.ropen - q
                    float q2 = r.rclose > r.ropen ? r.rclose - (q * 2)  : r.ropen - (q * 2)
                    float q3 = r.rclose > r.ropen ? r.rclose - (q * 3)  : r.ropen - (q * 3)

                    r.line_open  := line.new(r.close_time, r.ropen,  time + tc, r.ropen,  xloc=xloc.bar_time, color=org_o_color,  style=org_o_style)
                    r.line_ce    := line.new(r.close_time, q2,       time + tc, q2,       xloc=xloc.bar_time, color=org_ce_color, style=org_ce_style)
                    r.line_close := line.new(r.close_time, r.rclose, time + tc, r.rclose, xloc=xloc.bar_time, color=org_c_color,  style=org_c_style)

                    if org_show_qdr
                        r.line_q1 := line.new(r.close_time, q1, time + tc, q1, xloc=xloc.bar_time, color=org_qdr_color, style=org_qdr_style)
                        r.line_q2 := line.new(r.close_time, q3, time + tc, q3, xloc=xloc.bar_time, color=org_qdr_color, style=org_qdr_style)

                    if org_show_bg
                        if r.ropen < r.rclose
                            if org_show_qdr
                                r.lf_org1 := linefill.new(r.line_open, r.line_q2,    org_bg1)
                                r.lf_org2 := linefill.new(r.line_q2,   r.line_ce,    org_bg2)
                                r.lf_org3 := linefill.new(r.line_ce,   r.line_q1,    org_bg3)
                                r.lf_org4 := linefill.new(r.line_q1,   r.line_close, org_bg4)
                            else
                                r.lf_org1 := linefill.new(r.line_open, r.line_ce,    org_bg1)
                                r.lf_org2 := linefill.new(r.line_ce,   r.line_close, org_bg2)
                        else
                            if org_show_qdr
                                r.lf_org1 := linefill.new(r.line_open, r.line_q1,    org_bg1)
                                r.lf_org2 := linefill.new(r.line_q1,   r.line_ce,    org_bg2)
                                r.lf_org3 := linefill.new(r.line_ce,   r.line_q2,    org_bg3)
                                r.lf_org4 := linefill.new(r.line_q2,   r.line_close, org_bg4)
                            else
                                r.lf_org1 := linefill.new(r.line_open, r.line_ce,    org_bg1)
                                r.lf_org2 := linefill.new(r.line_ce,   r.line_close, org_bg2)

                    if org_show_fill
                        r.box_fill1 := box.new(time + tc, r.ropen,  time + tc - ts, r.rclose, xloc=xloc.bar_time, border_color=org_fill1, bgcolor=org_fill1)
                        r.box_fill2 := box.new(time + tc, r.rclose, time + tc - ts, r.rclose, xloc=xloc.bar_time, border_color=org_fill2, bgcolor=org_fill2)

                    if org_labels_visible
                        if org_show_qdr
                            if r.ropen < r.rclose
                                r.label_q1 := label.new(time + tc, q1, str.tostring(q1, "#,##0.00") + " (1/4)", xloc=xloc.bar_time, textcolor=org_label_color, color=org_label_bg, size=org_label_size_in, style=label.style_label_left)
                                r.label_q3 := label.new(time + tc, q3, str.tostring(q3, "#,##0.00") + " (3/4)", xloc=xloc.bar_time, textcolor=org_label_color, color=org_label_bg, size=org_label_size_in, style=label.style_label_left)
                            else
                                r.label_q1 := label.new(time + tc, q1, str.tostring(q1, "#,##0.00") + " (3/4)", xloc=xloc.bar_time, textcolor=org_label_color, color=org_label_bg, size=org_label_size_in, style=label.style_label_left)
                                r.label_q3 := label.new(time + tc, q3, str.tostring(q3, "#,##0.00") + " (1/4)", xloc=xloc.bar_time, textcolor=org_label_color, color=org_label_bg, size=org_label_size_in, style=label.style_label_left)
                        r.label_ce    := label.new(time + tc, q2,       str.tostring(q2, "#,##0.00") + " (1/2)",  xloc=xloc.bar_time, textcolor=org_label_color, color=org_label_bg, size=org_label_size_in, style=label.style_label_left)
                        r.label_close := label.new(time + tc, r.rclose, str.tostring(r.rclose, "#,##0.00") + " (close)", xloc=xloc.bar_time, textcolor=org_label_color, color=org_label_bg, size=org_label_size_in, style=label.style_label_left)
                else
                    // Continue extending existing lines while inside the tracked window
                    in_window = org_extend_eod or (hour(time, "America/New_York") < 10 or (hour(time, "America/New_York") == 10 and minute(time, "America/New_York") == 0))
                    if in_window
                        line.set_x2(r.line_open,  time + tc)
                        if not na(r.line_open_trace)
                            line.set_x2(r.line_open_trace, r.close_time)
                        line.set_x2(r.line_close, time + tc)
                        if not na(r.line_q1)
                            line.set_x2(r.line_q1, time + tc)
                        line.set_x2(r.line_ce, time + tc)
                        if not na(r.line_q2)
                            line.set_x2(r.line_q2, time + tc)
                        if not na(r.label_open)
                            label.set_x(r.label_open, time + tc)
                        if not na(r.label_q1)
                            label.set_x(r.label_q1, time + tc)
                        if not na(r.label_ce)
                            label.set_x(r.label_ce, time + tc)
                        if not na(r.label_q3)
                            label.set_x(r.label_q3, time + tc)
                        if not na(r.label_close)
                            label.set_x(r.label_close, time + tc)
                        if not na(r.box_fill1)
                            box.set_right(r.box_fill1, time + tc)
                            box.set_left(r.box_fill1,  time + tc - ts)
                            box.set_right(r.box_fill2, time + tc)
                            box.set_left(r.box_fill2,  time + tc - ts)
                        r.orgUpdateFill()

        // Terminate range at 10:00 ET unless user asked to extend to EOD
        if not org_extend_eod and hour(time, "America/New_York") == 10 and minute(time, "America/New_York") == 0
            r.orgTerminate()

    // Enforce max history
    while org_ranges.size() > org_max
        old = org_ranges.pop()
        old.orgClear()


//+------------------------------------------------------------------------------------------------------------+//
//+--- Model Detection: ATM / Unicorn 1m / Unicorn 5m / Fractal                                             ---+//
//+------------------------------------------------------------------------------------------------------------+//
// Uses pre-computed arrays already in this script:
//   * NY AM 7-9:30 session: ny_am_high / ny_am_low  (with freeze-on-takeout logic above)
//   * 1hr/15m swings via h1_sh_prices, h1_sl_prices, m15_sh_prices, m15_sl_prices
//   * HTF FVG price levels (htfFVG_top / htfFVG_bot — fed by the new ICT HTF Candle source)
//   * Main-chart FVGs          (via MainFVG structures — used for LTF confluence)
//   * Daily / PDH / PDL: cur_day_high / cur_day_low / prev_day_high / prev_day_low
// CISD confirmation flags (ns_cisd_fired_bull/bear) come directly from the new source's
// per-bar cisd_bull_trigger/cisd_bear_trigger signals.
// Model statuses are one of: 0 = inactive, 1 = watching, 2 = long-active, 3 = short-active.
// Multiple models can be active simultaneously — the info-box renders each row independently.

// ---- Model toggle inputs (kept independent of the info-box toggle so power users can mute one model) ----
string GRP_MODELS = "Model Detection"
show_model_atm       = input.bool(true,  "Enable ATM Model (1m / 3m / 5m, 9:30-11:00 ET)", group=GRP_MODELS)
show_model_unicorn5  = input.bool(true,  "Enable Unicorn Model (shows on all TFs except 1m)", group=GRP_MODELS)
model_poi_tolerance  = input.float(0.05, "POI Proximity % (tap tolerance)", minval=0.0, maxval=5.0, step=0.01, group=GRP_MODELS, tooltip="How close price has to come to a POI level (as % of level price) to count as a 'tap'. Small values = stricter.")
model_watch_bars     = input.int(30, "Watch Persistence (bars)", minval=1, maxval=500, group=GRP_MODELS, tooltip="How long a 'watching' model stays active before reverting to inactive if no CISD fires.")

// ---- Timeframe detection ----
int tf_secs = timeframe.in_seconds(timeframe.period)
bool tf_is_1m  = tf_secs == 60
bool tf_is_3m  = tf_secs == 180
bool tf_is_5m  = tf_secs == 300
bool tf_is_15m = tf_secs == 900

// ---- Helpers ----
f_near(float px, float target, float tolPct) =>
    na(target) or na(px) ? false : math.abs(px - target) <= math.abs(target) * tolPct * 0.01

// Returns true if price touched or crossed any swing in the array this bar.
f_touchedAnyLevel(array<float> arr, float lo, float hi) =>
    bool hit = false
    if not na(arr) and array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            lv = array.get(arr, i)
            if not na(lv) and hi >= lv and lo <= lv
                hit := true
                break
    hit

// Returns true if price touched any FVG box in the array (hi/lo must intersect box range).
f_touchedAnyBox(array<box> arr, float lo, float hi) =>
    bool hit = false
    if not na(arr) and array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            bx = array.get(arr, i)
            if not na(bx)
                bt = box.get_top(bx)
                bb = box.get_bottom(bx)
                if not na(bt) and not na(bb) and hi >= bb and lo <= bt
                    hit := true
                    break
    hit

// Returns true if price swept a named level (reached past it intrabar).
f_sweptHigh(float lvl, float h) => na(lvl) or na(h) ? false : h > lvl
f_sweptLow (float lvl, float l) => na(lvl) or na(l) ? false : l < lvl

// ---- Per-model state ----
//  status: 0 inactive, 1 watching, 2 long-active, 3 short-active
//  lastUpdateBar: last bar this model was touched (used for watch persistence).
//  sweep / sig / target / conf: short strings rendered in info-box sub-rows.

var int    atm_status           = 0
var int    atm_lastBar          = na
var string atm_sweep            = ""
var string atm_sig              = ""
var string atm_target           = ""
var string atm_conf             = ""

var int    u5_status            = 0
var int    u5_lastBar           = na
var string u5_poi               = ""
var string u5_brk               = ""


// ---- Watch persistence decay: revert to inactive if no recent CISD fire ----
// NOTE: ATM has its OWN time-window-based reset (9:30-11:00 ET), so it's excluded here.
if not na(u5_lastBar) and u5_status > 0 and (bar_index - u5_lastBar) > model_watch_bars
    u5_status := 0

// ---- ATM Model (1m / 3m / 5m, post-9:30 → pre-11:00 ET) ---------------------
// Setup arms when the bar sweeps ANY ONE liquidity level (wick OR close
// through both qualify since `f_sweptHigh` only checks `high > level` and
// `f_sweptLow` only checks `low < level`):
//   SHORT side: NY AM high, PDH, 4hr SH, 1hr SH, 15m SH
//   LONG  side: NY AM low,  PDL, 4hr SL, 1hr SL, 15m SL
// While "Watching", a confirming CISD upgrades to long-active / short-active.
// At 11:00 ET the model resets to inactive regardless of state.
//
// Helper: "did the current bar sweep any level in this array of swing prices?"
f_sweptAnyHigh(array<float> arr, float h) =>
    bool any = false
    if not na(h) and array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            float lvl = array.get(arr, i)
            if not na(lvl) and h > lvl
                any := true
                break
    any
f_sweptAnyLow(array<float> arr, float l) =>
    bool any = false
    if not na(l) and array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            float lvl = array.get(arr, i)
            if not na(lvl) and l < lvl
                any := true
                break
    any

// 9:30-11:00 ET window detection on the chart timeframe
atm_window_t  = time(timeframe.period, "0930-1100", "America/New_York")
bool in_atm_window = not na(atm_window_t)

if show_model_atm and (tf_is_1m or tf_is_3m or tf_is_5m)
    // Outside the window: hard-reset model state.
    if not in_atm_window and atm_status > 0
        atm_status  := 0
        atm_lastBar := na

    if in_atm_window
        // SHORT side liquidity sweeps
        bool sweptShort =
              f_sweptHigh(ny_am_high,    high) or
              f_sweptHigh(prev_day_high, high) or
              f_sweptAnyHigh(h4_sh_prices,  high) or
              f_sweptAnyHigh(h1_sh_prices,  high) or
              f_sweptAnyHigh(m15_sh_prices, high)
        // LONG side liquidity sweeps
        bool sweptLong  =
              f_sweptLow (ny_am_low,    low ) or
              f_sweptLow (prev_day_low, low ) or
              f_sweptAnyLow (h4_sl_prices,  low ) or
              f_sweptAnyLow (h1_sl_prices,  low ) or
              f_sweptAnyLow (m15_sl_prices, low )

        // Arm "Watching" on any sweep. Repurposed string vars for the new info-box rows:
        //   atm_sweep → POI hit (label of POIs that were swept)
        //   atm_sig   → Sweep   (BSL/SSL direction)
        //   atm_target→ CISD    (+CISD / -CISD / Awaiting)
        //   atm_conf  → MSS     (Confirmed / —)
        if sweptShort and atm_status < 2
            atm_status  := 1
            atm_lastBar := bar_index
            atm_sweep   := "NY AM H / PDH / 4h-1h-15m SH"
            atm_sig     := "BSL"
            atm_target  := "Awaiting -CISD"
            atm_conf    := "—"
        if sweptLong and atm_status < 2
            atm_status  := 1
            atm_lastBar := bar_index
            atm_sweep   := "NY AM L / PDL / 4h-1h-15m SL"
            atm_sig     := "SSL"
            atm_target  := "Awaiting +CISD"
            atm_conf    := "—"

        // CISD confirmation upgrades Watching → Active. We treat a CISD inside the ATM
        // window (after a sweep) as also confirming an MSS — the close-through is a structural shift.
        if atm_status == 1 and ns_cisd_fired_bull
            atm_status  := 2
            atm_lastBar := bar_index
            atm_target  := "+CISD"
            atm_conf    := "Confirmed"
        if atm_status == 1 and ns_cisd_fired_bear
            atm_status  := 3
            atm_lastBar := bar_index
            atm_target  := "-CISD"
            atm_conf    := "Confirmed"

// ============================================================================
// Unicorn Entry Model — INFO-BOX ONLY (multi-timeframe)
// ----------------------------------------------------------------------------
// A breaker block that OVERLAPS the FVG created by the displacement leg:
//   1) Stop hunt   — liquidity taken below a swing low (bull) / above a swing
//                    high (bear) — the sweep into a POI.
//   2) Breaker     — the last opposite-color candle of that sweep move
//                    (down candle for bull, up candle for bear).
//   3) Displacement— an impulse leg leaves a 3-candle FVG, and price CLOSES
//                    THROUGH the breaker block (up for bull, down for bear).
//   4) Unicorn     — the displacement FVG sits WITHIN the breaker block's range.
// Nothing is drawn on the chart. Detection runs on FIXED timeframes
// (3m / 5m / 15m / 30m) via request.security, so the top-right info box reports
// a unicorn on those TFs no matter what chart timeframe you are viewing — with
// direction (Bullish/Bearish) and the POI/liquidity that was taken. No time
// window. Does NOT touch the CISD model feed or the ATM model.
// ============================================================================
string GRP_UNI = "Unicorn Model (info-box only)"
uni_swing    = input.int(5,    "Swing Detection (pivot bars)",     minval=1, maxval=50,  group=GRP_UNI, tooltip="Left/right bars for the swing pivots that define structure, sweeps and MSS on each monitored timeframe.")
uni_lookback = input.int(20,   "Sweep / Breaker Lookback (bars)",  minval=3, maxval=200, group=GRP_UNI, tooltip="How far back a liquidity sweep and its breaker candle may be from the confirming displacement.")
uni_dispATR  = input.float(0.0,"Min Displacement (ATR x, 0 = off)",minval=0.0, step=0.1, group=GRP_UNI, tooltip="Require the displacement FVG gap to span at least this many ATR(14). 0 disables the size filter.")
uni_poiTol   = input.float(0.15,"POI match tolerance (%)",         minval=0.0, step=0.01,group=GRP_UNI, tooltip="How close the swept swing must be to a named level (PDL/PDH, NY AM, 1H/15m/4H swing, HTF FVG) to label it that POI. Otherwise shows generic BSL/SSL.")

// Unicorn detection — pure computation (no drawing) so it is safe inside
// request.security. Returns [bull, bear, sweptPrice]; sweptPrice = the swing
// level whose liquidity was taken, classified into a named POI on the chart TF.
uni_detect() =>
    float ph = ta.pivothigh(uni_swing, uni_swing)
    float pl = ta.pivotlow(uni_swing, uni_swing)
    var float lastPH = na
    var float lastPL = na
    if not na(ph)
        lastPH := ph
    if not na(pl)
        lastPL := pl
    var int   loBar = na
    var float loPx  = na
    var float bBrkT = na
    var float bBrkB = na
    var int   hiBar = na
    var float hiPx  = na
    var float sBrkT = na
    var float sBrkB = na
    float atr = ta.atr(14)
    bool sLow  = not na(lastPL) and low  < lastPL
    bool sHigh = not na(lastPH) and high > lastPH
    // Bullish breaker = last DOWN candle of the sweep move (price later closes
    // up through it). Bearish breaker = last UP candle.
    if sLow
        loBar := bar_index
        loPx  := lastPL
        float bullBrkTop = na
        float bullBrkBot = na
        for k = 0 to uni_lookback
            if close[k] < open[k]
                bullBrkTop := high[k]
                bullBrkBot := low[k]
                break
        bBrkT := bullBrkTop
        bBrkB := bullBrkBot
    if sHigh
        hiBar := bar_index
        hiPx  := lastPH
        float bearBrkTop = na
        float bearBrkBot = na
        for k = 0 to uni_lookback
            if close[k] > open[k]
                bearBrkTop := high[k]
                bearBrkBot := low[k]
                break
        sBrkT := bearBrkTop
        sBrkB := bearBrkBot
    bool bullFVG = low > high[2]
    bool bearFVG = high < low[2]
    float bGap = low - high[2]
    float sGap = low[2] - high
    bool dispB = uni_dispATR <= 0 or na(atr) or bGap >= uni_dispATR * atr
    bool dispS = uni_dispATR <= 0 or na(atr) or sGap >= uni_dispATR * atr
    bool recentLo = not na(loBar) and (bar_index - loBar) <= uni_lookback
    bool recentHi = not na(hiBar) and (bar_index - hiBar) <= uni_lookback
    // price closes THROUGH the breaker block (up for bull, down for bear)
    bool thruB = not na(bBrkT) and close > bBrkT
    bool thruS = not na(sBrkB) and close < sBrkB
    // displacement FVG lies WITHIN the breaker block's high–low range
    bool fvgInB = not na(bBrkT) and not na(bBrkB) and bBrkB <= high[2] and low   <= bBrkT
    bool fvgInS = not na(sBrkT) and not na(sBrkB) and sBrkB <= high    and low[2] <= sBrkT
    bool bull = bullFVG and recentLo and dispB and thruB and fvgInB
    bool bear = bearFVG and recentHi and dispS and thruS and fvgInS
    // one-shot per sweep: clear the armed sweep once it resolves into a unicorn
    if bull
        loBar := na
    if bear
        hiBar := na
    float px = bull ? loPx : bear ? hiPx : na
    [bull, bear, px]

// Nearest absolute distance from px to any element of arr (na if empty).
f_nearArr(array<float> arr, float px) =>
    float best = na
    if not na(arr) and array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            float lv = array.get(arr, i)
            if not na(lv)
                float d = math.abs(lv - px)
                best := na(best) or d < best ? d : best
    best

// Classify a swept price into a named POI using chart-timeframe levels.
f_uniPoi(float px, bool bull) =>
    string lbl = bull ? "SSL" : "BSL"
    float bestD = na
    if not na(px)
        float lv1 = bull ? prev_day_low : prev_day_high
        if not na(lv1) and (na(bestD) or math.abs(lv1 - px) < bestD)
            bestD := math.abs(lv1 - px)
            lbl := bull ? "PDL" : "PDH"
        float lv2 = bull ? ny_am_low : ny_am_high
        if not na(lv2) and (na(bestD) or math.abs(lv2 - px) < bestD)
            bestD := math.abs(lv2 - px)
            lbl := bull ? "NY AM SSL" : "NY AM BSL"
        float d1 = f_nearArr(bull ? h1_sl_prices : h1_sh_prices, px)
        if not na(d1) and (na(bestD) or d1 < bestD)
            bestD := d1
            lbl := "1H swing"
        float d2 = f_nearArr(bull ? m15_sl_prices : m15_sh_prices, px)
        if not na(d2) and (na(bestD) or d2 < bestD)
            bestD := d2
            lbl := "15m swing"
        float d3 = f_nearArr(bull ? h4_sl_prices : h4_sh_prices, px)
        if not na(d3) and (na(bestD) or d3 < bestD)
            bestD := d3
            lbl := "4H swing"
        float d4 = f_nearArr(bull ? htfFVG_bot : htfFVG_top, px)
        if not na(d4) and (na(bestD) or d4 < bestD)
            bestD := d4
            lbl := "HTF FVG"
        if not na(bestD) and bestD > math.abs(px) * uni_poiTol * 0.01
            lbl := bull ? "SSL" : "BSL"
    lbl

// ---- Monitor 3m / 5m / 15m / 30m via request.security (info-box only) ----
[u3_bull,  u3_bear,  u3_px]  = request.security(syminfo.tickerid, "3",  uni_detect(), lookahead=barmerge.lookahead_off)
[u5_bull,  u5_bear,  u5_px]  = request.security(syminfo.tickerid, "5",  uni_detect(), lookahead=barmerge.lookahead_off)
[u15_bull, u15_bear, u15_px] = request.security(syminfo.tickerid, "15", uni_detect(), lookahead=barmerge.lookahead_off)
[u30_bull, u30_bear, u30_px] = request.security(syminfo.tickerid, "30", uni_detect(), lookahead=barmerge.lookahead_off)

// Latched per-TF state for the info box (dir: 0 none / 2 bull / 3 bear).
var int    ud3 = 0
var string up3 = ""
var int    ub3 = na
var int    ud5 = 0
var string up5 = ""
var int    ub5 = na
var int    ud15 = 0
var string up15 = ""
var int    ub15 = na
var int    ud30 = 0
var string up30 = ""
var int    ub30 = na

if show_model_unicorn5
    if u3_bull
        ud3 := 2
        up3 := f_uniPoi(u3_px, true)
        ub3 := bar_index
    else if u3_bear
        ud3 := 3
        up3 := f_uniPoi(u3_px, false)
        ub3 := bar_index
    if u5_bull
        ud5 := 2
        up5 := f_uniPoi(u5_px, true)
        ub5 := bar_index
    else if u5_bear
        ud5 := 3
        up5 := f_uniPoi(u5_px, false)
        ub5 := bar_index
    if u15_bull
        ud15 := 2
        up15 := f_uniPoi(u15_px, true)
        ub15 := bar_index
    else if u15_bear
        ud15 := 3
        up15 := f_uniPoi(u15_px, false)
        ub15 := bar_index
    if u30_bull
        ud30 := 2
        up30 := f_uniPoi(u30_px, true)
        ub30 := bar_index
    else if u30_bear
        ud30 := 3
        up30 := f_uniPoi(u30_px, false)
        ub30 := bar_index

// Decay each TF back to inactive after watch persistence.
if not na(ub3)  and ud3  != 0 and (bar_index - ub3)  > model_watch_bars
    ud3 := 0
if not na(ub5)  and ud5  != 0 and (bar_index - ub5)  > model_watch_bars
    ud5 := 0
if not na(ub15) and ud15 != 0 and (bar_index - ub15) > model_watch_bars
    ud15 := 0
if not na(ub30) and ud30 != 0 and (bar_index - ub30) > model_watch_bars
    ud30 := 0

bool uni_anyBull = u3_bull or u5_bull or u15_bull or u30_bull
bool uni_anyBear = u3_bear or u5_bear or u15_bear or u30_bear
alertcondition(uni_anyBull, title="Unicorn Bullish", message="Bullish Unicorn model activated (3m/5m/15m/30m)")
alertcondition(uni_anyBear, title="Unicorn Bearish", message="Bearish Unicorn model activated (3m/5m/15m/30m)")



//+------------------------------------------------------------------------------------------------------------+//
//+--- Info-box (top-right corner)                                                                          ---+//
//+------------------------------------------------------------------------------------------------------------+//
string GRP_INFOBOX = "Info Box"
// (master toggle "Show Top-Right Model Info Box" lives in the top-of-settings Display group)
infobox_bg            = input.color(color.new(color.black, 20), "Background",       group=GRP_INFOBOX)
infobox_text_color    = input.color(color.new(color.white, 0),  "Text Color",       group=GRP_INFOBOX)
infobox_header_color  = input.color(color.new(color.silver,0),  "Header Color",     group=GRP_INFOBOX)
infobox_size          = input.string(SIZE_SMALL, "Font Size", options=[SIZE_TINY, SIZE_SMALL, SIZE_NORMAL, SIZE_LARGE, SIZE_HUGE], group=GRP_INFOBOX)

f_statusDot(int st) =>
    st == 2 ? "●L" : st == 3 ? "●S" : st == 1 ? "·"  : "○"

f_statusText(int st) =>
    st == 2 ? "LONG ACTIVE" : st == 3 ? "SHORT ACTIVE" : st == 1 ? "Watching" : "Inactive"

// Color every cell in a model section based on its status:
//   2 (long active)  → green        (overrides default)
//   3 (short active) → red          (overrides default)
//   else             → caller's default (header color for section label, text color for detail rows)
f_modelColor(int st, color def) =>
    st == 2 ? color.new(color.lime, 0) : st == 3 ? color.new(color.red, 0) : def

// Table declared at script scope (NOT inside the conditional). This avoids the
// Pine v6 trap where `var table` inside a gated `if` block can lose its reference
// during partial-bar evaluations, making the table appear to vanish on price
// movement. We lazy-init on the first islast bar, then only write cells.
var table infoTbl = na

if show_top_infobox and barstate.islast
    if na(infoTbl)
        infoTbl := table.new(position.top_right, 2, 11, bgcolor=infobox_bg, border_color=color.new(color.gray, 50), frame_color=color.new(color.gray, 50), border_width=1, frame_width=1)

    szRes = f_resolveSize(infobox_size)

    // Section colors — every cell takes status color when long/short active, otherwise its
    // default (header color for the section-label cell, text color for detail-row cells).
    color cAtmH = f_modelColor(atm_status,  infobox_header_color)  // section-label cells
    color cAtmT = f_modelColor(atm_status,  infobox_text_color)    // detail-row cells
    // Unicorn is multi-TF (3m/5m/15m/30m) and reads the same on any chart TF.
    int    uniAnyDir = ud3 != 0 ? ud3 : ud5 != 0 ? ud5 : ud15 != 0 ? ud15 : ud30
    color  cUniH = f_modelColor(uniAnyDir, infobox_header_color)
    color  cUni3  = f_modelColor(ud3,  infobox_text_color)
    color  cUni5  = f_modelColor(ud5,  infobox_text_color)
    color  cUni15 = f_modelColor(ud15, infobox_text_color)
    color  cUni30 = f_modelColor(ud30, infobox_text_color)
    string tUni3  = ud3  == 2 ? "▲ Bull · " + up3  : ud3  == 3 ? "▼ Bear · " + up3  : "—"
    string tUni5  = ud5  == 2 ? "▲ Bull · " + up5  : ud5  == 3 ? "▼ Bear · " + up5  : "—"
    string tUni15 = ud15 == 2 ? "▲ Bull · " + up15 : ud15 == 3 ? "▼ Bear · " + up15 : "—"
    string tUni30 = ud30 == 2 ? "▲ Bull · " + up30 : ud30 == 3 ? "▼ Bear · " + up30 : "—"

    // Header (compact: ticker only, drop the timeframe to narrow column 0)
    table.cell(infoTbl, 0, 0, syminfo.ticker, text_color=infobox_header_color, text_size=szRes, text_font_family=font.family_monospace, bgcolor=color.new(color.black, 0))
    table.cell(infoTbl, 1, 0, "BPI Models",  text_color=infobox_header_color, text_size=szRes, text_font_family=font.family_monospace, bgcolor=color.new(color.black, 0))

    // ---- ATM section: status + POI hit / Sweep / CISD / MSS ----
    table.cell(infoTbl, 0, 1, "ATM",  text_color=cAtmH, text_size=szRes, text_font_family=font.family_monospace)
    table.cell(infoTbl, 1, 1, f_statusDot(atm_status) + " " + f_statusText(atm_status), text_color=cAtmT, text_size=szRes, text_font_family=font.family_monospace)
    table.cell(infoTbl, 0, 2, "  POI",  text_color=cAtmT, text_size=szRes, text_font_family=font.family_monospace)
    table.cell(infoTbl, 1, 2, atm_sweep  == "" ? "—" : atm_sweep,  text_color=cAtmT, text_size=szRes, text_font_family=font.family_monospace)
    table.cell(infoTbl, 0, 3, "  Swp",  text_color=cAtmT, text_size=szRes, text_font_family=font.family_monospace)
    table.cell(infoTbl, 1, 3, atm_sig    == "" ? "—" : atm_sig,    text_color=cAtmT, text_size=szRes, text_font_family=font.family_monospace)
    table.cell(infoTbl, 0, 4, "  CISD", text_color=cAtmT, text_size=szRes, text_font_family=font.family_monospace)
    table.cell(infoTbl, 1, 4, atm_target == "" ? "—" : atm_target, text_color=cAtmT, text_size=szRes, text_font_family=font.family_monospace)
    table.cell(infoTbl, 0, 5, "  MSS",  text_color=cAtmT, text_size=szRes, text_font_family=font.family_monospace)
    table.cell(infoTbl, 1, 5, atm_conf   == "" ? "—" : atm_conf,   text_color=cAtmT, text_size=szRes, text_font_family=font.family_monospace)

    // ---- Unicorn section (multi-TF; info-box only, reads on any chart TF) ----
    table.cell(infoTbl, 0, 6, "Unicorn", text_color=cUniH, text_size=szRes, text_font_family=font.family_monospace)
    table.cell(infoTbl, 1, 6, "MTF",     text_color=cUniH, text_size=szRes, text_font_family=font.family_monospace)
    table.cell(infoTbl, 0, 7, "  3m",  text_color=cUni3,  text_size=szRes, text_font_family=font.family_monospace)
    table.cell(infoTbl, 1, 7, tUni3,   text_color=cUni3,  text_size=szRes, text_font_family=font.family_monospace)
    table.cell(infoTbl, 0, 8, "  5m",  text_color=cUni5,  text_size=szRes, text_font_family=font.family_monospace)
    table.cell(infoTbl, 1, 8, tUni5,   text_color=cUni5,  text_size=szRes, text_font_family=font.family_monospace)
    table.cell(infoTbl, 0, 9, "  15m", text_color=cUni15, text_size=szRes, text_font_family=font.family_monospace)
    table.cell(infoTbl, 1, 9, tUni15,  text_color=cUni15, text_size=szRes, text_font_family=font.family_monospace)
    table.cell(infoTbl, 0, 10, "  30m",text_color=cUni30, text_size=szRes, text_font_family=font.family_monospace)
    table.cell(infoTbl, 1, 10, tUni30, text_color=cUni30, text_size=szRes, text_font_family=font.family_monospace)



//+------------------------------------------------------------------------------------------------------------+//
//+--- ICT Breakers (BOS / MSS - Market Structure) [ICTProTools]                                            ---+//
//+------------------------------------------------------------------------------------------------------------+//
// Ported verbatim (behavior-preserving) from the standalone ICTProTools indicator.
// © ICTProTools — licensed under the Mozilla Public License 2.0 (https://mozilla.org/MPL/2.0/).
// All identifiers namespaced with `brk_` to avoid collisions with the host BPI script.

// Utility Function — converts string to corresponding line style
brk_Fline(val) =>
    switch val
        'Solid'  => line.style_solid
        'Dotted' => line.style_dotted
        'Dashed' => line.style_dashed

// Custom pivot structure
type brk_piv
    float pp
    int   pi

// User Inputs
var BRK_STRU = 'Structure'

// Timeframe selection for the structure logic
brk_tfStructure = input.timeframe('', 'Timeframe', group = BRK_STRU, tooltip = 'Select the timeframe used to calculate breakers. You must be on a timeframe equal to or lower than the one selected to display the structure.')

// Number of bars left/right to identify swing points (pivot highs/lows)
brk_rlBars      = input.int(2, 'Swing Bars', 1, inline = 'piv', group = BRK_STRU, tooltip = 'Number of bars to the left and right of a candle required for it to qualify as a swing point.')

// Continuation (BOS) display settings
brk_showBos     = input.bool(true, 'Continuation (BOS)', group = BRK_STRU)
var brk_bosStyle = brk_Fline(input.string('Dotted', 'Style', ['Solid', 'Dashed', 'Dotted'], inline = 'bos', group = BRK_STRU))
brk_bosWidth    = input.int(2, '', 1, 5, inline = 'bos', group = BRK_STRU)
brk_bosBullCol  = input.color(color.teal, '', inline = 'bos', group = BRK_STRU)
brk_bosBearCol  = input.color(color.red, '', 'Define the style and width shared by both Bullish and Bearish Continuation (BOS) lines. You can assign a different color for each direction.', inline = 'bos', group = BRK_STRU)

// Breaker (MSS) display settings
brk_showMss     = input.bool(true, 'Breaker (MSS)', inline = 'breaker', group = BRK_STRU)
brk_mssMode     = input.string('Body Only', '- Type', ['Body Only', 'Body / Wick'], 'Define how a level is considered broken for MSS Break: "Body Only" requires a candle close beyond the level, while "Body or Wick" allows wick breaches too.', 'breaker', group = BRK_STRU)
var brk_mssStyle = brk_Fline(input.string('Solid', 'Style', ['Solid', 'Dashed', 'Dotted'], inline = 'mss', group = BRK_STRU))
brk_mssWidth    = input.int(2, '', 1, 5, inline = 'mss', group = BRK_STRU)
brk_mssBullCol  = input.color(color.teal, '', inline = 'mss', group = BRK_STRU)
brk_mssBearCol  = input.color(color.red, '', 'Define the style and width shared by both Bullish and Bearish Breaker (MSS) lines. You can assign a different color for each direction.', inline = 'mss', group = BRK_STRU)

// Alert Settings
var BRK_ALERT   = 'Any alert() function call'
brk_bosBullAlert = input.bool(false, '', inline = 'bos', group = BRK_ALERT)
brk_bosBullName  = input.string('Bull BOS', '', inline = 'bos', group = BRK_ALERT)
brk_bosBearAlert = input.bool(false, '', inline = 'bos', group = BRK_ALERT)
brk_bosBearName  = input.string('Bear BOS', '', tooltip = 'Enable alerts here and set a custom name for Bullish Continuation (Bull BOS) or Bearish Continuation (Bear BOS).', inline = 'bos', group = BRK_ALERT)

brk_mssBullAlert = input.bool(false, '', inline = 'mss', group = BRK_ALERT)
brk_mssBullName  = input.string('Bull MSS', '', inline = 'mss', group = BRK_ALERT)
brk_mssBearAlert = input.bool(false, '', inline = 'mss', group = BRK_ALERT)
brk_mssBearName  = input.string('Bear MSS', '', tooltip = 'Enable alerts here and set a custom name for Bullish Breaker (Bull MSS) or Bearish Breaker (Bear MSS).', inline = 'mss', group = BRK_ALERT)

// Core Logic Variables
var brk_lin = array.new_line()
var bool brk_bull = false

// Track current and new pivots
var brk_piv brk_pH  = na
var brk_piv brk_pL  = na
var brk_piv brk_nPh = na
var brk_piv brk_nPl = na
var float   brk_nPh1 = na
var float   brk_nPl1 = na

// Function: Get pivot points
brk_Fmtf() =>
    phPs = ta.pivothigh(brk_rlBars, brk_rlBars)
    plPs = ta.pivotlow(brk_rlBars, brk_rlBars)
    int phBi = na
    int plBi = na
    if not na(phPs)
        phBi := time[brk_rlBars]
    if not na(plPs)
        plBi := time[brk_rlBars]
    [phPs, phBi, plPs, plBi]

// Get HTF pivots and data
[brk_phPs, brk_phBi, brk_plPs, brk_plBi] = request.security(syminfo.tickerid, brk_tfStructure, brk_Fmtf(), lookahead = barmerge.lookahead_on)

if not na(brk_phPs)
    brk_nPh := brk_piv.new(brk_phPs, brk_phBi)
    if na(brk_pH)
        brk_pH := brk_piv.new(brk_phPs, brk_phBi)

if not na(brk_plPs)
    brk_nPl := brk_piv.new(brk_plPs, brk_plBi)
    if na(brk_pL)
        brk_pL := brk_piv.new(brk_plPs, brk_plBi)

brk_bosBull = false
brk_bosBear = false
brk_mssBull = false
brk_mssBear = false

var brk_mssBullVar = false
var brk_mssBearVar = false

// Fetch HTF close and time to compare with break levels
[brk_htfClose, brk_htfTime] = request.security(syminfo.tickerid, brk_tfStructure, [close[1], time[1]], lookahead = barmerge.lookahead_on)

brk_highCond     = brk_bull or brk_mssMode == 'Body / Wick' ? high : brk_htfClose
brk_timeHighCond = brk_bull or brk_mssMode == 'Body / Wick' ? time : brk_htfTime

if ((brk_plPs > brk_nPl1 and brk_bull) or na(brk_nPl1) or brk_plPs < brk_nPl1)
    brk_nPl1 := brk_plPs

// Check if bullish breaker or continuation is valid
brk_breakHighCond = not na(brk_pH) and brk_highCond > brk_pH.pp

// Filter for displaying structure only if current TF is lower than or equal to selected TF
brk_FtfLimit(val) =>
    timeframe.in_seconds() <= timeframe.in_seconds(val)

var brk_tfL0 = brk_FtfLimit(brk_tfStructure)

// Bullish logic
if brk_breakHighCond
    if brk_bull
        brk_bosBull := true
        if not brk_mssBullVar and brk_lin.size() > 0
            brk_lin.shift().delete()
        brk_mssBullVar := false
    else
        brk_mssBull := true
        brk_mssBullVar := true

    brk_linCon = brk_bull ? brk_showBos : brk_showMss
    brk_linCol = brk_bull ? brk_bosBullCol : brk_mssBullCol

    // Display lines
    brk_newLin = line.new(brk_pH.pi, brk_pH.pp, brk_timeHighCond, brk_pH.pp, color = brk_tfL0 and brk_linCon ? brk_linCol : na, xloc = xloc.bar_time, style = brk_bull ? brk_bosStyle : brk_mssStyle, width = brk_bull ? brk_bosWidth : brk_mssWidth)

    // Repeated alerts
    if brk_bosBullAlert and brk_bull
        alert('Bull BOS')
    else if brk_mssBullAlert and not brk_bull
        alert('Bull Breaker')

    brk_bull := true
    brk_mssBearVar := false

    brk_pH := na
    brk_pL := na

    if not na(brk_nPl1) and not na(brk_nPl)
        brk_pL := brk_piv.new(brk_nPl.pp, brk_nPl.pi)

    brk_lin.unshift(brk_newLin)

brk_lowCond     = brk_bull and brk_mssMode == 'Body Only' ? brk_htfClose : low
brk_timeLowCond = brk_bull and brk_mssMode == 'Body Only' ? brk_htfTime : time

if ((brk_phPs < brk_nPh1 and not brk_bull) or na(brk_nPh1) or brk_phPs > brk_nPh1)
    brk_nPh1 := brk_phPs

brk_breakLowCond = not na(brk_pL) and brk_lowCond < brk_pL.pp

// Bearish logic
if brk_breakLowCond
    if not brk_bull
        brk_bosBear := true
        if not brk_mssBearVar and brk_lin.size() > 0
            brk_lin.shift().delete()
        brk_mssBearVar := false
    else
        brk_mssBear := true
        brk_mssBearVar := true

    brk_linCon = brk_bull ? brk_showMss : brk_showBos
    brk_linCol = brk_bull ? brk_mssBearCol : brk_bosBearCol

    // Display lines
    brk_newLin = line.new(brk_pL.pi, brk_pL.pp, brk_timeLowCond, brk_pL.pp, color = brk_tfL0 and brk_linCon ? brk_linCol : na, xloc = xloc.bar_time, style = brk_bull ? brk_mssStyle : brk_bosStyle, width = brk_bull ? brk_mssWidth : brk_bosWidth)

    // Repeated alerts
    if brk_bosBearAlert and not brk_bull
        alert('Bear BOS')
    else if brk_mssBearAlert and brk_bull
        alert('Bear Breaker')

    brk_bull := false
    brk_mssBullVar := false

    brk_pH := na
    brk_pL := na

    if not na(brk_nPh1) and not na(brk_nPh)
        brk_pH := brk_piv.new(brk_nPh.pp, brk_nPh.pi)

    brk_lin.unshift(brk_newLin)

// Update current swing points based on newest values
if not na(brk_pH) and not na(brk_nPh) and not na(brk_nPh[1]) and brk_lin.size() > 0 and not brk_bull and brk_nPh.pp != (brk_nPh[1]).pp and brk_nPh.pi <= line.get_x2(brk_lin.first())
    brk_pH := brk_piv.new(brk_nPh.pp, brk_nPh.pi)

if not na(brk_pL) and not na(brk_nPl) and not na(brk_nPl[1]) and brk_lin.size() > 0 and brk_bull and brk_nPl.pp != (brk_nPl[1]).pp and brk_nPl.pi <= line.get_x2(brk_lin.first())
    brk_pL := brk_piv.new(brk_nPl.pp, brk_nPl.pi)

// Reset broken structure pivots once price exceeds
if not na(brk_nPh) and high > brk_nPh.pp
    brk_nPh := na

if not na(brk_nPl) and low < brk_nPl.pp
    brk_nPl := na

// Single alerts
alertcondition(brk_bosBull, 'BOS Bull', 'BOS Bull')
alertcondition(brk_bosBear, 'BOS Bear', 'BOS Bear')
alertcondition(brk_mssBull, 'MSS Bull', 'MSS Bull')
alertcondition(brk_mssBear, 'MSS Bear', 'MSS Bear')


//+------------------------------------------------------------------------------------------------------------+//
//+--- Breaker Blocks (ICT / Smart Money) — drawn PD-array zones                                            ---+//
//+------------------------------------------------------------------------------------------------------------+//
// Draws bullish/bearish breaker-block zones on the chart timeframe after a market
// structure shift, following the TTrades breaker definition:
//   Bullish breaker: Low -> High -> Lower Low -> Higher High.
//     Confirmed once price CLOSES back above the intervening swing High. The zone
//     spans from that swing High (top) down to the original swing Low (bottom).
//   Bearish breaker: High -> Low -> Higher High -> Lower Low.
//     Confirmed once price CLOSES back below the intervening swing Low. The zone
//     spans from that swing High (top) down to the swing Low (bottom).
// Structure is tracked with an internal zig-zag of alternating pivot highs/lows.
// Zones extend right until price closes through them (optional invalidation), an
// optional 50% midline is drawn, and only the most recent `Max Visible` remain.
// A breaker that overlaps the displacement FVG can be flagged as a Unicorn.
// All identifiers namespaced with `bb_` to avoid collisions with the host script.
string GRP_BB   = "Breaker Blocks"
bb_show         = input.bool(true,  "Display Breaker Blocks", group = GRP_BB, tooltip = "Master toggle for drawing breaker-block zones. Detection logic still runs so alerts keep firing.")
bb_maxVisible   = input.int(10, "Max Visible", minval = 1, maxval = 100, group = GRP_BB, tooltip = "Keep only the most recent N breaker blocks on the chart. Older ones are removed to keep the chart clean and lightweight.")
bb_swing        = input.int(5,  "Swing Detection (pivot bars)", minval = 1, maxval = 50, group = GRP_BB, tooltip = "Left/right bars used by the internal zig-zag to qualify a swing high/low. Larger = fewer, more significant breakers.")
bb_useWick      = input.bool(true, "Use Wicks (off = candle bodies)", group = GRP_BB, tooltip = "On: zones use swing high/low extremes (wicks). Off: zones use the pivot candle bodies for tighter zones.")
bb_show50       = input.bool(true, "Show 50% Line", group = GRP_BB, tooltip = "Plot a dashed line at the mid-point (50%) of each breaker block for refinement / entry anchoring.")
bb_hideInvalid  = input.bool(true, "Hide When Invalidated", group = GRP_BB, tooltip = "Remove a breaker once price closes through it in the opposite direction (bullish hidden on a close below its low, bearish on a close above its high). Off keeps invalidated zones for study/backtesting.")
bb_showLabel    = input.bool(false, "Show Zone Label", group = GRP_BB, tooltip = "Label each zone (Bull BB / Bear BB, or Unicorn when it overlaps the displacement FVG).")
bb_markUnicorn  = input.bool(true, "Highlight Unicorn (breaker + FVG overlap)", group = GRP_BB, tooltip = "When a fresh same-direction fair-value gap overlaps the breaker block's range, treat it as a Unicorn setup and use the Unicorn colour/label.")

bb_bullColRaw   = input.color(color.new(color.teal, 80), "Bullish Zone",  inline = "bbbull", group = GRP_BB)
bb_bullBordRaw  = input.color(color.new(color.teal, 40), "Border",        inline = "bbbull", group = GRP_BB)
bb_bearColRaw   = input.color(color.new(color.red, 80),  "Bearish Zone",  inline = "bbbear", group = GRP_BB)
bb_bearBordRaw  = input.color(color.new(color.red, 40),  "Border",        inline = "bbbear", group = GRP_BB)
bb_uniColRaw    = input.color(color.new(color.orange, 78), "Unicorn Zone", inline = "bbuni", group = GRP_BB)
bb_uniBordRaw   = input.color(color.new(color.orange, 20), "Border",       inline = "bbuni", group = GRP_BB)

// --- Breaker-block object ---
type bb_Block
    box   bx
    line  mid
    bool  bull
    float top
    float bot
    bool  active

var array<bb_Block> bb_list = array.new<bb_Block>()

// --- Internal zig-zag of alternating pivots (index 0 = oldest kept) ---
var array<float> bb_zP = array.new<float>()   // pivot price
var array<int>   bb_zB = array.new<int>()      // pivot bar_index
var array<bool>  bb_zH = array.new<bool>()     // true = swing high, false = swing low

// Push a pivot into the zig-zag: alternate direction, keep the more extreme when
// the same direction repeats. Arrays are passed by reference so mutation persists.
bb_push(array<float> zP, array<int> zB, array<bool> zH, float p, int b, bool isH) =>
    int n = array.size(zH)
    if n > 0 and array.get(zH, n - 1) == isH
        float lastP = array.get(zP, n - 1)
        bool  moreEx = isH ? p > lastP : p < lastP
        if moreEx
            array.set(zP, n - 1, p)
            array.set(zB, n - 1, b)
    else
        array.push(zP, p)
        array.push(zB, b)
        array.push(zH, isH)
        if array.size(zH) > 8
            array.shift(zP)
            array.shift(zB)
            array.shift(zH)

float bb_ph = ta.pivothigh(bb_swing, bb_swing)
float bb_pl = ta.pivotlow(bb_swing, bb_swing)
int   bb_pvBar = bar_index - bb_swing

if not na(bb_ph)
    bb_push(bb_zP, bb_zB, bb_zH, bb_ph, bb_pvBar, true)
if not na(bb_pl)
    bb_push(bb_zP, bb_zB, bb_zH, bb_pl, bb_pvBar, false)

// --- Pattern detection over the last three pivots ---
var int bb_lastBullB = na
var int bb_lastBearB = na

bool  bb_bullFire = false
bool  bb_bearFire = false
float bb_zTop  = na
float bb_zBot  = na
int   bb_zLeft = na

int bb_n = array.size(bb_zH)
if bb_n >= 3 and barstate.isconfirmed
    bool  h0 = array.get(bb_zH, bb_n - 1)
    bool  bb_h1 = array.get(bb_zH, bb_n - 2)
    bool  bb_h2 = array.get(bb_zH, bb_n - 3)
    float p0 = array.get(bb_zP, bb_n - 1)
    float p1 = array.get(bb_zP, bb_n - 2)
    float p2 = array.get(bb_zP, bb_n - 3)
    int   b1 = array.get(bb_zB, bb_n - 2)
    // Bullish: Low(p2) -> High(p1) -> Lower Low(p0), close back above the High.
    if (not h0) and bb_h1 and (not bb_h2) and p0 < p2 and close > p1 and b1 != bb_lastBullB
        bb_bullFire := true
        bb_lastBullB := b1
        bb_zTop  := p1
        bb_zBot  := p2
        bb_zLeft := b1
    // Bearish: High(p2) -> Low(p1) -> Higher High(p0), close back below the Low.
    if h0 and (not bb_h1) and bb_h2 and p0 > p2 and close < p1 and b1 != bb_lastBearB
        bb_bearFire := true
        bb_lastBearB := b1
        bb_zTop  := p2
        bb_zBot  := p1
        bb_zLeft := b1

// Tighten to candle bodies when wicks are disabled.
if (bb_bullFire or bb_bearFire) and not bb_useWick and not na(bb_zLeft)
    int off = bar_index - bb_zLeft
    if off >= 0 and off <= 4999
        float bodyHi = math.max(open[off], close[off])
        float bodyLo = math.min(open[off], close[off])
        bb_zTop := math.min(bb_zTop, bodyHi)
        bb_zBot := math.max(bb_zBot, bodyLo)
        if bb_zTop < bb_zBot
            float tmp = bb_zTop
            bb_zTop := bb_zBot
            bb_zBot := tmp

// --- Unicorn: fresh same-direction FVG overlapping the breaker range ---
bool bb_uni = false
if bb_markUnicorn and (bb_bullFire or bb_bearFire) and not na(bb_zLeft)
    int span = math.min(bar_index - bb_zLeft, 60)
    if span >= 0
        for k = 0 to span
            if bb_bullFire and low[k] > high[k + 2]
                if high[k + 2] <= bb_zTop and low[k] >= bb_zBot
                    bb_uni := true
                    break
            if bb_bearFire and high[k] < low[k + 2]
                if high[k] <= bb_zTop and low[k + 2] >= bb_zBot
                    bb_uni := true
                    break

// --- Create the zone ---
if bb_show and (bb_bullFire or bb_bearFire) and not na(bb_zTop) and not na(bb_zBot)
    color fillCol = bb_uni ? bb_uniColRaw : bb_bullFire ? bb_bullColRaw : bb_bearColRaw
    color bordCol = bb_uni ? bb_uniBordRaw : bb_bullFire ? bb_bullBordRaw : bb_bearBordRaw
    string zTxt = ""
    if bb_showLabel
        zTxt := bb_uni ? "Unicorn" : bb_bullFire ? "Bull BB" : "Bear BB"
    box nbx = box.new(bb_zLeft, bb_zTop, bar_index, bb_zBot, border_color = bordCol, bgcolor = fillCol, xloc = xloc.bar_index, text = zTxt, text_color = bordCol, text_size = size.tiny, text_halign = text.align_left, text_valign = bb_bullFire ? text.align_top : text.align_bottom)
    line nml = na
    if bb_show50
        float midY = (bb_zTop + bb_zBot) / 2
        nml := line.new(bb_zLeft, midY, bar_index, midY, color = bordCol, style = line.style_dashed, xloc = xloc.bar_index)
    array.push(bb_list, bb_Block.new(nbx, nml, bb_bullFire, bb_zTop, bb_zBot, true))

// --- Per-bar maintenance: extend active zones, invalidate on opposite close ---
if array.size(bb_list) > 0
    for i = array.size(bb_list) - 1 to 0
        bb_Block bbo = array.get(bb_list, i)
        if bbo.active
            bool inval = bbo.bull ? close < bbo.bot : close > bbo.top
            if inval
                bbo.active := false
                if bb_hideInvalid
                    box.delete(bbo.bx)
                    if not na(bbo.mid)
                        line.delete(bbo.mid)
                    array.remove(bb_list, i)
            else
                box.set_right(bbo.bx, bar_index)
                if not na(bbo.mid)
                    line.set_x2(bbo.mid, bar_index)

// --- Cap to the most recent `Max Visible` zones ---
while array.size(bb_list) > bb_maxVisible
    bb_Block old = array.shift(bb_list)
    box.delete(old.bx)
    if not na(old.mid)
        line.delete(old.mid)

alertcondition(bb_bullFire, "Bullish Breaker Block", "Bullish breaker block formed")
alertcondition(bb_bearFire, "Bearish Breaker Block", "Bearish breaker block formed")
alertcondition(bb_bullFire and bb_uni, "Bullish Unicorn (Breaker + FVG)", "Bullish Unicorn: breaker block overlaps displacement FVG")
alertcondition(bb_bearFire and bb_uni, "Bearish Unicorn (Breaker + FVG)", "Bearish Unicorn: breaker block overlaps displacement FVG")


//+------------------------------------------------------------------------------------------------------------+//
//+--- ICT HTF FVGs (fadi)                                                                                  ---+//
//+------------------------------------------------------------------------------------------------------------+//
// Ported (behavior-preserving) from the standalone "ICT HTF FVGs (fadi)" indicator.
// © fadizeidan — licensed under the Mozilla Public License 2.0 (https://mozilla.org/MPL/2.0/).
// All identifiers namespaced with `hfvg_` to avoid collisions with the host BPI script.
// Renders up to 6 configurable HTF fair-value gaps as boxes/labels/CE lines to the right of
// price, with mitigation handling. Independent of the BPI HTF-candle engine (does not feed models).

//+--- Types ---+//
type hfvg_Settings
    bool   CE_show
    string CE_style
    color  CE_color
    bool   Border_show
    bool   mitigated_show
    string mitigated_type
    color  mitigated_color_bull
    color  mitigated_color_bear
    bool   ltf_hide
    bool   label_show
    color  label_color
    color  label_bgcolor
    string label_size
    int    padding
    int    buffer

type hfvg_Imbalance_Settings
    bool   show
    string htf
    color  color_bull
    color  color_bear
    int    max_count

type hfvg_Imbalance
    int   open_time
    int   close_time
    float open
    float middle
    float close
    bool  mitigated
    int   mitigated_time
    line  line_middle
    label lbl
    box   box

type hfvg_ImbalanceStructure
    hfvg_Imbalance[]        imbalance
    hfvg_Imbalance_Settings settings

type hfvg_Helper
    string name = "Helper"

//+--- Settings ---+//
var hfvg_GRP = "HTF FVG (ICT)"

hfvg_Settings          hfvg_settings        = hfvg_Settings.new()
hfvg_Imbalance_Settings hfvg_HTF_1_Settings = hfvg_Imbalance_Settings.new()
hfvg_Imbalance_Settings hfvg_HTF_2_Settings = hfvg_Imbalance_Settings.new()
hfvg_Imbalance_Settings hfvg_HTF_3_Settings = hfvg_Imbalance_Settings.new()
hfvg_Imbalance_Settings hfvg_HTF_4_Settings = hfvg_Imbalance_Settings.new()
hfvg_Imbalance_Settings hfvg_HTF_5_Settings = hfvg_Imbalance_Settings.new()
hfvg_Imbalance_Settings hfvg_HTF_6_Settings = hfvg_Imbalance_Settings.new()

string hfvg_tooltip1 = "HTF FVG Settings:\n\tShow/Hide timeframe\n\tTimeframe to display\n\tBullish FVG Color\n\tBearish FVG Color\n\tMaximum number of FVGs to display"
string hfvg_tooltip2 = "Mitigated FVG Settings:\n\tShow/Hide mitigated (Applies to all).\n\tBullish FVG Color\n\tBearish FVG Color\n\tWhen to mark it as mitigated (Based on HTF timeframe, not current timeframe)"

hfvg_HTF_1_Settings.show       := input.bool(true, "", inline="htf1", group=hfvg_GRP)
hfvg_htf_1                      = input.timeframe("5", "", inline="htf1", group=hfvg_GRP)
hfvg_HTF_1_Settings.htf        := hfvg_htf_1
hfvg_HTF_1_Settings.color_bull := input.color(color.new(color.green,90), "", inline="htf1", group=hfvg_GRP)
hfvg_HTF_1_Settings.color_bear := input.color(color.new(color.blue,90), "", inline="htf1", group=hfvg_GRP)
hfvg_HTF_1_Settings.max_count  := input.int(2, "", inline="htf1", group=hfvg_GRP, tooltip = hfvg_tooltip1)

hfvg_HTF_2_Settings.show       := input.bool(true, "", inline="htf2", group=hfvg_GRP)
hfvg_htf_2                      = input.timeframe("15", "", inline="htf2", group=hfvg_GRP)
