gk_fvg_ce_style = gk_fvg_ce_style_in == "dashed" ? line.style_dashed : gk_fvg_ce_style_in == "dotted" ? line.style_dotted : line.style_solid

// Final LTF GK FVG colors
gk_fvg_bull_color  = color.new(gk_fvg_bull_color_raw,  gk_fvg_bg_transparency)
