string GRP_GK = "ICT OB & FVG (GK)"
gk_mitigation        = input.string("Close", "Mitigation Type", options=["Close","Wick"], group=GRP_GK, tooltip="Close = mitigated only when a candle closes through the level. Wick = mitigated if any wick pierces the level.")
gk_simple            = input.bool(false, "Simple Mode (non-extending boxes)", group=GRP_GK, tooltip="When on, OB/FVG boxes are drawn for a single bar only and don't extend right.")

gk_show_ob           = input.bool(false, "Show Order Blocks", group=GRP_GK, inline="gk_ob1", tooltip="Master toggle — turn ALL order blocks on/off. Default OFF; enable in Settings if you want OBs rendered.")
