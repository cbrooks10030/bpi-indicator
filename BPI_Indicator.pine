var array<FVG> htfFVGs = array.new<FVG>()
// Parallel price-level arrays for POI tap detection by ATM/Unicorn (boxes are drawn to
// the right of the live chart so we can't use them directly — we keep just the price tops/bots).
// Only HTF1's FVGs feed POI; HTF2/3/4 FVGs are visualization-only.
var array<float> htfFVG_top = array.new<float>()
var array<float> htfFVG_bot = array.new<float>()
var array<FVG> htf2_fvgs = array.new<FVG>()
var array<FVG> htf3_fvgs = array.new<FVG>()
var array<FVG> htf4_fvgs = array.new<FVG>()
var array<FVG> htf5_fvgs = array.new<FVG>()
var array<box> htfVIs = array.new<box>()
var array<box> htf2_vis = array.new<box>()
var array<box> htf3_vis = array.new<box>()
var array<box> htf4_vis = array.new<box>()
var array<box> htf5_vis = array.new<box>()

var array<line> ocLines = array.new<line>()


var array<label> activeLabels = array.new<label>()
var array<float> activeStops = array.new<float>()
var array<bool>  activeShorts = array.new<bool>()
var array<int>   activeCounts = array.new<int>()
var array<line>  activeOpenLines = array.new<line>()
var array<line>  activeMidLines  = array.new<line>()
var array<label> activeC4Labels  = array.new<label>()
var array<line>  activeC4OpenLines = array.new<line>()
var array<line>  activeC4MidLines  = array.new<line>()
var array<float> activeC3Mids      = array.new<float>()
var array<box>   activeC3Boxes     = array.new<box>()
var array<box>   activeC4Boxes     = array.new<box>()
var array<bool>  activeCisdConfirmed = array.new<bool>()
var array<bool>  activeInvalidated   = array.new<bool>()
var label lastXC2Label = na
var array<StdDevData> activeStdDevData = array.new<StdDevData>()

var array<cisdNeo> cisdLevelsBu = array.new<cisdNeo>()
var array<cisdNeo> cisdLevelsBe = array.new<cisdNeo>()

// Map a "Top/Bottom/Left/Right/Center" string to the corresponding label.style.
// Center = no callout (just text at anchor).
f_labelStyleX(simple string pos) =>
    switch pos
        "Top"    => label.style_label_down
        "Bottom" => label.style_label_up
        "Left"   => label.style_label_right
        "Right"  => label.style_label_left
        =>          label.style_none

// Old on-chart CISD visual (lines/labels) is disabled — the CISD *visual* is now
// rendered by the "CISD by tncylyv" module appended at the end of this script.
// Detection (bull_cisd_confirmed/bear_cisd_confirmed) is UNAFFECTED and still feeds
// the C2/C3/C4 + ATM + Unicorn models. Flip this to `true` to restore the old visual.
bool cisd_old_visual = false

f_cisdColor(int state) =>
    state == 0 ? pendingColor : state == 1 ? fadedColor : confirmedColor

f_cisdWidth(int state) =>
    state == 0 ? pendingWidth : state == 1 ? fadedWidth : confirmedWidth

f_cisdText(bool isBull, int state) =>
    switch state
        0 => isBull ? "+P-CISD" : "-P-CISD"
        2 => isBull ? bullStr : bearStr
        => ""

f_addCISD(bool isBull, int x1Index, float y, int state) =>
    if cisd_old_visual and showCISDNeo and not na(y) and not na(x1Index)
        if cisdMode == "Confirmed" and state != 2
            na
        else
            clrBase = isBull ? bullishBreakColor : bearishBreakColor
            clr     = state == 2 and cisdMode == "Confirmed" ? clrBase : f_cisdColor(state)
            w       = state == 2 and cisdMode == "Confirmed" ? cisdLineWidth : f_cisdWidth(state)
            txt     = f_cisdText(isBull, state)

            ln = line.new(x1Index, y, bar_index + lookAheadBars, y,
                 xloc=xloc.bar_index,
                 color=clr,
                 width=w,
                 style=cisdLineStyle)

            string txtFinal = cisd_text_show ? txt : ""
            lb = label.new(bar_index + lookAheadBars + cisd_label_pad, y, txtFinal,
                 xloc=xloc.bar_index,
                 style=f_labelStyleX(cisd_label_pos),
                 color=color.new(color.white, 100),
                 textcolor=clr,
                 size=f_resolveSize(cisd_text_size_s),
                 text_font_family=font.family_monospace)

            obj = cisdNeo.new(ln, lb, false)

            // Cap kept count: if "Keep old levels" is on, use max_cisd_keep; otherwise 1.
            int cisd_cap = max_cisd_keep == 0 ? 0 : (keepLevels ? max_cisd_keep : 1)
            if isBull
                array.push(cisdLevelsBu, obj)
                while array.size(cisdLevelsBu) > cisd_cap
                    old = array.shift(cisdLevelsBu)
                    line.delete(old.level)
                    label.delete(old.txt)
            else
                array.push(cisdLevelsBe, obj)
                while array.size(cisdLevelsBe) > cisd_cap
                    old = array.shift(cisdLevelsBe)
                    line.delete(old.level)
                    label.delete(old.txt)

f_setLastCISDStyle(bool isBull, int state) =>
    arr = isBull ? cisdLevelsBu : cisdLevelsBe
    if array.size(arr) > 0
        lastIdx = array.size(arr) - 1
        lastObj = array.get(arr, lastIdx)
        if not na(lastObj.level) and not na(lastObj.txt)
            clrBase = isBull ? bullishBreakColor : bearishBreakColor
            clr     = state == 2 and cisdMode == "Confirmed" ? clrBase : f_cisdColor(state)
            w       = state == 2 and cisdMode == "Confirmed" ? cisdLineWidth : f_cisdWidth(state)
            line.set_color(lastObj.level, clr)
            line.set_width(lastObj.level, w)
            label.set_textcolor(lastObj.txt, clr)
            label.set_text(lastObj.txt, cisd_text_show ? f_cisdText(isBull, state) : "")
            label.set_size(lastObj.txt, f_resolveSize(cisd_text_size_s))

f_removeLastPendingCISD(bool isBull) =>
    if cisdMode == "Hybrid"
        arr = isBull ? cisdLevelsBu : cisdLevelsBe
        if array.size(arr) > 0
            lastIdx = array.size(arr) - 1
            lastObj = array.get(arr, lastIdx)
            if not lastObj.completed
                if not na(lastObj.txt)
                    label.delete(lastObj.txt)
                if not na(lastObj.level)
                    line.delete(lastObj.level)
                array.pop(arr)

f_updateCISD() =>
    if array.size(cisdLevelsBu) > 0
        lastIdx = array.size(cisdLevelsBu) - 1
        lastObj = array.get(cisdLevelsBu, lastIdx)
        if not lastObj.completed
            y = line.get_y1(lastObj.level)
            line.set_x2(lastObj.level, bar_index + lookAheadBars)
            label.set_x(lastObj.txt,  bar_index + lookAheadBars + cisd_label_pad)
            if close < y
                lastObj.completed := true
                array.set(cisdLevelsBu, lastIdx, lastObj)
                if bullishAlerts
                    alert("CISD break: +CISD (close below level)")
    if array.size(cisdLevelsBe) > 0
        lastIdx = array.size(cisdLevelsBe) - 1
        lastObj = array.get(cisdLevelsBe, lastIdx)
        if not lastObj.completed
            y = line.get_y1(lastObj.level)
            line.set_x2(lastObj.level, bar_index + lookAheadBars)
            label.set_x(lastObj.txt,  bar_index + lookAheadBars + cisd_label_pad)
            if close > y
                lastObj.completed := true
                array.set(cisdLevelsBe, lastIdx, lastObj)
                if bearishAlerts
                    alert("CISD break: -CISD (close above level)")

f_updateCISD()

if timeframe.change(auto_tf)
    t0 := time
    o0 := open
    h0 := high
    l0 := low
    bull_level_fixed := na
    bull_index_fixed := na
    bear_level_fixed := na
    bear_index_fixed := na
    bull_reclaimed_current := false
    bull_reclaim_bar := na
    bear_reclaimed_current := false
    bear_reclaim_bar := na

if high >= h0
    h0 := high
if low <= l0
    l0 := low
c0 := close

if timeframe.change(auto_tf)
    o1 := o0[1]
    h1 := h0[1]
    l1 := l0[1]
    t1 := t0[1]
    c1 := close[1]

h_swept = h0 > h1 and math.max(o0, c0) < h1
l_swept = l0 < l1 and math.min(o0, c0) > l1

if timeframe.change(auto_tf)
    h_swept1 := h_swept[1]
    l_swept1 := l_swept[1]

// HTFBarTime/isNewHTFCandle must be evaluated every bar (CW10003) — keep outside the if.
HTFBarTime = time(auto_tf, "america/New_York")
isNewHTFCandle = ta.change(HTFBarTime) > 0

if showHTFCandles
    if isNewHTFCandle
        candle = Candle.new()
        candle.o := open
        candle.c := close
        candle.h := high
        candle.l := low
        candle.o_idx := bar_index
        candle.c_idx := bar_index
        candle.h_idx := bar_index
        candle.l_idx := bar_index
        candle.o_time := time
        candle.c_time := time
        candle.is_closed := false

        if array.size(htfCandles) > 0
            prevCandle = array.get(htfCandles, 0)
            prevCandle.is_closed := true
            array.set(htfCandles, 0, prevCandle)

        bull = candle.c > candle.o
        candle.body := box.new(bar_index, math.max(candle.o, candle.c), bar_index + 2, math.min(candle.o, candle.c),
                               bull ? bull_border : bear_border, 1, bgcolor=bull ? bull_body : bear_body)
        candle.wick_up := line.new(bar_index + 1, candle.h, bar_index, math.max(candle.o, candle.c), color=bull ? bull_wick : bear_wick)
        candle.wick_down := line.new(bar_index + 1, math.min(candle.o, candle.c), bar_index, candle.l, color=bull ? bull_wick : bear_wick)
        if show_htf_candle_ce
            ce_y = (candle.h + candle.l) / 2.0
            candle.ce_line := line.new(bar_index, ce_y, bar_index + 2, ce_y, color=htf_candle_ce_color, width=htf_candle_ce_width, style=htf_candle_ce_style)

        array.unshift(htfCandles, candle)

        if array.size(htfCandles) > max_htf_candles
            delCandle = array.pop(htfCandles)
            box.delete(delCandle.body)
            line.delete(delCandle.wick_up)
            line.delete(delCandle.wick_down)
            if not na(delCandle.time_label)
                label.delete(delCandle.time_label)
            if not na(delCandle.htf_time_lbl)
                label.delete(delCandle.htf_time_lbl)
            if not na(delCandle.htf_rem_lbl)
                label.delete(delCandle.htf_rem_lbl)
            if not na(delCandle.htf_int_lbl)
                label.delete(delCandle.htf_int_lbl)
            if not na(delCandle.swing_high_line)
                line.delete(delCandle.swing_high_line)
            if not na(delCandle.swing_low_line)
                line.delete(delCandle.swing_low_line)
            if not na(delCandle.ce_line)
                line.delete(delCandle.ce_line)

    if array.size(htfCandles) > 0
        candle = array.get(htfCandles, 0)
        candle.h_idx := high > candle.h ? bar_index : candle.h_idx
        candle.h := high > candle.h ? high : candle.h
        candle.l_idx := low < candle.l ? bar_index : candle.l_idx
        candle.l := low < candle.l ? low : candle.l
        candle.c := close
        candle.c_idx := bar_index
        candle.c_time := time

        bull = candle.c > candle.o
        box.set_top(candle.body, candle.o)
        box.set_bottom(candle.body, candle.c)
        box.set_bgcolor(candle.body, bull ? bull_body : bear_body)
        box.set_border_color(candle.body, bull ? bull_border : bear_border)
        line.set_color(candle.wick_up, bull ? bull_wick : bear_wick)
        line.set_color(candle.wick_down, bull ? bull_wick : bear_wick)
        line.set_y1(candle.wick_up, candle.h)
        line.set_y2(candle.wick_up, math.max(candle.o, candle.c))
        line.set_y1(candle.wick_down, candle.l)
        line.set_y2(candle.wick_down, math.min(candle.o, candle.c))

        array.set(htfCandles, 0, candle)

        if barstate.isrealtime or barstate.islast
            cdSize = array.size(htfCandles)

            if cdSize > 0
                if array.size(htfFVGs) > 0
                    for i = 0 to array.size(htfFVGs) - 1
                        fvg_del = array.get(htfFVGs, i)
                        box.delete(fvg_del.b)
                        if not na(fvg_del.ce)
                            line.delete(fvg_del.ce)
                array.clear(htfFVGs)
                array.clear(htfFVG_top)
                array.clear(htfFVG_bot)

                if array.size(htfVIs) > 0
                    for j = 0 to array.size(htfVIs) - 1
                        box.delete(array.get(htfVIs, j))
                array.clear(htfVIs)

                for i = cdSize - 1 to 0
                    c = array.get(htfCandles, i)
                    t_buffer = htf_padding + (htf_candle_width + htf_space) * (cdSize - i - 1)
                    box.set_left(c.body, bar_index + t_buffer)
                    box.set_right(c.body, bar_index + t_buffer + htf_candle_width)
                    line.set_x1(c.wick_up, bar_index + t_buffer + int(math.round(htf_candle_width/2.0)))
                    line.set_x2(c.wick_up, bar_index + t_buffer + int(math.round(htf_candle_width/2.0)))
                    line.set_x1(c.wick_down, bar_index + t_buffer + int(math.round(htf_candle_width/2.0)))
                    line.set_x2(c.wick_down, bar_index + t_buffer + int(math.round(htf_candle_width/2.0)))
                    if show_htf_candle_ce
                        ce_y_i = (c.h + c.l) / 2.0
                        if na(c.ce_line)
                            c.ce_line := line.new(bar_index + t_buffer, ce_y_i, bar_index + t_buffer + htf_candle_width, ce_y_i, color=htf_candle_ce_color, width=htf_candle_ce_width, style=htf_candle_ce_style)
                        else
                            line.set_xy1(c.ce_line, bar_index + t_buffer, ce_y_i)
                            line.set_xy2(c.ce_line, bar_index + t_buffer + htf_candle_width, ce_y_i)
                            line.set_color(c.ce_line, htf_candle_ce_color)
                            line.set_width(c.ce_line, htf_candle_ce_width)
                            line.set_style(c.ce_line, htf_candle_ce_style)
                    else
                        if not na(c.ce_line)
                            line.delete(c.ce_line)
                            c.ce_line := na

                    if not na(c.htf_time_lbl)
                        label.delete(c.htf_time_lbl)
                        c.htf_time_lbl := na
                    if not na(c.htf_rem_lbl)
                        label.delete(c.htf_rem_lbl)
                        c.htf_rem_lbl := na
                    if not na(c.htf_int_lbl)
                        label.delete(c.htf_int_lbl)
                        c.htf_int_lbl := na

                    if show_candle_time
                        time_text = formatCandleTime(c.o_time, auto_tf)
                        if not na(c.time_label)
                            label.set_x(c.time_label, bar_index + t_buffer + int(math.floor(htf_candle_width / 2.0)))
                            label.set_y(c.time_label, c.l)
                            label.set_text(c.time_label, time_text)
                        else
                            c.time_label := label.new(
                                bar_index + t_buffer + int(math.floor(htf_candle_width / 2.0)),
                                c.l,
                                time_text,
                                color=color.new(color.white, 100),
                                textcolor=candle_time_color,
                                style=label.style_label_up,
                                size=getTextSize(candle_time_size),
                                text_font_family=font.family_monospace
                            )

                    array.set(htfCandles, i, c)

                var label htf_overall_lbl = na
                if htfLabelShow
                    tf_txt = auto_tf == "1D" ? "1D" : auto_tf == "1W" ? "1W" : auto_tf == "1M" ? "1M" : auto_tf + "m"

                    rem_raw = RemainingTime(auto_tf)
                    rem_txt = "(" + rem_raw + ")"

                    line1 = intervalValueShow ? tf_txt : ""
                    line2 = remainingTimeShow ? rem_txt : ""
                    txt = line1
                    if str.length(line2) > 0
                        txt := (str.length(txt) > 0 ? (txt + "\n" + line2) : line2)

                    total_w = (htf_candle_width + htf_space) * (cdSize - 1) + htf_candle_width
                    x_center = bar_index + htf_padding + int(math.floor(total_w / 2.0))

                    float topH = na
                    for k = 0 to cdSize - 1
                        ck = array.get(htfCandles, k)
                        topH := na(topH) ? ck.h : math.max(topH, ck.h)
                    y_top = topH + (htfLabelYOffsetTicks * syminfo.mintick)

                    x_left  = bar_index + htf_padding
                    x_right = bar_index + htf_padding + total_w
                    x_final = labelAlignment == "Left" ? x_left : labelAlignment == "Right" ? x_right : x_center

                    y_final = labelPositions == "Bottom" ? (math.min(array.get(htfCandles, 0).l, topH) - (htfLabelYOffsetTicks * syminfo.mintick)) : y_top
                    lbl_style = labelPositions == "Bottom" ? label.style_label_up : label.style_label_down

                    if na(htf_overall_lbl)
                        htf_overall_lbl := label.new(
                            x_final,
                            y_final,
                            txt,
                            xloc=xloc.bar_index,
                            style=lbl_style,
                            color=htfLabelBG,
                            textcolor=htfLabelColor,
                            size=lblSize(htfLabelSizeOpt),
                            text_font_family=font.family_monospace
                        )
                    else
                        label.set_x(htf_overall_lbl, x_final)
                        label.set_y(htf_overall_lbl, y_final)
                        label.set_text(htf_overall_lbl, txt)
                        label.set_color(htf_overall_lbl, htfLabelBG)
                        label.set_textcolor(htf_overall_lbl, htfLabelColor)
                        label.set_size(htf_overall_lbl, lblSize(htfLabelSizeOpt))
                        label.set_style(htf_overall_lbl, lbl_style)
                else
                    if not na(htf_overall_lbl)
                        label.delete(htf_overall_lbl)
                        htf_overall_lbl := na

                // HTF1 FVG DETECTION ONLY — feeds htfFVG_top/bot for the models' POI-tap
                // logic (C2/CISD/ATM). The on-chart HTF FVG *visual* is now rendered by the
                // ICT HTF FVGs (fadi) module; the old candle-strip boxes/CE lines are removed.
                if show_fvg and cdSize > 2
                    for i = 0 to cdSize - 3
                        fvg1 = array.get(htfCandles, i)
                        fvg2 = array.get(htfCandles, i + 2)

                        if fvg1.l > fvg2.h and math.min(fvg1.o, fvg1.c) > math.max(fvg2.o, fvg2.c)
                            array.push(htfFVG_top, fvg1.l)
                            array.push(htfFVG_bot, fvg2.h)

                        if fvg1.h < fvg2.l and math.max(fvg1.o, fvg1.c) < math.min(fvg2.o, fvg2.c)
                            array.push(htfFVG_top, fvg2.l)
                            array.push(htfFVG_bot, fvg1.h)

                if vi_show and cdSize > 1
                    for ii = 0 to cdSize - 2
                        c1_ = array.get(htfCandles, ii)
                        c2_ = array.get(htfCandles, ii + 1)

                        if (c1_.l < c2_.h and math.min(c1_.o, c1_.c) > math.max(c2_.o, c2_.c))
                            b = box.new(bar_index + (htf_padding + (htf_candle_width + htf_space) * (cdSize - (ii + 1) - 1)), math.min(c1_.o, c1_.c), bar_index + (htf_padding + (htf_candle_width + htf_space) * (cdSize - ii - 1)) + htf_candle_width, math.max(c2_.o, c2_.c), bgcolor=vi_color, border_color=color.new(color.white, 100))
                            array.push(htfVIs, b)

                        if (c1_.h > c2_.l and math.max(c1_.o, c1_.c) < math.min(c2_.o, c2_.c))
                            b = box.new(bar_index + (htf_padding + (htf_candle_width + htf_space) * (cdSize - ii - 1)) + htf_candle_width, math.min(c2_.o, c2_.c), bar_index + (htf_padding + (htf_candle_width + htf_space) * (cdSize - (ii + 1) - 1)), math.max(c1_.o, c1_.c), bgcolor=vi_color, border_color=color.new(color.white, 100))
                            array.push(htfVIs, b)

                if show_htfswing_lines and cdSize > 1
                    for i = cdSize - 1 to 1
                        c = array.get(htfCandles, i)
                        next_c = array.get(htfCandles, i - 1)

                        if next_c.is_closed or (i > 1)
                            is_confirmed_high = next_c.h > c.h and next_c.c < c.h
                            is_confirmed_low  = next_c.l < c.l and next_c.c > c.l

                            if is_confirmed_high
                                t_buffer = htf_padding + (htf_candle_width + htf_space) * (cdSize - i - 1)
                                next_buffer = htf_padding + (htf_candle_width + htf_space) * (cdSize - (i - 1) - 1)
                                line_start = bar_index + t_buffer + int(math.round(htf_candle_width/2.0))
                                line_end   = bar_index + next_buffer + htf_candle_width + htfswing_overshoot
                                if na(c.swing_high_line)
                                    c.swing_high_line := line.new(line_start, c.h, line_end, c.h, color=htfswing_high_color, width=htfswing_line_width, style=htfswing_line_style)
                                else
                                    line.set_x1(c.swing_high_line, line_start)
                                    line.set_y1(c.swing_high_line, c.h)
                                    line.set_x2(c.swing_high_line, line_end)
                                    line.set_y2(c.swing_high_line, c.h)
                            else
                                if not na(c.swing_high_line)
                                    line.delete(c.swing_high_line)
                                    c.swing_high_line := na

                            if is_confirmed_low
                                t_buffer = htf_padding + (htf_candle_width + htf_space) * (cdSize - i - 1)
                                next_buffer = htf_padding + (htf_candle_width + htf_space) * (cdSize - (i - 1) - 1)
                                line_start = bar_index + t_buffer + int(math.round(htf_candle_width/2.0))
                                line_end   = bar_index + next_buffer + htf_candle_width + htfswing_overshoot
                                if na(c.swing_low_line)
                                    c.swing_low_line := line.new(line_start, c.l, line_end, c.l, color=htfswing_low_color, width=htfswing_line_width, style=htfswing_line_style)
                                else
                                    line.set_x1(c.swing_low_line, line_start)
                                    line.set_y1(c.swing_low_line, c.l)
                                    line.set_x2(c.swing_low_line, line_end)
                                    line.set_y2(c.swing_low_line, c.l)
                            else
                                if not na(c.swing_low_line)
                                    line.delete(c.swing_low_line)
                                    c.swing_low_line := na

                            array.set(htfCandles, i, c)



// === Additional HTF rows (HTF2 / HTF3 / HTF4) =====================
// Visual-only renderer for the secondary HTFs. Same candle/FVG/VI/swing
// engine as HTF1 but no C2/C3/C4, CISD neo, std-dev, or HTF Open/EQ lines.
// Uses global colors and toggles (show_fvg / vi_show / show_htfswing_lines /
// show_candle_time) so the per-HTF inputs stay minimal.
f_renderAdditionalHTF(string tf, bool show, array<Candle> cd, array<FVG> fvgs, array<box> vis, int xOff) =>
    // ta.change/time must be called every bar (CW10003) — evaluate before the show gate.
    HTFBarTime2 = time(tf, "america/New_York")
    isNewHTFCandle2 = ta.change(HTFBarTime2) > 0
    if show
        if isNewHTFCandle2
            candle = Candle.new()
            candle.o := open
            candle.c := close
            candle.h := high
            candle.l := low
            candle.o_idx := bar_index
            candle.c_idx := bar_index
            candle.h_idx := bar_index
            candle.l_idx := bar_index
            candle.o_time := time
            candle.c_time := time
            candle.is_closed := false

            if array.size(cd) > 0
                prevCandle = array.get(cd, 0)
                prevCandle.is_closed := true
                array.set(cd, 0, prevCandle)

            bull = candle.c > candle.o
            candle.body := box.new(bar_index, math.max(candle.o, candle.c), bar_index + 2, math.min(candle.o, candle.c),
                                   bull ? bull_border : bear_border, 1, bgcolor=bull ? bull_body : bear_body)
            candle.wick_up   := line.new(bar_index + 1, candle.h, bar_index, math.max(candle.o, candle.c), color=bull ? bull_wick : bear_wick)
            candle.wick_down := line.new(bar_index + 1, math.min(candle.o, candle.c), bar_index, candle.l, color=bull ? bull_wick : bear_wick)
            if show_htf_candle_ce
                ce_y_h = (candle.h + candle.l) / 2.0
                candle.ce_line := line.new(bar_index, ce_y_h, bar_index + 2, ce_y_h, color=htf_candle_ce_color, width=htf_candle_ce_width, style=htf_candle_ce_style)

            array.unshift(cd, candle)

            if array.size(cd) > max_htf_candles
                delCandle = array.pop(cd)
                box.delete(delCandle.body)
                line.delete(delCandle.wick_up)
                line.delete(delCandle.wick_down)
                if not na(delCandle.time_label)
                    label.delete(delCandle.time_label)
                if not na(delCandle.swing_high_line)
                    line.delete(delCandle.swing_high_line)
                if not na(delCandle.swing_low_line)
                    line.delete(delCandle.swing_low_line)
                if not na(delCandle.ce_line)
                    line.delete(delCandle.ce_line)

        if array.size(cd) > 0
            cur = array.get(cd, 0)
            cur.h_idx := high > cur.h ? bar_index : cur.h_idx
            cur.h := high > cur.h ? high : cur.h
            cur.l_idx := low < cur.l ? bar_index : cur.l_idx
            cur.l := low < cur.l ? low : cur.l
            cur.c := close
            cur.c_idx := bar_index
            cur.c_time := time

            bull = cur.c > cur.o
            box.set_top(cur.body, cur.o)
            box.set_bottom(cur.body, cur.c)
            box.set_bgcolor(cur.body, bull ? bull_body : bear_body)
            box.set_border_color(cur.body, bull ? bull_border : bear_border)
            line.set_color(cur.wick_up, bull ? bull_wick : bear_wick)
            line.set_color(cur.wick_down, bull ? bull_wick : bear_wick)
            line.set_y1(cur.wick_up, cur.h)
            line.set_y2(cur.wick_up, math.max(cur.o, cur.c))
            line.set_y1(cur.wick_down, cur.l)
            line.set_y2(cur.wick_down, math.min(cur.o, cur.c))

            array.set(cd, 0, cur)

            if barstate.isrealtime or barstate.islast
                cdSize = array.size(cd)

                if cdSize > 0
                    if array.size(fvgs) > 0
                        for i = 0 to array.size(fvgs) - 1
                            fvg_del_h = array.get(fvgs, i)
                            box.delete(fvg_del_h.b)
                            if not na(fvg_del_h.ce)
                                line.delete(fvg_del_h.ce)
                    array.clear(fvgs)

                    if array.size(vis) > 0
                        for j = 0 to array.size(vis) - 1
                            box.delete(array.get(vis, j))
                    array.clear(vis)

                    for i = cdSize - 1 to 0
                        c = array.get(cd, i)
                        t_buffer = xOff + (htf_candle_width + htf_space) * (cdSize - i - 1)
                        box.set_left(c.body, bar_index + t_buffer)
                        box.set_right(c.body, bar_index + t_buffer + htf_candle_width)
                        line.set_x1(c.wick_up, bar_index + t_buffer + int(math.round(htf_candle_width/2.0)))
                        line.set_x2(c.wick_up, bar_index + t_buffer + int(math.round(htf_candle_width/2.0)))
                        line.set_x1(c.wick_down, bar_index + t_buffer + int(math.round(htf_candle_width/2.0)))
                        line.set_x2(c.wick_down, bar_index + t_buffer + int(math.round(htf_candle_width/2.0)))
                        if show_htf_candle_ce
                            ce_y_hi = (c.h + c.l) / 2.0
                            if na(c.ce_line)
                                c.ce_line := line.new(bar_index + t_buffer, ce_y_hi, bar_index + t_buffer + htf_candle_width, ce_y_hi, color=htf_candle_ce_color, width=htf_candle_ce_width, style=htf_candle_ce_style)
                            else
                                line.set_xy1(c.ce_line, bar_index + t_buffer, ce_y_hi)
                                line.set_xy2(c.ce_line, bar_index + t_buffer + htf_candle_width, ce_y_hi)
                                line.set_color(c.ce_line, htf_candle_ce_color)
                                line.set_width(c.ce_line, htf_candle_ce_width)
                                line.set_style(c.ce_line, htf_candle_ce_style)
                        else
                            if not na(c.ce_line)
                                line.delete(c.ce_line)
                                c.ce_line := na

                        if show_candle_time
                            time_text = formatCandleTime(c.o_time, tf)
                            if not na(c.time_label)
                                label.set_x(c.time_label, bar_index + t_buffer + int(math.floor(htf_candle_width / 2.0)))
                                label.set_y(c.time_label, c.l)
                                label.set_text(c.time_label, time_text)
                            else
                                c.time_label := label.new(
                                    bar_index + t_buffer + int(math.floor(htf_candle_width / 2.0)),
                                    c.l,
                                    time_text,
                                    color=color.new(color.white, 100),
                                    textcolor=candle_time_color,
                                    style=label.style_label_up,
                                    size=getTextSize(candle_time_size),
                                    text_font_family=font.family_monospace
                                )
                        else
                            if not na(c.time_label)
                                label.delete(c.time_label)
                                c.time_label := na

                        array.set(cd, i, c)

                    // Additional-HTF on-chart FVG visual removed — HTF FVGs are now rendered
                    // by the ICT HTF FVGs (fadi) module. (This block never fed the models.)

                    if vi_show and cdSize > 1
                        for ii = 0 to cdSize - 2
                            c1_ = array.get(cd, ii)
                            c2_ = array.get(cd, ii + 1)

                            if (c1_.l < c2_.h and math.min(c1_.o, c1_.c) > math.max(c2_.o, c2_.c))
                                b = box.new(bar_index + (xOff + (htf_candle_width + htf_space) * (cdSize - (ii + 1) - 1)), math.min(c1_.o, c1_.c), bar_index + (xOff + (htf_candle_width + htf_space) * (cdSize - ii - 1)) + htf_candle_width, math.max(c2_.o, c2_.c), bgcolor=vi_color, border_color=color.new(color.white, 100))
                                array.push(vis, b)

                            if (c1_.h > c2_.l and math.max(c1_.o, c1_.c) < math.min(c2_.o, c2_.c))
                                b = box.new(bar_index + (xOff + (htf_candle_width + htf_space) * (cdSize - ii - 1)) + htf_candle_width, math.min(c2_.o, c2_.c), bar_index + (xOff + (htf_candle_width + htf_space) * (cdSize - (ii + 1) - 1)), math.max(c1_.o, c1_.c), bgcolor=vi_color, border_color=color.new(color.white, 100))
                                array.push(vis, b)

                    if show_htfswing_lines and cdSize > 1
                        for i = cdSize - 1 to 1
                            c = array.get(cd, i)
                            next_c = array.get(cd, i - 1)

                            if next_c.is_closed or (i > 1)
                                is_confirmed_high = next_c.h > c.h and next_c.c < c.h
                                is_confirmed_low  = next_c.l < c.l and next_c.c > c.l

                                if is_confirmed_high
                                    t_buffer = xOff + (htf_candle_width + htf_space) * (cdSize - i - 1)
                                    next_buffer = xOff + (htf_candle_width + htf_space) * (cdSize - (i - 1) - 1)
                                    line_start = bar_index + t_buffer + int(math.round(htf_candle_width/2.0))
                                    line_end   = bar_index + next_buffer + htf_candle_width + htfswing_overshoot
                                    if na(c.swing_high_line)
                                        c.swing_high_line := line.new(line_start, c.h, line_end, c.h, color=htfswing_high_color, width=htfswing_line_width, style=htfswing_line_style)
                                    else
                                        line.set_x1(c.swing_high_line, line_start)
                                        line.set_y1(c.swing_high_line, c.h)
                                        line.set_x2(c.swing_high_line, line_end)
                                        line.set_y2(c.swing_high_line, c.h)
                                else
                                    if not na(c.swing_high_line)
                                        line.delete(c.swing_high_line)
                                        c.swing_high_line := na

                                if is_confirmed_low
                                    t_buffer = xOff + (htf_candle_width + htf_space) * (cdSize - i - 1)
                                    next_buffer = xOff + (htf_candle_width + htf_space) * (cdSize - (i - 1) - 1)
                                    line_start = bar_index + t_buffer + int(math.round(htf_candle_width/2.0))
                                    line_end   = bar_index + next_buffer + htf_candle_width + htfswing_overshoot
                                    if na(c.swing_low_line)
                                        c.swing_low_line := line.new(line_start, c.l, line_end, c.l, color=htfswing_low_color, width=htfswing_line_width, style=htfswing_line_style)
                                    else
                                        line.set_x1(c.swing_low_line, line_start)
                                        line.set_y1(c.swing_low_line, c.l)
                                        line.set_x2(c.swing_low_line, line_end)
                                        line.set_y2(c.swing_low_line, c.l)
                                else
                                    if not na(c.swing_low_line)
                                        line.delete(c.swing_low_line)
                                        c.swing_low_line := na

                                array.set(cd, i, c)


// Compute layout offsets — each HTF stacks to the right of the previous one
// with htf_space_htf bars between rows. Hidden rows collapse so the next visible
// row takes its slot.
htf1_count_now = array.size(htfCandles)
htf2_count_now = array.size(htf2_candles)
htf3_count_now = array.size(htf3_candles)
htf1_w_now = htf1_count_now > 0 and showHTFCandles ? (htf1_count_now - 1) * (htf_candle_width + htf_space) + htf_candle_width : 0
htf2_w_now = htf2_count_now > 0 and htf2_show       ? (htf2_count_now - 1) * (htf_candle_width + htf_space) + htf_candle_width : 0
htf3_w_now = htf3_count_now > 0 and htf3_show       ? (htf3_count_now - 1) * (htf_candle_width + htf_space) + htf_candle_width : 0

htf2_xoff = htf_padding + htf1_w_now + (htf1_w_now > 0 ? htf_space_htf : 0)
htf3_xoff = htf2_xoff   + htf2_w_now + (htf2_w_now > 0 ? htf_space_htf : 0)
htf4_xoff = htf3_xoff   + htf3_w_now + (htf3_w_now > 0 ? htf_space_htf : 0)

f_renderAdditionalHTF(htf2_tf, htf2_show, htf2_candles, htf2_fvgs, htf2_vis, htf2_xoff)
f_renderAdditionalHTF(htf3_tf, htf3_show, htf3_candles, htf3_fvgs, htf3_vis, htf3_xoff)
f_renderAdditionalHTF(htf4_tf, htf4_show, htf4_candles, htf4_fvgs, htf4_vis, htf4_xoff)

// HTF2/3/4 main labels (TF + countdown). Same format as HTF1's label.
var label htf2_overall_lbl = na
var label htf3_overall_lbl = na
var label htf4_overall_lbl = na

f_drawHTFLabel(string tf, bool show, array<Candle> cd, int xOff, label currentLbl) =>
    label outLbl = currentLbl
    if show and htfLabelShow and barstate.islast and array.size(cd) > 0
        cdSize = array.size(cd)
        tf_txt = tf == "1D" ? "1D" : tf == "1W" ? "1W" : tf == "1M" ? "1M" : tf + "m"
        rem_raw = RemainingTime(tf)
        rem_txt = "(" + rem_raw + ")"
        line1 = intervalValueShow ? tf_txt : ""
        line2 = remainingTimeShow ? rem_txt : ""
        txt = line1
        if str.length(line2) > 0
            txt := (str.length(txt) > 0 ? (txt + "\n" + line2) : line2)

        total_w = (htf_candle_width + htf_space) * (cdSize - 1) + htf_candle_width
        x_center = bar_index + xOff + int(math.floor(total_w / 2.0))

        float topH = na
        for k = 0 to cdSize - 1
            ck = array.get(cd, k)
            topH := na(topH) ? ck.h : math.max(topH, ck.h)
        y_top = topH + (htfLabelYOffsetTicks * syminfo.mintick)

        x_left  = bar_index + xOff
        x_right = bar_index + xOff + total_w
        x_final = labelAlignment == "Left" ? x_left : labelAlignment == "Right" ? x_right : x_center
        y_final = labelPositions == "Bottom" ? (math.min(array.get(cd, 0).l, topH) - (htfLabelYOffsetTicks * syminfo.mintick)) : y_top
        lbl_style = labelPositions == "Bottom" ? label.style_label_up : label.style_label_down

        if na(outLbl)
            outLbl := label.new(x_final, y_final, txt, xloc=xloc.bar_index, style=lbl_style, color=htfLabelBG, textcolor=htfLabelColor, size=lblSize(htfLabelSizeOpt), text_font_family=font.family_monospace)
        else
            label.set_x(outLbl, x_final)
            label.set_y(outLbl, y_final)
            label.set_text(outLbl, txt)
            label.set_color(outLbl, htfLabelBG)
            label.set_textcolor(outLbl, htfLabelColor)
            label.set_size(outLbl, lblSize(htfLabelSizeOpt))
            label.set_style(outLbl, lbl_style)
    else
        if not na(outLbl)
            label.delete(outLbl)
            outLbl := na
    outLbl

htf2_overall_lbl := f_drawHTFLabel(htf2_tf, htf2_show, htf2_candles, htf2_xoff, htf2_overall_lbl)
htf3_overall_lbl := f_drawHTFLabel(htf3_tf, htf3_show, htf3_candles, htf3_xoff, htf3_overall_lbl)
htf4_overall_lbl := f_drawHTFLabel(htf4_tf, htf4_show, htf4_candles, htf4_xoff, htf4_overall_lbl)



if showOCLines and barstate.islast
    for ln in ocLines
        line.delete(ln)
    array.clear(ocLines)

    if array.size(htfCandles) > 0
        maxCandles = math.min(array.size(htfCandles), max_htf_candles)
        for i = 0 to maxCandles - 1
            c = array.get(htfCandles, i)
            y1 = math.min(c.o, c.c)
            y2 = math.max(c.o, c.c)

            ocLine = line.new(
                 x1=c.o_time, y1=y1,
                 x2=c.o_time, y2=y2,
                 xloc=xloc.bar_time,
                 extend=extend.both,
                 color=ocLineColor,
                 style=getLineStyleHTF(ocLineStyle),
                 width=ocLineWidth
             )
            array.push(ocLines, ocLine)

if period_changed
    prevC2Buy      := c2_buy[1]
    prevC2Sell     := c2_sell[1]
    prevHighTime   := periodHighTime[1]
    prevLowTime    := periodLowTime[1]
    prevHighPrice  := periodHigh[1]
    prevLowPrice   := periodLow[1]
    prevHTFHigh    := htfH[1]
    prevHTFLow     := htfL[1]
    c3HighForMid   := currentH[1]
    c3LowForMid    := currentL[1]
    periodHigh     := high
    periodHighTime := time
    periodLow      := low
    periodLowTime  := time
else
    if high > periodHigh
        periodHigh := high
        periodHighTime := time
    if low < periodLow
        periodLow := low
        periodLowTime := time

if low == l0 and low < l1
    if (dw[0] or eq[0]) and (up[1] or eq[1]) and not (eq[0] and eq[1])
        bull_level_fixed := open
        bull_index_fixed := bar_index
    else
        for i = 2 to 10
            if low[i] < low
                break
            if (up[i] or eq[i]) and dw[i-1]
                bar = i - 1
                bull_level_fixed := open[bar]
                bull_index_fixed := bar_index - bar
                for j = bar to 0
                    if open[j] > bull_level_fixed and dw[j]
                        bull_level_fixed := open[j]
                        bull_index_fixed := bar_index - j

                if bull_level_fixed < open and not (close > open)
                    bull_level_fixed := open
                    bull_index_fixed := bar_index
                if bull_level_fixed < open and (close > open)
                    bull_level_fixed := high
                    bull_index_fixed := bar_index
                break

if high == h0 and high > h1
    if (up[0] or eq[0]) and (dw[1] or eq[1]) and not (eq[0] and eq[1])
        bear_level_fixed := open
        bear_index_fixed := bar_index
    else
        for i = 2 to 10
            if high[i] > high
                break
            if (dw[i] or eq[i]) and up[i-1]
                ybar = i - 1
                bear_level_fixed := open[ybar]
                bear_index_fixed := bar_index - ybar
                for j = ybar to 0
                    if open[j] < bear_level_fixed and up[j]
                        bear_level_fixed := open[j]
                        bear_index_fixed := bar_index - j

                if bear_level_fixed > open and not (close < open)
                    bear_level_fixed := open
                    bear_index_fixed := bar_index
                if bear_level_fixed > open and (close < open)
                    bear_level_fixed := low
                    bear_index_fixed := bar_index
                break

xbull = close[1] > bull_level_fixed and not na(bull_level_fixed) and (l_swept[1] or (l1 <= l0 and l_swept1)) and not bull_reclaimed_current and (bar_index - 1 >= bull_index_fixed)
if xbull
    bull_reclaimed_current := true
    bull_reclaim_bar := bar_index - 1

xbear = close[1] < bear_level_fixed and not na(bear_level_fixed) and (h_swept[1] or (h1 >= h0 and h_swept1)) and not bear_reclaimed_current and (bar_index - 1 >= bear_index_fixed)
if xbear
    bear_reclaimed_current := true
    bear_reclaim_bar := bar_index - 1

if close[1] > bull_level_fixed and not na(bull_level_fixed) and not (l_swept[1] or (l1 <= l0 and l_swept1)) and not bull_reclaimed_current and (bar_index - 1 >= bull_index_fixed)
    bull_reclaimed_current := true
    bull_reclaim_bar := bar_index - 1

if close[1] < bear_level_fixed and not na(bear_level_fixed) and not (h_swept[1] or (h1 >= h0 and h_swept1)) and not bear_reclaimed_current and (bar_index - 1 >= bear_index_fixed)
    bear_reclaimed_current := true
    bear_reclaim_bar := bar_index - 1

if timeframe.change(auto_tf)
    if c2_buy[1] and not na(bull_level_fixed[1])
        c2_had_bull_sweep := true
        c2_bull_level := bull_level_fixed[1]
        c2_bull_index := bull_index_fixed[1]
        if showCISDNeo and cisdMode == "Hybrid"
            f_addCISD(true, c2_bull_index, c2_bull_level, 0)
        c2_already_invalidated_bull := false
        htf_count_since_sweep := 0
        bull_cisd_confirmed := bull_reclaimed_current[1] and not na(bull_reclaim_bar[1])
    else if not c2_buy[1]
        c2_had_bull_sweep := false

    if c2_sell[1] and not na(bear_level_fixed[1])
        c2_had_bear_sweep := true
        c2_bear_level := bear_level_fixed[1]
        c2_bear_index := bear_index_fixed[1]
        if showCISDNeo and cisdMode == "Hybrid"
            f_addCISD(false, c2_bear_index, c2_bear_level, 0)
        c2_already_invalidated_bear := false
        htf_count_since_sweep := 0
        bear_cisd_confirmed := bear_reclaimed_current[1] and not na(bear_reclaim_bar[1])
    else if not c2_sell[1]
        c2_had_bear_sweep := false

if timeframe.change(auto_tf) and (c2_had_bull_sweep or c2_had_bear_sweep)
    htf_count_since_sweep += 1
    if htf_count_since_sweep > 2
        c2_had_bull_sweep := false
        c2_had_bear_sweep := false
        htf_count_since_sweep := 0
        bull_cisd_confirmed := false
        bear_cisd_confirmed := false
        c2_already_invalidated_bull := false
        c2_already_invalidated_bear := false

htf_c2_close = request.security(syminfo.tickerid, auto_tf, close[1], lookahead=barmerge.lookahead_off)

if c2_had_bull_sweep and htf_count_since_sweep == 2 and not na(c2_bull_level) and htf_c2_close > c2_bull_level
    bull_cisd_confirmed := true

if c2_had_bear_sweep and htf_count_since_sweep == 2 and not na(c2_bear_level) and htf_c2_close < c2_bear_level
    bear_cisd_confirmed := true

if showCISDNeo and cisdMode == "Hybrid"
    if c2_had_bull_sweep
        bullState = bull_cisd_confirmed ? 2 : (htf_count_since_sweep >= 2 ? 1 : 0)
        f_setLastCISDStyle(true, bullState)
    if c2_had_bear_sweep
        bearState = bear_cisd_confirmed ? 2 : (htf_count_since_sweep >= 2 ? 1 : 0)
        f_setLastCISDStyle(false, bearState)

createC2Setup(bool isShort, int setupTime, float setupPrice, float _htfOpen, float midPoint, float cisdLevel, int cisdIndex, int currentCount) =>
    shouldCreate = biasFilter == "Neutral" or (biasFilter == "Bullish" and not isShort) or (biasFilter == "Bearish" and isShort)
    if shouldCreate
        lbl = label.new(setupTime, setupPrice, "C2",
             xloc=xloc.bar_time,
             style=isShort ? label.style_label_down : label.style_label_up,
             color=color.new(color.white, 100),
             textcolor=coloroftext,
             size=size.small,
             text_font_family=font.family_monospace)

        array.push(activeLabels, lbl)
        array.push(activeStops, setupPrice)
        array.push(activeShorts, isShort)
        array.push(activeCounts, currentCount)
        array.push(activeC3Mids, na)
        array.push(activeCisdConfirmed, true)
        array.push(activeInvalidated, false)

        openLine = showHTFOpen ? line.new(htfTime, _htfOpen, htfTimeClose, _htfOpen, xloc=xloc.bar_time, color=htfOpenColor, width=htfOpenWidth, style=getLineStyleHTF(htfOpenStyle)) : na
        midLine  = showPrevHTFMid and not na(midPoint) ? line.new(htfTime, midPoint, htfTimeClose, midPoint, xloc=xloc.bar_time, color=prevHTFMidColor, width=prevHTFMidWidth, style=getLineStyleHTF(prevHTFMidStyle)) : na
        c3Box    = showBox and not na(midPoint) and not na(_htfOpen) ? box.new(htfTime, math.max(_htfOpen, midPoint), htfTimeClose, math.min(_htfOpen, midPoint), bgcolor=boxColor, border_width=0, xloc=xloc.bar_time) : na

        array.push(activeOpenLines, openLine)
        array.push(activeMidLines,  midLine)
        array.push(activeC3Boxes,   c3Box)
        array.push(activeC4Labels,  na)
        array.push(activeC4OpenLines, na)
        array.push(activeC4MidLines,  na)
        array.push(activeC4Boxes,     na)

        if showCISDNeo and not na(cisdLevel) and not na(cisdIndex)
            f_removeLastPendingCISD(not isShort)
            f_addCISD(not isShort, cisdIndex, cisdLevel, 2)

        stdDevLinesArray  = array.new<line>()
        stdDevLabelsArray = array.new<label>()

        // --- Standard-deviation projection (ICT fractal targets) ---------------
        // 1 std dev = the manipulation range: from the swept swing (invalidation /
        // setupPrice) to the CISD reclaim extreme (level0). Targets are projected
        // in the trade direction as multiples of that range: 1σ, 2σ, 3σ.
        if showStdDev and not na(cisdIndex) and cisdIndex <= bar_index and (bar_index - cisdIndex) >= 0
            float level1 = setupPrice
            float level0 = na

            if not isShort
                level0 := high[bar_index - cisdIndex]
                if cisdIndex < bar_index
                    level0 := math.max(level0, high[bar_index - cisdIndex + 1])
            else
                level0 := low[bar_index - cisdIndex]
                if cisdIndex < bar_index
                    level0 := math.min(level0, low[bar_index - cisdIndex + 1])

            float R = na(level0) or na(level1) ? na : math.abs(level0 - level1)

            if not na(R) and R > 0
                int leftBar  = cisdIndex
                int rightBar = bar_index + stdDevProjBars
                for n = 1 to stdDevCount
                    float devPrice = not isShort ? level0 + n * R : level0 - n * R
                    devLine = line.new(leftBar, devPrice, rightBar, devPrice, xloc=xloc.bar_index, color=stdDevColor, width=stdDevWidth, style=line.style_solid)
                    devLabel = label.new(rightBar, devPrice, "-" + str.tostring(n), xloc=xloc.bar_index,
                         color=color.new(color.white, 100),
                         style=label.style_label_left,
                         textcolor=showStdDevLabels ? stdDevColor : color.new(stdDevColor, 100),
                         size=size.small, text_font_family=font.family_monospace)

                    array.push(stdDevLinesArray, devLine)
                    array.push(stdDevLabelsArray, devLabel)

        array.push(activeStdDevData, StdDevData.new(stdDevLinesArray, stdDevLabelsArray))

        // Cap std-dev sets on chart — older sets get their projection lines/labels deleted
        // but the C2/C3/C4 labels themselves remain in the activeLabels array.
        int total_sd = array.size(activeStdDevData)
        if total_sd > max_stddev_sets
            int n_clear = total_sd - max_stddev_sets
            for clrI = 0 to n_clear - 1
                oldS = array.get(activeStdDevData, clrI)
                if not na(oldS)
                    if array.size(oldS.lines) > 0
                        for ln in oldS.lines
                            line.delete(ln)
                    if array.size(oldS.labels) > 0
                        for lb in oldS.labels
                            label.delete(lb)
                    array.set(activeStdDevData, clrI, StdDevData.new(array.new<line>(), array.new<label>()))

        // Cap total C2 setups on chart — when exceeded, evict the oldest setup and delete all of its visuals.
        while array.size(activeLabels) > effective_max
            oldLbl    = array.shift(activeLabels)
            oldOpen   = array.shift(activeOpenLines)
            oldMid    = array.shift(activeMidLines)
            oldC3Box  = array.shift(activeC3Boxes)
            oldC4Lbl  = array.shift(activeC4Labels)
            oldC4Open = array.shift(activeC4OpenLines)
            oldC4Mid  = array.shift(activeC4MidLines)
            oldC4Box  = array.shift(activeC4Boxes)
            oldStd    = array.shift(activeStdDevData)
            array.shift(activeStops)
            array.shift(activeShorts)
            array.shift(activeCounts)
            array.shift(activeC3Mids)
            array.shift(activeCisdConfirmed)
            array.shift(activeInvalidated)
            if not na(oldLbl)
                label.delete(oldLbl)
            if not na(oldOpen)
                line.delete(oldOpen)
            if not na(oldMid)
                line.delete(oldMid)
            if not na(oldC3Box)
                box.delete(oldC3Box)
            if not na(oldC4Lbl)
                label.delete(oldC4Lbl)
            if not na(oldC4Open)
                line.delete(oldC4Open)
            if not na(oldC4Mid)
                line.delete(oldC4Mid)
            if not na(oldC4Box)
                box.delete(oldC4Box)
            if not na(oldStd)
                if array.size(oldStd.lines) > 0
                    for ln in oldStd.lines
                        line.delete(ln)
                if array.size(oldStd.labels) > 0
                    for lb in oldStd.labels
                        label.delete(lb)

// ---------------------------------------------------------------------------
// T-Spot trigger (ported from the "Fractal ICT" source)
// A T-Spot fires the instant an HTF candle CLOSES having (a) swept the prior HTF
// candle's high/low, (b) closed back inside it, and (c) closed beyond its own
// consequent-encroachment (log) midpoint — with an inside/engulf exclusion.
//   - Bullish: swept prior low, closed back above it, closed above its mid.
//   - Bearish: swept prior high, closed back below it, closed below its mid.
// The T-Spot zone is drawn from that candle's log-mid to its close, anchored at
// the current (C3) HTF candle open and one HTF period wide. We pass the close as
// `_htfOpen` (close line) and the log-mid as `midPoint` so the existing box/line
// visuals render the correct zone. `bull_cisd_confirmed`/`bear_cisd_confirmed`
// (which feed ATM/Unicorn/CISD) are left untouched.
if period_changed
    // Just-closed HTF candle OHLC (values are final on the preceding bar) and its
    // consequent-encroachment midpoint.
    float sweptH   = currentH[1]
    float sweptL   = currentL[1]
    float sweptO   = htfO[1]
    float sweptC   = currentC[1]
    float sweepMid = f_logMid(sweptH, sweptL, sweptO, sweptC)
    // exclude an outside/engulfing candle that swept both sides and closed inside
    bool notEngulf = not (not na(prevH1[1]) and not na(prevL1[1]) and sweptH > prevH1[1] and sweptL < prevL1[1] and sweptC > prevL1[1] and sweptC < prevH1[1])

    if prevC2Buy and not na(sweepMid) and sweptC > sweepMid and notEngulf and not c2_already_invalidated_bull
        createC2Setup(false, prevLowTime, prevLowPrice, sweptC, sweepMid, c2_bull_level, c2_bull_index, 0)

    if prevC2Sell and not na(sweepMid) and sweptC < sweepMid and notEngulf and not c2_already_invalidated_bear
        createC2Setup(true, prevHighTime, prevHighPrice, sweptC, sweepMid, c2_bear_level, c2_bear_index, 0)

if array.size(activeLabels) > 0
    for i = array.size(activeLabels) - 1 to 0
        lbl = array.get(activeLabels, i)
        stop = array.get(activeStops, i)
        isShort = array.get(activeShorts, i)
        count = array.get(activeCounts, i)
        c3Mid = array.get(activeC3Mids, i)
        c4Label = array.get(activeC4Labels, i)
        isInvalidated = array.get(activeInvalidated, i)

        if period_changed
            count += 1
            array.set(activeCounts, i, count)

            if count == 2 and not isInvalidated
                c3Mid := (c3HighForMid + c3LowForMid) / 2
                array.set(activeC3Mids, i, c3Mid)

                shouldCreateC4 = isShort ? c3Mid >= htfO : c3Mid <= htfO
                if shouldCreateC4
                    avg_bar_time = (time - time[1])
                    c4_offset_time = time + (avg_bar_time * 2)

                    c4Lbl = label.new(c4_offset_time, c3Mid, "C4",
                         xloc=xloc.bar_time,
                         style=isShort ? label.style_label_down : label.style_label_up,
                         color=color.new(color.white, 100),
                         textcolor=coloroftext,
                         size=size.small,
                         text_font_family=font.family_monospace)
                    array.set(activeC4Labels, i, c4Lbl)

                    c4OpenLine = showHTFOpen ? line.new(htfTime, htfO, htfTimeClose, htfO, xloc=xloc.bar_time, color=htfOpenColor, width=htfOpenWidth, style=getLineStyleHTF(htfOpenStyle)) : na
                    c4MidLine  = showPrevHTFMid ? line.new(htfTime, c3Mid, htfTimeClose, c3Mid, xloc=xloc.bar_time, color=prevHTFMidColor, width=prevHTFMidWidth, style=getLineStyleHTF(prevHTFMidStyle)) : na
                    c4Box      = showBox and showHTFOpen ? box.new(htfTime, math.max(htfO, c3Mid), htfTimeClose, math.min(htfO, c3Mid), bgcolor=boxColor, border_width=0, xloc=xloc.bar_time) : na

                    array.set(activeC4OpenLines, i, c4OpenLine)
                    array.set(activeC4MidLines, i, c4MidLine)
                    array.set(activeC4Boxes, i, c4Box)

        if count <= 2 and not isInvalidated
            stopHit = isShort ? high > stop : low < stop
            if stopHit
                array.set(activeInvalidated, i, true)
                if isShort
                    c2_already_invalidated_bear := true
                else
                    c2_already_invalidated_bull := true

                // Delete previous XC2 label if exists
                if not na(lastXC2Label)
                    label.delete(lastXC2Label)
                
                label.set_text(lbl, "XC2")
                label.set_textcolor(lbl, count == 1 ? color.red : color.orange)
                
                // Store reference to this XC2 label
                lastXC2Label := lbl

                if not na(array.get(activeOpenLines, i))
                    line.delete(array.get(activeOpenLines, i))
                if not na(array.get(activeMidLines, i))
                    line.delete(array.get(activeMidLines, i))
                if not na(array.get(activeC3Boxes, i))
                    box.delete(array.get(activeC3Boxes, i))
                if not na(array.get(activeC4OpenLines, i))
                    line.delete(array.get(activeC4OpenLines, i))
                if not na(array.get(activeC4MidLines, i))
                    line.delete(array.get(activeC4MidLines, i))
                if not na(array.get(activeC4Boxes, i))
                    box.delete(array.get(activeC4Boxes, i))
                if not na(c4Label)
                    label.delete(c4Label)

                if array.size(activeStdDevData) > i
                    stdData = array.get(activeStdDevData, i)
                    for ln in stdData.lines
                        line.delete(ln)
                    for lb in stdData.labels
                        label.delete(lb)

                array.remove(activeLabels, i)
                array.remove(activeStops, i)
                array.remove(activeShorts, i)
                array.remove(activeCounts, i)
                array.remove(activeOpenLines, i)
                array.remove(activeMidLines, i)
                array.remove(activeC3Boxes, i)
                array.remove(activeC4Labels, i)
                array.remove(activeC4OpenLines, i)
                array.remove(activeC4MidLines, i)
                array.remove(activeC4Boxes, i)
                array.remove(activeC3Mids, i)
                array.remove(activeCisdConfirmed, i)
                array.remove(activeInvalidated, i)
                array.remove(activeStdDevData, i)
                continue

        if count == 2 and not na(c4Label) and not na(c3Mid) and not isInvalidated
            c4StopHit = isShort ? close > c3Mid : close < c3Mid
            if c4StopHit and label.get_text(c4Label) == "C4"
                label.set_text(c4Label, "XC4")
                label.set_textcolor(c4Label, color.red)

                if not na(array.get(activeC4OpenLines, i))
                    line.delete(array.get(activeC4OpenLines, i))
                    array.set(activeC4OpenLines, i, na)
                if not na(array.get(activeC4Boxes, i))
                    box.delete(array.get(activeC4Boxes, i))
                    array.set(activeC4Boxes, i, na)

leftLen = 20
rightLen = 20
ph_ms = ta.pivothigh(high, leftLen, rightLen)
pl_ms = ta.pivotlow(low, leftLen, rightLen)

getValue(piv, src, offset) =>
    curr = ta.valuewhen(not na(piv), src[offset], 0)
    prev = ta.valuewhen(not na(piv), src[offset], 1)
    [curr, prev]

[currH, prevH] = getValue(ph_ms, high, rightLen)
[currL, prevL] = getValue(pl_ms, low, rightLen)

isHH = not na(ph_ms) and prevH < currH
isLH = not na(ph_ms) and prevH > currH
isHL = not na(pl_ms) and prevL < currL
isLL = not na(pl_ms) and prevL > currL

plotchar(isHH and MQmarkers, "HH", "", location.abovebar, color.gray, offset=-rightLen, text="HH", textcolor=color.gray)
plotchar(isHL and MQmarkers, "HL", "", location.belowbar, color.gray, offset=-rightLen, text="HL", textcolor=color.gray)
plotchar(isLH and MQmarkers, "LH", "", location.abovebar, color.gray, offset=-rightLen, text="LH", textcolor=color.gray)
plotchar(isLL and MQmarkers, "LL", "", location.belowbar, color.gray, offset=-rightLen, text="LL", textcolor=color.gray)

// === Per-bar latches for ATM/Unicorn rewire =====
// Rising-edge latches on bull/bear_cisd_confirmed so ATM and Unicorn 5m can read a
// "fired this bar" boolean (matching the old ns_cisd_fired_bull/bear interface).
ns_cisd_fired_bull = bull_cisd_confirmed and not bull_cisd_confirmed[1]
ns_cisd_fired_bear = bear_cisd_confirmed and not bear_cisd_confirmed[1]

// Helper: did current bar's price tap any HTF FVG region?
f_touchedAnyHTFFVG(float lo, float hi) =>
    bool any = false
    if array.size(htfFVG_top) > 0
        for ii = 0 to array.size(htfFVG_top) - 1
            float ftop = array.get(htfFVG_top, ii)
            float fbot = array.get(htfFVG_bot, ii)
            if not na(ftop) and not na(fbot) and lo <= ftop and hi >= fbot
                any := true
                break
    any

// === END ICT HTF Candle Fractal Model source ====


// Session Levels Settings (NY AM Range, Asia, London, Midnight & 8:30 Opens)
string GRP_SESSIONS = "Session Levels"
show_ny_am_range  = input.bool(true, "Show NY AM Range (07:00-09:30 ET) BSL/SSL", group=GRP_SESSIONS)
ny_am_bsl_color   = input.color(color.new(color.red, 0), "NY AM High (BSL)", inline="nyam", group=GRP_SESSIONS)
ny_am_ssl_color   = input.color(color.new(color.green, 0), "NY AM Low (SSL)", inline="nyam", group=GRP_SESSIONS)
ny_am_bsl_label_text = input.string("NY AM BSL", "NY AM High Label", inline="nyamtxt", group=GRP_SESSIONS, tooltip="Text on the NY AM BSL line. Leave blank to hide just this label.")
ny_am_ssl_label_text = input.string("NY AM SSL", "NY AM Low Label",  inline="nyamtxt", group=GRP_SESSIONS)

show_asia_range   = input.bool(true, "Show Asia High/Low", group=GRP_SESSIONS)
asia_session_in   = input.session("2000-0000", "Asia Session (ET)", group=GRP_SESSIONS)
asia_color        = input.color(color.new(color.orange, 0), "Asia Color", group=GRP_SESSIONS)
asia_high_label_text = input.string("A.High", "Asia High Label", inline="asiatxt", group=GRP_SESSIONS, tooltip="Text on the Asia High/Low lines. Shorten to e.g. 'A.High' / 'A.Low' if you want compact labels.")
asia_low_label_text  = input.string("A.Low",  "Asia Low Label",  inline="asiatxt", group=GRP_SESSIONS)

show_london_range = input.bool(true, "Show London High/Low", group=GRP_SESSIONS)
london_session_in = input.session("0200-0500", "London Session (ET)", group=GRP_SESSIONS)
london_color      = input.color(color.new(color.blue, 0), "London Color", group=GRP_SESSIONS)
london_high_label_text = input.string("L.High", "London High Label", inline="ldntxt", group=GRP_SESSIONS, tooltip="Text on the London High/Low lines. Shorten to e.g. 'L.High' / 'L.Low' if you want compact labels.")
london_low_label_text  = input.string("L.Low",  "London Low Label",  inline="ldntxt", group=GRP_SESSIONS)

show_midnight_open = input.bool(true, "Show Midnight Open (00:00 ET)", group=GRP_SESSIONS)
midnight_color     = input.color(color.new(color.purple, 0), "Midnight Open Color", group=GRP_SESSIONS)
midnight_label_text = input.string("Midnight", "Midnight Open Label", group=GRP_SESSIONS)

show_830_open    = input.bool(true, "Show 8:30 AM Open (ET)", group=GRP_SESSIONS)
open_830_color   = input.color(color.new(color.fuchsia, 0), "8:30 Open Color", group=GRP_SESSIONS)
open_830_label_text = input.string("8:30", "8:30 Open Label", group=GRP_SESSIONS)

show_session_labels = input.bool(true, "Show Session Text Labels", group=GRP_SESSIONS, tooltip="If off, lines still show but text labels are hidden.")
session_line_width = input.int(1, "Session Line Width", minval=1, maxval=4, group=GRP_SESSIONS)
session_line_style_in = input.string("solid", "Session Line Style", options=["solid","dashed","dotted"], group=GRP_SESSIONS)
session_label_size = input.string(SIZE_SMALL, "Session Label Size", options=[SIZE_TINY, SIZE_SMALL, SIZE_NORMAL, SIZE_LARGE, SIZE_HUGE], group=GRP_SESSIONS)
session_label_pos_in = input.string("Right", "Session Label Position", options=["Above","Below","Left","Right","Center","Inside-Left"], group=GRP_SESSIONS, tooltip="Where each session's text sits relative to the end of its line. 'Inside-Left' pins the RIGHT edge of the text to the end of the line so the text reads BACK into the line and never overflows past the endpoint. 'Center' has NO callout arrow — text sits directly at the anchor (may overflow past line end). Above/Below/Left/Right use a Pine callout label.")
session_label_padding = input.int(0, "Session Label Nudge (signed bars, −500 to +500)", minval=-500, maxval=500, group=GRP_SESSIONS, tooltip="Signed horizontal nudge for the session label. 0 = label sits at the chart's right edge (current bar). NEGATIVE values pull the text BACKWARD (left, into history). POSITIVE values push the text FORWARD (right, into the future / projection area). Range −500 to +500 bars. NOTE: if the slider in Settings still shows 0 as the minimum after updating the script, that's a TradingView input cache — remove the indicator from the chart and re-add it.")
session_taken_label_pad = input.int(6, "Swept-Level Label Left Pad (bars)", minval=0, maxval=100, group=GRP_SESSIONS, tooltip="For NY AM / Asia / London levels that have been swept: how many bars to the LEFT of the takeout point the text sits. The text reads back to the left of the takeout candle so it never overlaps the wicks/candles that swept the level. Increase for more clearance.")
session_taken_center_thresh = input.int(25, "Swept-Level Auto-Center Threshold (bars)", minval=0, maxval=500, group=GRP_SESSIONS, tooltip="If a swept level's line is SHORTER than this many bars (i.e. price took it out soon after it formed, leaving too little room for left-padded text), the text is automatically CENTERED on the line instead. Set to 0 to always left-pad and never auto-center.")

auto_hide_sessions_on_htf = input.bool(true, "Auto-hide Sessions on 15m+", group=GRP_SESSIONS, tooltip="When ON, the Asia / London / NY AM session high & low lines (and their labels) are automatically hidden on charts with a 15-minute or higher timeframe to reduce clutter. Midnight Open, 8:30 Open, Previous Day H/L, and the 1hr/15m swing labels are NOT affected. Turn OFF to always show the sessions regardless of chart timeframe.")
sessions_hidden_by_tf = auto_hide_sessions_on_htf and timeframe.in_seconds() >= 15 * 60

session_line_style = session_line_style_in == "dashed" ? line.style_dashed : session_line_style_in == "dotted" ? line.style_dotted : line.style_solid

// Session Swings — at AM (9:30-12:00 ET) and optional PM (13:30-15:30 ET) opens, snapshot
// the last N swing highs and N swing lows from the 1h and/or 15m timeframes (each
// independently toggleable) and draw each as a horizontal line anchored at its pivot
// bar's time, extending right until session end OR taken out (wick or body close).
// Lines do NOT carry over to the next day.
string GRP_SWINGS         = "Session Swings"
ss_show                   = input.bool(true,  "Show session swings", group=GRP_SWINGS, tooltip="Master toggle. Off = no lines/labels drawn.")
ss_show_h1                = input.bool(true,  "1h source",   inline="src",  group=GRP_SWINGS, tooltip="Detect swings on the 1-hour timeframe.")
ss_show_m15               = input.bool(true,  "15m source",  inline="src",  group=GRP_SWINGS, tooltip="Detect swings on the 15-minute timeframe.")
ss_show_am                = input.bool(true,  "AM session (9:30-12:00 ET)",  group=GRP_SWINGS)
ss_show_pm                = input.bool(false, "PM session (13:30-15:30 ET)", group=GRP_SWINGS)
ss_per_side               = input.int(2, "Swings per side (per TF)", minval=1, maxval=5, group=GRP_SWINGS, tooltip="How many of the most-recent swing highs AND swing lows to snapshot at session open from each enabled source TF. Default 2 → up to 4 lines per TF.")
ss_pivot_len              = input.int(1, "Pivot length", minval=1, maxval=10, group=GRP_SWINGS, tooltip="Bars on each side of the pivot. 1 = middle candle has lower high on both sides for a swing high (ICT/BPI style).")
ss_h1_prefix              = input.string("1hr", "1h label prefix",  inline="pfx", group=GRP_SWINGS)
ss_m15_prefix             = input.string("15m", "15m label prefix", inline="pfx", group=GRP_SWINGS)
ss_line_color             = input.color(color.new(color.white, 0), "Line color", inline="col", group=GRP_SWINGS)
ss_text_color             = input.color(color.new(color.white, 0), "Text color", inline="col", group=GRP_SWINGS)
ss_line_width             = input.int(1, "Line width", minval=1, maxval=4, inline="ln", group=GRP_SWINGS)
ss_line_style_s           = input.string("solid", "Line style", options=["solid","dashed","dotted"], inline="ln", group=GRP_SWINGS)
ss_show_text              = input.bool(true,  "Show labels", group=GRP_SWINGS)
ss_label_size_s           = input.string(SIZE_SMALL, "Label size", options=[SIZE_TINY, SIZE_SMALL, SIZE_NORMAL, SIZE_LARGE, SIZE_HUGE], group=GRP_SWINGS)
ss_text_pos               = input.string("Right", "Label Position", options=["Top","Bottom","Left","Right","Center"], group=GRP_SWINGS, tooltip="Where the label sits relative to the line's right end. Same options as CISD.")
ss_text_pad               = input.int(0, "Label Padding (bars)", minval=-50, maxval=50, group=GRP_SWINGS, tooltip="Extra bars added to the label's x position. Positive pushes right, negative pulls left.")
ss_line_style             = ss_line_style_s == "dashed" ? line.style_dashed : ss_line_style_s == "dotted" ? line.style_dotted : line.style_solid

// Daily & Previous Day Levels
string GRP_DAILY = "Daily Levels"
show_daily_high     = input.bool(true,  "Show Daily High",          inline="dhl",  group=GRP_DAILY)
show_daily_low      = input.bool(true,  "Show Daily Low",           inline="dhl",  group=GRP_DAILY)
daily_high_color    = input.color(color.new(color.red, 0), "Daily High Color", inline="dhlc", group=GRP_DAILY)
daily_low_color     = input.color(color.new(color.red, 0), "Daily Low Color",  inline="dhlc", group=GRP_DAILY)
show_pdh            = input.bool(true,  "Show Previous Day High",   inline="pdhl", group=GRP_DAILY)
show_pdl            = input.bool(true,  "Show Previous Day Low",    inline="pdhl", group=GRP_DAILY)
pdh_color           = input.color(color.new(color.red, 0), "PDH Color", inline="pdhlc", group=GRP_DAILY)
pdl_color           = input.color(color.new(color.red, 0), "PDL Color", inline="pdhlc", group=GRP_DAILY)
show_daily_labels   = input.bool(true, "Show Daily Text Labels", group=GRP_DAILY, tooltip="If off, lines still show but text labels are hidden.")
daily_line_width    = input.int(1, "Daily Line Width", minval=1, maxval=4, group=GRP_DAILY)
daily_line_style_in = input.string("solid", "Daily Line Style", options=["solid","dashed","dotted"], group=GRP_DAILY)
daily_label_size    = input.string(SIZE_SMALL, "Daily Label Size", options=[SIZE_TINY, SIZE_SMALL, SIZE_NORMAL, SIZE_LARGE, SIZE_HUGE], group=GRP_DAILY)
daily_label_pos_in  = input.string("Center", "Daily Label Position", options=["Above","Below","Left","Right","Center"], group=GRP_DAILY, tooltip="Where the Daily High/Low, PDH/PDL text sits relative to the end of the line. 'Center' has NO callout arrow — text sits directly at the anchor. Above/Below/Left/Right use a Pine callout label whose body visibly extends past the anchor.")
daily_label_padding = input.int(0, "Daily Label Padding (bars)", minval=0, maxval=500, group=GRP_DAILY, tooltip="Bars between the label anchor and the end of the line. 0 = text sits exactly at the line end. Increase to push text further from the line end.")
daily_line_style    = daily_line_style_in == "dashed" ? line.style_dashed : daily_line_style_in == "dotted" ? line.style_dotted : line.style_solid

// Map a friendly position string to a Pine label style.
// IMPORTANT: Pine's "callout" styles (label_up/down/left/right) render the text BODY
// visibly offset from the anchor point by a non-trivial chunk of pixels (the arrow +
// body). At low bar widths that visual offset can look like many bars of horizontal
// drift, making labels appear far past the end of their line even when the anchor is
// exactly at bar_index. "Center" (label.style_none) draws just the text with NO arrow
// or background bubble, anchored directly at the bar — use it when you want labels to
// sit right next to the line end with zero callout drift.
// "Above"  → callout label sits above the anchor (arrow points down into the level)
// "Below"  → callout label sits below the anchor (arrow points up into the level)
// "Left"   → callout label sits left of the anchor (arrow points right)
// "Right"  → callout label sits right of the anchor (arrow points left)
// "Center" → no arrow, bare text at the anchor (tightest "next to the line" look)
f_labelStyle(simple string pos) =>
    switch pos
        "Above" => label.style_label_down
        "Below" => label.style_label_up
        "Left"  => label.style_label_right
        "Right" => label.style_label_left
        "Inside-Left" => label.style_label_right   // pointer on RIGHT of text box → text sits to LEFT of anchor (inside the line)
        => label.style_none

// Session & daily label styles (derived from Position dropdowns) + padded x offsets.
// For "Left", padding moves the label to the LEFT of the anchor; otherwise to the RIGHT.
session_label_style    = f_labelStyle(session_label_pos_in)
daily_label_style      = f_labelStyle(daily_label_pos_in)
// For "Left" position mode the padding's sign is flipped (so a positive padding pushes
// further left of the anchor). For Inside-Left and all other modes the user-supplied
// offset is taken as-is: NEGATIVE = backward (left), POSITIVE = forward (right).
session_label_x_offset = session_label_pos_in == "Left" ? -session_label_padding : session_label_padding
daily_label_x_offset   = daily_label_pos_in   == "Left" ? -daily_label_padding   : daily_label_padding

// Resolve the x-anchor + label style for a session H/L label.
//  - Not swept: label at the right edge using the user's Session Label Position.
//  - Swept + enough room on the line: text reads to the LEFT of the takeout point
//    (left-pointing callout), padded by session_taken_label_pad.
//  - Swept + line too short (span < session_taken_center_thresh): text is CENTERED
//    on the line (no callout arrow) so it never overflows past the tiny line.
f_sessionLabelPos(bool taken, int level_bar, int taken_bar) =>
    int   x   = bar_index + session_label_x_offset
    string stl = session_label_style
    if taken
        int span = taken_bar - level_bar
        if session_taken_center_thresh > 0 and span < session_taken_center_thresh
            x   := int(math.round((level_bar + taken_bar) / 2.0))
            stl := label.style_none
        else
            x   := taken_bar - session_taken_label_pad
            stl := label.style_label_right
    [x, stl]

// Std-Dev CISD projections feature removed to keep the script under Pine's
// compile token cap. Will be re-added later as a leaner module.

// +---------------------------------------------------------------+
// | Main Chart Fair Value Gap (LTF, actual bars)                  |
// | Standard 3-candle FVG detected on the chart's own timeframe.  |
// | Fully customizable: fill + border colors, length, CE midline  |
// | style/color/width, background transparency, and realtime cap. |
// | Hidden by default — toggle "Show Fair Value Gaps" to enable.  |
// +---------------------------------------------------------------+
string GRP_FVG = "Main Chart FVG"
show_fvg_main        = input.bool(false, "Show Fair Value Gaps on Main Chart", group=GRP_FVG, inline="fvg_on")
fvg_max_display      = input.int(9, "Max FVGs on Chart", minval=0, maxval=50, group=GRP_FVG, inline="fvg_on", tooltip="0 = hide all. Max 50. Also uncheck 'Show Fair Value Gaps on Main Chart' to disable entirely.")
fvg_bull_color_raw   = input.color(color.white, "Bull FVG Fill (base)", inline="fvgfill", group=GRP_FVG)
fvg_bear_color_raw   = input.color(color.red,   "Bear FVG Fill (base)", inline="fvgfill", group=GRP_FVG)
fvg_bull_border_raw  = input.color(color.white, "Bull Border (base)",   inline="fvgbord", group=GRP_FVG)
fvg_bear_border_raw  = input.color(color.red,   "Bear Border (base)",   inline="fvgbord", group=GRP_FVG)
fvg_bg_transparency  = input.int(90, "Background Transparency (0 solid → 100 invisible)", minval=0, maxval=100, group=GRP_FVG)
fvg_bd_transparency  = input.int(80, "Border Transparency (0 solid → 100 invisible)",     minval=0, maxval=100, group=GRP_FVG)
fvg_length           = input.int(3, "FVG Length (bars to extend right)", minval=1, maxval=500, group=GRP_FVG)
fvg_show_ce          = input.bool(true, "Show CE (Midline)", inline="ce",  group=GRP_FVG)
fvg_ce_color         = input.color(color.white, "CE Color",   inline="ce", group=GRP_FVG)
fvg_ce_style_in      = input.string("dotted", "CE Style", options=["solid","dashed","dotted"], inline="ce2", group=GRP_FVG)
fvg_ce_width         = input.int(1, "CE Width", minval=1, maxval=4, inline="ce2", group=GRP_FVG)
fvg_ce_style = fvg_ce_style_in == "dashed" ? line.style_dashed : fvg_ce_style_in == "dotted" ? line.style_dotted : line.style_solid

// Final colors: apply transparency on top of the user's picked base color.
fvg_bull_color  = color.new(fvg_bull_color_raw,  fvg_bg_transparency)
fvg_bear_color  = color.new(fvg_bear_color_raw,  fvg_bg_transparency)
fvg_bull_border = color.new(fvg_bull_border_raw, fvg_bd_transparency)
fvg_bear_border = color.new(fvg_bear_border_raw, fvg_bd_transparency)

// IFVG (Inverse Fair Value Gap) feature removed.

// +---------------------------------------------------------------+
// | ICT OB & FVG (GK)                                             |
// | Ported from "Simple ICT OB & FVG by Gowtham Kannakaje L".     |
// | Adds mitigation-aware LTF Fair Value Gaps, Naked/Covered      |
