type StdDevData
    array<line>  lines
    array<label> labels

type Candle
    float o
    float c
    float h
    float l
    int   o_idx
    int   c_idx
    int   h_idx
    int   l_idx
    int   o_time
    int   c_time
    box   body
    line  wick_up
    line  wick_down
    label time_label
    label htf_time_lbl
    label htf_rem_lbl
    label htf_int_lbl
    line  swing_high_line
    line  swing_low_line
    line  ce_line
    bool  is_closed

type FVG
